{%- comment -%}
  XPoost collection data (helper, not shown on any page).
  Product popups request it as /collections/<handle>?section_id=xp-collection-data
  (also vendor and type pages: /collections/vendors?q=... , /collections/types?q=...)
  and get a small JSON list of products back. Don't delete it: the product page popups use it.
{%- endcomment -%}
{%- if collection -%}
  <script type="application/json" data-xpc-data>
    {
      "handle": {{ collection.handle | json }},
      "title": {{ collection.title | json }},
      "count": {{ collection.products_count | json }},
      "url": {{ collection.url | json }},
      "img": {% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %},
      "products": [
        {%- for p in collection.products limit: 48 -%}
          {%- liquid
            assign v = p.selected_or_first_available_variant
            assign img2 = p.images[1]
          -%}
          {"id":{{ p.id }},"h":{{ p.handle | json }},"t":{{ p.title | json }},"u":{{ p.url | json }},"a":{{ p.available | json }},"vid":{{ v.id | json }},"vc":{{ p.variants.size }},"varies":{{ p.price_varies | json }},"p":{{ p.price | json }},"cp":{{ p.compare_at_price | default: 0 | json }},"pf":{{ p.price | money | strip_html | json }},"pfc":{{ p.price | money_with_currency | strip_html | json }},"cf":{{ p.compare_at_price | money | strip_html | json }},"cfc":{{ p.compare_at_price | money_with_currency | strip_html | json }},"i":{% if p.featured_image %}{{ p.featured_image | image_url: width: 500 | json }}{% else %}null{% endif %},"i2":{% if img2 %}{{ img2 | image_url: width: 500 | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "XPoost collection data",
  "settings": []
}
{% endschema %}
