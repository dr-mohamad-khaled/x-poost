      '<div class="xpc__foot"><a class="xpc__all" href="' + esc(d.url) + '">' + esc(t.view_all) + ICON.arrow + '</a></div>';
    this.scroll.scrollTop = 0;
    this.hideToast();
    load(this.cfg, srcOf(card)).then(function (data) {
      if (self.card !== card || !self.isOpen) return;
      self.data = data;
      var meta = self.scroll.querySelector('.xpc__meta');
      if (meta && !d.count && data.count != null) meta.innerHTML = '<span class="xpc__pill">' + esc(tpl(t.count, { count: data.count })) + '</span>';
      var hero = self.scroll.querySelector('.xpc__hero');
      var hi = data.img || (data.products && data.products[0] && data.products[0].i);
      if (hero && !d.img && hi) hero.innerHTML = '<img src="' + esc(hi) + '" alt="" decoding="async">';
      self.renderBar();
      self.renderGrid(false);
    }).catch(function () {
      if (self.card !== card) return;
      self.scroll.querySelector('.xpc__grid').outerHTML = '<div class="xpc__msg"><span>' + esc(t.error) + '</span><button type="button" data-x="retry">' + esc(t.retry) + '</button></div>';
    });
  };
  Popup.prototype.list = function () {
    var ps = (this.data.products || []).slice(0, this.cfg.limit || 24);
    if (this.sort === 'low') ps.sort(function (a, b) { return a.p - b.p; });
    else if (this.sort === 'high') ps.sort(function (a, b) { return b.p - a.p; });
    else if (this.sort === 'sale') ps = ps.filter(function (p) { return p.cp > p.p; });
    return ps;
  };
  Popup.prototype.renderBar = function () {
    var t = this.t, wrap = this.scroll.querySelector('.xpc__barwrap');
    if (!wrap) return;
    if (!this.cfg.sort || !this.data.products || this.data.products.length < 3) { wrap.innerHTML = ''; return; }
    var hasSale = this.data.products.some(function (p) { return p.cp > p.p; });
    var opts = [['default', t.sort_default], ['low', t.sort_low], ['high', t.sort_high]];
    if (hasSale) opts.push(['sale', t.sort_sale]);
    var self = this;
    wrap.innerHTML = '<div class="xpc__bar">' + opts.map(function (o) {
      var on = self.sort === o[0];
      return '<button type="button" class="xpc__chip' + (on ? ' is-on' : '') + '" data-x="sort" data-k="' + o[0] + '" aria-pressed="' + on + '">' + esc(o[1]) + '</button>';
    }).join('') + '</div>';
  };
  Popup.prototype.cardHtml = function (p) {
    var c = this.cfg, t = this.t, cur = c.currency === 'with_currency';
    var sale = p.cp > p.p, price = cur ? p.pfc : p.pf, comp = cur ? p.cfc : p.cf;
    var off = sale ? Math.round((1 - p.p / p.cp) * 100) : 0;
    var imgs = p.i ? '<img src="' + esc(p.i) + '" alt="' + esc(p.t) + '" loading="lazy" decoding="async" width="500" height="500">' + (p.i2 ? '<img src="' + esc(p.i2) + '" alt="" loading="lazy" decoding="async" width="500" height="500">' : '') : '';
    var badge = !p.a ? '<span class="xpc-soldout">' + esc(t.sold_out) + '</span>' : (sale && c.badge && off > 0 ? '<span class="xpc-badge">-' + off + '%</span>' : '');
    var qv = c.quickView ? '<button type="button" class="xpc-qv" data-x="qv" data-h="' + esc(p.h) + '" aria-label="' + esc(t.quick_view + ': ' + p.t) + '">' + ICON.eye + '<span>' + esc(t.quick_view) + '</span></button>' : '';
    var btn = '';
    if (c.quickAdd) {
      if (!p.a) btn = '<button type="button" class="xpc-add" disabled>' + esc(t.sold_out) + '</button>';
      else if (p.vc > 1) btn = c.quickView
        ? '<button type="button" class="xpc-add xpc-add--ghost" data-x="qv" data-h="' + esc(p.h) + '">' + esc(t.choose) + '</button>'
        : '<a class="xpc-add xpc-add--ghost" href="' + esc(p.u) + '">' + esc(t.choose) + '</a>';
      else btn = '<button type="button" class="xpc-add" data-x="add" data-id="' + p.vid + '" data-img="' + esc(p.i || '') + '">' + ICON.bag + '<span>' + esc(t.add) + '</span></button>';
    }
    return '<div class="xpc-card"><div class="xpc-card__mwrap"><a class="xpc-card__media" href="' + esc(p.u) + '" tabindex="-1" aria-hidden="true">' + imgs + '</a>' + badge + qv + '</div>' +
      '<div class="xpc-card__info"><a class="xpc-card__title" href="' + esc(p.u) + '">' + esc(p.t) + '</a>' +
      '<div class="xpc-card__price' + (sale ? ' is-sale' : '') + '"><span>' + (p.varies ? esc(t.from) + ' ' : '') + esc(price) + '</span>' + (sale ? '<s>' + esc(comp) + '</s>' : '') + '</div></div>' + btn + '</div>';
  };
  Popup.prototype.renderGrid = function (fromSort) {
    var grid = this.scroll.querySelector('.xpc__grid');
    if (!grid || !this.data) return;
    var ps = this.list(), self = this;
    if (fromSort) this.renderBar();
    grid.removeAttribute('aria-busy');
    grid.classList.toggle('is-static', reduce);
    grid.innerHTML = ps.length ? ps.map(function (p) { return self.cardHtml(p); }).join('') : '<div class="xpc__msg" style="grid-column:1/-1">' + esc(this.t.empty) + '</div>';
  };

  /* Quick add: one request returns the cart drawer HTML too, so the theme drawer is filled without a reload. */
  function themeDrawer() {
    var d = document.querySelector('m-cart-drawer') || document.querySelector('cart-drawer');
    return d && typeof d.getSectionsToRender === 'function' ? d : null;
  }
  function fillDrawer(d, j) {
    var done = false, cache = {};
    d.getSectionsToRender().forEach(function (x) {
      var id = x.section || x.id, html = j.sections && j.sections[id];
      if (!html) return;
      var el = x.selector ? document.querySelector(x.selector) : document.getElementById(x.id);
      if (!el) return;
      var doc = cache[id] || (cache[id] = new DOMParser().parseFromString(html, 'text/html'));
      var src = x.selector ? doc.querySelector(x.selector) : doc.querySelector('.shopify-section');
      if (src) { el.innerHTML = src.innerHTML; done = true; }
    });
    d.classList.remove('m-cart--empty', 'is-empty');
    var items = d.querySelector('m-cart-drawer-items, cart-drawer-items');
    if (items) items.classList.remove('m-cart--empty', 'is-empty');
    return done;
  }
  Popup.prototype.add = function (b) {
    var self = this, c = this.cfg, t = this.t;
    if (b.classList.contains('is-busy') || b.classList.contains('is-done')) return;
    b.classList.add('is-busy');
    b.innerHTML = ICON.spin + '<span>' + esc(t.add) + '</span>';
    var body = { items: [{ id: Number(b.getAttribute('data-id')), quantity: 1 }] };
    var d = themeDrawer();
    if (d) {
      var ids = [];
      try { d.getSectionsToRender().forEach(function (x) { var id = x.section || x.id; if (ids.indexOf(id) < 0) ids.push(id); }); } catch (e) {}
      if (ids.length) { body.sections = ids; body.sections_url = window.location.pathname; }
    }
    fetch(c.addUrl, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify(body) })
      .then(function (r) { return r.json().then(function (j) { if (!r.ok || j.status) throw new Error(j.description || j.message || 'error'); return j; }); })
      .then(function (j) {
        b.classList.remove('is-busy');
        b.classList.add('is-done');
        b.innerHTML = ICON.check + '<span>' + esc(t.added) + '</span>';
        setTimeout(function () { if (b.isConnected) { b.classList.remove('is-done'); b.innerHTML = ICON.bag + '<span>' + esc(t.add) + '</span>'; } }, 2200);
        var sync = function () {
          try {
            if (d && j.sections) fillDrawer(d, j);
            else if (d && typeof d.onCartDrawerUpdate === 'function') d.onCartDrawerUpdate();
            if (window.FoxKitV2 && window.FoxKitV2.Modules && window.FoxKitV2.Modules.InCart) window.FoxKitV2.Modules.InCart.getCart();
            if (window.MinimogEvents && window.MinimogTheme && window.MinimogTheme.pubSubEvents) window.MinimogEvents.emit(window.MinimogTheme.pubSubEvents.cartUpdate, j);
          } catch (e) {}
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
        };
        if (c.after === 'drawer' && d && typeof d.open === 'function') { sync(); self.qvClose(true, true); self.close(); setTimeout(function () { d.open(); }, 50); }
        else {
          if (self.qOpen) setTimeout(function () { self.qvClose(); }, 800);
          self.toast(b.getAttribute('data-img'));
          /* heavy theme work runs after the "added" state has painted, so the click never freezes */
          requestAnimationFrame(function () { setTimeout(sync, 120); });
        }
      })
      .catch(function (e) {
        b.classList.remove('is-busy');
        b.innerHTML = ICON.bag + '<span>' + esc(t.add) + '</span>';
        self.toast(null, e.message);
      });
  };
  Popup.prototype.toast = function (img, err) {
    var self = this, t = this.t, el = this.toastEl, d = themeDrawer();
    el.innerHTML = (img ? '<img src="' + esc(img) + '" alt="">' : '') + '<span>' + esc(err || t.added_msg) + '</span>' +
      (err ? '' : '<a href="' + esc(this.cfg.cartUrl) + '" data-x="cart">' + esc(t.open_cart) + '</a>');
    var a = el.querySelector('[data-x="cart"]');
    if (a && d && typeof d.open === 'function') a.addEventListener('click', function (e) { e.preventDefault(); self.qvClose(true, true); self.close(); setTimeout(function () { d.open(); }, 50); });
    el.classList.add('is-on');
    clearTimeout(this.toastT);
    this.toastT = setTimeout(function () { self.hideToast(); }, 4000);
  };
  Popup.prototype.hideToast = function () { this.toastEl.classList.remove('is-on'); };
  Popup.prototype.close = function (fromPop) {
    var self = this, el = this.el;
    if (!this.isOpen) return;
    this.qvClose(true, true);
    this.isOpen = false;
    el.classList.remove('is-open');
    document.documentElement.classList.remove('xpc-lock');
    setTimeout(function () { if (!self.isOpen) el.hidden = true; }, reduce ? 0 : 380);
    if (this.pushed && !fromPop) { this.pushed = false; try { history.back(); } catch (e) {} }
    this.pushed = false;
    if (this.lastFocus && this.lastFocus.focus && document.contains(this.lastFocus)) this.lastFocus.focus({ preventScroll: true });
  };

  /* ---------- Quick view (built in): images, description, options, add to cart ---------- */
  Popup.prototype.qvProduct = function (h) {
    var ps = (this.data && this.data.products) || [];
    for (var i = 0; i < ps.length; i++) if (ps[i].h === h) return ps[i];
    return null;
  };
  Popup.prototype.qvPrice = function (price, comp) {
    var c = this.cfg, f = c.currency === 'with_currency' ? c.moneyC : c.money, sale = comp > price;
    return { sale: sale, html: '<span>' + esc(money(price, f)) + '</span>' + (sale ? '<s>' + esc(money(comp, f)) + '</s>' : '') };
  };
  Popup.prototype.qvOpen = function (h) {
    var self = this, p = this.qvProduct(h), t = this.t;
    if (!p) return;
    this.qp = p;
    this.qfull = null;
    this.qv = null;
    this.qLast = document.activeElement;
    this.qRender();
    if (!this.qOpen) {
      this.qOpen = true;
      this.qEl.hidden = false;
      void this.qEl.offsetWidth;
      this.qEl.classList.add('is-open');
      try { history.pushState({ xpc: 2 }, ''); this.qPushed = true; } catch (e) { this.qPushed = false; }
    }
    this.qEl.querySelector('.xpq__x').focus({ preventScroll: true });
    loadProduct(this.cfg, h).then(function (j) {
      if (self.qp !== p) return;
      self.qfull = j;
      var vs = j.variants || [];
      self.qv = null;
      for (var i = 0; i < vs.length; i++) if (vs[i].id === p.vid) self.qv = vs[i];
      if (!self.qv || !self.qv.available) for (var k = 0; k < vs.length; k++) if (vs[k].available) { self.qv = vs[k]; break; }
      if (!self.qv) self.qv = vs[0] || null;
      self.qRender();
    }).catch(function () {
      if (self.qp !== p) return;
      var d = self.qBody.querySelector('.xpq__desc');
      if (d) d.innerHTML = '';
    });
  };
  Popup.prototype.qRender = function () {
    var p = this.qp, t = this.t, full = this.qfull, v = this.qv, c = this.cfg;
    var imgs = full && full.images && full.images.length ? full.images.map(function (u) { return sized(u, 900); }) : [p.i2 && false ? p.i2 : p.i].filter(Boolean).map(function (u) { return sized(u, 900); });
    var track = imgs.map(function (u, i) { return '<img src="' + esc(u) + '" alt="' + esc(p.t) + '" ' + (i ? 'loading="lazy" ' : '') + 'decoding="async" width="900" height="900">'; }).join('');
    var thumbs = imgs.length > 1 ? '<div class="xpq__thumbs">' + imgs.map(function (u, i) {
      return '<button type="button" data-x="qthumb" data-i="' + i + '" class="' + (i ? '' : 'is-on') + '" aria-label="' + (i + 1) + '/' + imgs.length + '"><img src="' + esc(sized(u, 160)) + '" alt="" loading="lazy" decoding="async"></button>';
    }).join('') + '</div>' : '';
    var vs = full ? (full.variants || []) : [];
    var sel = '';
    if (vs.length > 1) {
      sel = '<label class="xpq__var"><span>' + esc(t.variant) + '</span><select data-x="qvar">' + vs.map(function (x) {
        return '<option value="' + x.id + '"' + (v && x.id === v.id ? ' selected' : '') + (x.available ? '' : ' disabled') + '>' + esc(x.title + (x.available ? '' : ' (' + t.sold_out + ')')) + '</option>';
      }).join('') + '</select></label>';
    }
    var price = v ? this.qvPrice(v.price, v.compare_at_price || 0) : this.qvPrice(p.p, p.cp);
    var avail = v ? v.available : p.a;
    var vid = v ? v.id : p.vid;
    var btn = '<button type="button" class="xpc-add xpq__add" data-x="add" data-id="' + vid + '" data-img="' + esc(imgs[0] || '') + '"' + (avail && (v || p.vc <= 1) ? '' : ' disabled') + '>' +
      (avail ? ICON.bag + '<span>' + esc(t.add) + '</span>' : esc(t.sold_out)) + '</button>';
    this.qBody.innerHTML = '<div class="xpq__gallery"><div class="xpq__track">' + track + '</div>' + thumbs + '</div>' +
      '<div class="xpq__info"><h2 class="xpq__title" id="xpq-title">' + esc(p.t) + '</h2>' +
      '<p class="xpq__price' + (price.sale ? ' is-sale' : '') + '">' + (p.varies && !v ? esc(t.from) + ' ' : '') + price.html + '</p>' + sel + btn +
      '<a class="xpq__page" href="' + esc(p.u) + '">' + esc(t.view_page) + '</a>' +
      '<div class="xpq__desc">' + (full ? (full.description || '') : '<span class="xpq__skel"></span><span class="xpq__skel"></span><span class="xpq__skel xpq__skel--s"></span>') + '</div></div>';
    var tr = this.qBody.querySelector('.xpq__track');
    if (tr && imgs.length > 1) tr.addEventListener('scroll', function () {
      var i = Math.round(Math.abs(tr.scrollLeft) / tr.clientWidth);
      Array.prototype.forEach.call(tr.parentNode.querySelectorAll('.xpq__thumbs button'), function (b, k) { b.classList.toggle('is-on', k === i); });
    }, { passive: true });
  };
  /* Changing the option only patches price + button, so the gallery and description stay put. */
  Popup.prototype.qvVariant = function (id) {
    var vs = (this.qfull && this.qfull.variants) || [], v = null, t = this.t;
    for (var i = 0; i < vs.length; i++) if (vs[i].id === id) v = vs[i];
    if (!v) return;
    this.qv = v;
    var pr = this.qvPrice(v.price, v.compare_at_price || 0), pe = this.qBody.querySelector('.xpq__price'), b = this.qBody.querySelector('.xpq__add');
    pe.className = 'xpq__price' + (pr.sale ? ' is-sale' : '');
    pe.innerHTML = pr.html;
    b.setAttribute('data-id', v.id);
    b.disabled = !v.available;
    b.classList.remove('is-done', 'is-busy');
    b.innerHTML = v.available ? ICON.bag + '<span>' + esc(t.add) + '</span>' : esc(t.sold_out);
    var fi = v.featured_image && v.featured_image.src;
    if (fi) {
      var base = String(fi).split('?')[0], imgs = this.qBody.querySelectorAll('.xpq__track img');
      for (var k = 0; k < imgs.length; k++) if (imgs[k].src.split('?')[0] === base) { this.qvThumb(k); break; }
    }
  };
  Popup.prototype.qvThumb = function (i) {
    var img = this.qBody.querySelectorAll('.xpq__track img')[i];
    if (img) img.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest', inline: 'start' });
  };
  Popup.prototype.qvClose = function (fromPop, silent) {
    var self = this, el = this.qEl;
    if (!this.qOpen) return;
    this.qOpen = false;
    el.classList.remove('is-open');
    setTimeout(function () { if (!self.qOpen) { el.hidden = true; self.qBody.innerHTML = ''; } }, silent || reduce ? 0 : 320);
    if (this.qPushed && !fromPop) { this.qPushed = false; try { history.back(); } catch (e) {} }
    this.qPushed = false;
    if (!silent && this.qLast && this.qLast.focus && document.contains(this.qLast)) this.qLast.focus({ preventScroll: true });
  };

  function init(sec) {
    if (!sec || sec.__xpc) return;
    try { sec.__xpc = JSON.parse(sec.querySelector('[data-xpc-config]').textContent); } catch (e) { return; }
    var cfg = sec.__xpc;
    // Warm the cache as soon as a shopper shows intent, so the popup opens with products ready.
    var warm = function (e) {
      var card = e.target.closest && e.target.closest('[data-xpc-card]');
      if (card) load(cfg, srcOf(card)).catch(function () {});
    };
    sec.addEventListener('pointerenter', warm, true);
    sec.addEventListener('touchstart', warm, { passive: true, capture: true });
    sec.addEventListener('focusin', warm);
    sec.addEventListener('click', function (e) {
      var trig = e.target.closest('[data-xpc-open]');
      if (!trig || e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
      var card = trig.closest('[data-xpc-card]');
      if (!card) return;
      e.preventDefault();
      if (!P) P = new Popup();
      P.open(card);
    });
  }
  window.XPCollectionPopup = { init: init };
  init(document.getElementById('{{ sid }}'));
})();
</script>
