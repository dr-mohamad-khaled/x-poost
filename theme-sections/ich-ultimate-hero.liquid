{%- comment -%}
  Instachiq Concern Picker
  Tiles for skin and hair concerns. Tapping a tile opens a popup with that collection's products
  (quick view, quick add, sort), instead of leaving the page.
  Products load only when a shopper shows intent (hover / touch / tap), through Shopify's
  Section Rendering API (this same file rendered on the collection URL), so the page stays light.
{%- endcomment -%}
{%- if section.id == 'ich-ultimate-hero' and collection and collection.handle != blank -%}
  {%- comment -%} Data mode: requested as /collections/<handle>?section_id=ich-ultimate-hero {%- endcomment -%}
  <script type="application/json" data-xpc-data>
    {
      "handle": {{ collection.handle | json }},
      "title": {{ collection.title | json }},
      "count": {{ collection.products_count | json }},
      "url": {{ collection.url | json }},
      "products": [
        {%- for p in collection.products limit: 48 -%}
          {%- liquid
            assign v = p.selected_or_first_available_variant
            assign img2 = p.images[1]
          -%}
          {"id":{{ p.id }},"h":{{ p.handle | json }},"t":{{ p.title | json }},"u":{{ p.url | json }},"a":{{ p.available | json }},"vid":{{ v.id | json }},"vc":{{ p.variants.size }},"varies":{{ p.price_varies | json }},"p":{{ p.price | json }},"cp":{{ p.compare_at_price | default: 0 | json }},"pf":{{ p.price | money | strip_html | json }},"pfc":{{ p.price | money_with_currency | strip_html | json }},"cf":{{ p.compare_at_price | money | strip_html | json }},"cfc":{{ p.compare_at_price | money_with_currency | strip_html | json }},"i":{% if p.featured_image %}{{ p.featured_image | image_url: width: 500 | json }}{% else %}null{% endif %},"i2":{% if img2 %}{{ img2 | image_url: width: 500 | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- else -%}

{%- liquid
  assign s = section.settings
  assign sid = 'ich-' | append: section.id
  assign dir = 'ltr'
  if request.locale.iso_code == 'ar'
    assign dir = 'rtl'
  endif
  assign trust_blocks = section.blocks | where: 'type', 'trust'
  assign tile_blocks = section.blocks | where: 'type', 'tile'
  assign htag = s.heading_tag | default: 'h2'
  assign popup_on = false
  if s.click_action == 'popup'
    assign popup_on = true
  endif
-%}

{%- capture ich_badge -%}
  {%- if s.badge != blank -%}<span class="ich-badge ich-a" style="--i:0"><span class="ich-dot-live"></span>{{ s.badge }}</span>{%- endif -%}
{%- endcapture -%}

{%- capture ich_heading -%}
  {%- if s.heading != blank -%}<{{ htag }} class="ich-h ich-a" style="--i:1">{{ s.heading }}</{{ htag }}>{%- endif -%}
{%- endcapture -%}

{%- capture ich_sub -%}
  {%- if s.subheading != blank -%}<p class="ich-sub ich-a" style="--i:2">{{ s.subheading }}</p>{%- endif -%}
{%- endcapture -%}

{%- capture ich_buttons -%}
  {%- if s.btn1_label != blank or s.btn2_label != blank -%}
    <div class="ich-btns ich-a" style="--i:4">
      {%- if s.btn1_label != blank -%}<a class="ich-btn ich-btn--1" href="{{ s.btn1_link | default: routes.all_products_collection_url }}">{{ s.btn1_label }}</a>{%- endif -%}
      {%- if s.btn2_label != blank -%}<a class="ich-btn ich-btn--2" href="{{ s.btn2_link | default: routes.all_products_collection_url }}">{{ s.btn2_label }}</a>{%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture ich_trust -%}
  {%- if trust_blocks.size > 0 -%}
    <ul class="ich-trust ich-a" style="--i:5">
      {%- for b in trust_blocks -%}
        <li {{ b.shopify_attributes }}>{% render 'ich-hero-icon', icon: b.settings.icon %}<span>{{ b.settings.text }}</span></li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
{%- endcapture -%}

<style>
#{{ sid }}{
  --bg:{{ s.c_bg }};--bg2:{{ s.c_bg2 }};--tx:{{ s.c_text }};--mu:{{ s.c_muted }};--ac:{{ s.c_accent }};--on:{{ s.c_on_accent }};
  --cd:{{ s.c_card }};--bd:{{ s.c_border }};
  --r:{{ s.radius }}px;--br:{{ s.btn_radius }}px;--hd:{{ s.h_size }}px;--hm:{{ s.h_size_m }}px;--sd:{{ s.sub_size }}px;
  --spd:{{ s.anim_speed }}ms;--stg:{{ s.anim_stagger }}ms;
  --pt:{{ s.pad_t }}px;--pb:{{ s.pad_b }}px;--ptm:{{ s.pad_t_m }}px;--pbm:{{ s.pad_b_m }}px;
  position:relative;isolation:isolate;overflow:hidden;color:var(--tx);
  background:{% if s.bg_style == 'radial' %}radial-gradient(ellipse 70% 90% at 50% 55%,var(--bg2) 0%,var(--bg) 70%){% elsif s.bg_style == 'linear' %}linear-gradient(180deg,var(--bg) 0%,var(--bg2) 100%){% else %}var(--bg){% endif %};
  padding-block:var(--pt) var(--pb);
  min-height:{{ s.height | replace: 'svh', 'vh' }};min-height:{{ s.height }};
  display:flex;flex-direction:column;justify-content:center;
}
#{{ sid }} *,#{{ sid }} *::before,#{{ sid }} *::after{box-sizing:border-box}
#{{ sid }} .ich-wrap{position:relative;z-index:2;width:100%;max-width:{{ s.max_w }}px;margin-inline:auto;padding-inline:clamp(16px,4vw,64px)}
#{{ sid }} .ich-badge{display:inline-flex;align-items:center;gap:10px;border:1px solid var(--ac);border-radius:999px;padding:6px 16px;font-size:14px;font-weight:700;color:var(--ac);letter-spacing:.2px}
#{{ sid }} .ich-dot-live{position:relative;width:8px;height:8px;border-radius:50%;background:var(--ac)}
#{{ sid }} .ich-h{margin:0;font-size:var(--hd);line-height:1.2;font-weight:{{ s.h_weight }};color:var(--tx);letter-spacing:{% if dir == 'rtl' %}0{% else %}-.02em{% endif %};text-wrap:balance}
#{{ sid }} .ich-h em,#{{ sid }} .ich-h strong{font-style:normal;color:var(--ac)}
#{{ sid }} .ich-sub{margin:0;font-size:var(--sd);line-height:1.8;color:var(--mu);max-width:56ch;text-wrap:pretty}
#{{ sid }} .ich-sub em,#{{ sid }} .ich-sub strong{font-style:normal;color:var(--tx)}
#{{ sid }} .ich-btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:4px}
#{{ sid }} .ich-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 30px;border-radius:var(--br);font-weight:800;font-size:17px;text-decoration:none;transition:transform .2s ease,background-color .2s ease}
#{{ sid }} .ich-btn--1{background:var(--ac);color:var(--on);box-shadow:0 8px 24px -10px var(--ac)}
#{{ sid }} .ich-btn--2{border:1.5px solid var(--ac);color:var(--tx)}
#{{ sid }} .ich-btn:hover{transform:translateY(-2px)}
#{{ sid }} .ich-btn--2:hover{background:color-mix(in srgb,var(--ac) 14%,transparent)}
#{{ sid }} .ich-btn:focus-visible,#{{ sid }} a:focus-visible,#{{ sid }} button:focus-visible{outline:2px solid var(--ac);outline-offset:3px}
#{{ sid }} .ich-trust{list-style:none;margin:10px 0 0;padding:18px 0 0;border-top:1px solid var(--bd);display:flex;flex-wrap:wrap;gap:14px 28px}
#{{ sid }} .ich-trust li{display:flex;align-items:center;gap:9px;font-size:14px;font-weight:500;color:var(--mu)}
#{{ sid }} .ich-trust .ich-ico{color:var(--ac);width:22px;height:22px;flex-shrink:0}
#{{ sid }} .ich-offer{position:absolute;top:0;left:0;right:0;z-index:3;text-align:center;background:var(--ac);color:var(--on);font-weight:800;font-size:14px;padding:9px 16px}
#{{ sid }} .ich-offer a{color:inherit;text-decoration:none}
#{{ sid }} .ich-ph{display:none}
#{{ sid }} picture{display:block}
#{{ sid }} picture img{display:block;width:100%;height:100%;object-fit:cover}
#{{ sid }} .ich-bgmedia{position:absolute;inset:0;z-index:0;opacity:.18}
#{{ sid }} .ich-head{display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px;max-width:760px;margin:0 auto 34px}
#{{ sid }} .ich-tiles{list-style:none;margin:0 auto;padding:0;display:grid;grid-template-columns:repeat({{ s.tile_cols }},minmax(0,1fr));gap:16px;max-width:1080px}
#{{ sid }} .ich-tile{height:100%;display:flex;align-items:center;gap:16px;padding:20px 22px;border-radius:var(--r);border:1px solid var(--bd);background:var(--cd);color:var(--tx);text-decoration:none;cursor:pointer;-webkit-tap-highlight-color:transparent;transition:border-color .2s ease,transform .2s ease,background-color .2s ease}
#{{ sid }} .ich-tile:hover{border-color:var(--ac);transform:translateY(-3px);background:color-mix(in srgb,var(--ac) 8%,var(--cd))}
#{{ sid }} .ich-tile:active{transform:scale(.98)}
#{{ sid }} .ich-tile__ico{width:58px;height:58px;flex-shrink:0;border-radius:calc(var(--r) * .8);background:color-mix(in srgb,var(--ac) 14%,transparent);color:var(--ac);display:flex;align-items:center;justify-content:center;overflow:hidden}
#{{ sid }} .ich-tile__ico .ich-ico{width:30px;height:30px}
#{{ sid }} .ich-tile__ico img{width:100%;height:100%;object-fit:cover}
#{{ sid }} .ich-tile__t{display:block;font-weight:800;font-size:19px;line-height:1.35}
#{{ sid }} .ich-tile__s{display:block;font-size:13px;color:var(--mu);margin-top:2px}
#{{ sid }} .ich-foot{display:flex;flex-direction:column;align-items:center;gap:6px;margin-top:30px}
#{{ sid }} .ich-foot .ich-trust{justify-content:center;border:0;padding-top:6px}
@media (max-width:749px){
  #{{ sid }}{padding-block:var(--ptm) var(--pbm);min-height:{{ s.height_m | replace: 'svh', 'vh' }};min-height:{{ s.height_m }}}
  #{{ sid }} .ich-badge{font-size:12px;padding:3px 12px;gap:7px}
  #{{ sid }} .ich-h{font-size:var(--hm);line-height:1.18}
  #{{ sid }} .ich-sub{font-size:14px;line-height:1.6;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  #{{ sid }} .ich-btns{width:100%;flex-wrap:nowrap;gap:8px;margin-top:2px}
  #{{ sid }} .ich-btn{flex:1 1 0;min-height:44px;padding:0 10px;font-size:15px;text-align:center}
  #{{ sid }} .ich-trust{gap:4px 10px;margin-top:2px;padding-top:8px}
  #{{ sid }} .ich-trust li{font-size:11px;gap:4px}
  #{{ sid }} .ich-trust .ich-ico{width:14px;height:14px}
  #{{ sid }} .ich-offer{font-size:12px;padding:6px 12px}
  #{{ sid }} .ich-head{gap:8px;margin-bottom:14px}
  #{{ sid }} .ich-tiles{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  #{{ sid }} .ich-tile{padding:9px 10px;gap:9px}
  #{{ sid }} .ich-tile__ico{width:34px;height:34px}
  #{{ sid }} .ich-tile__ico .ich-ico{width:20px;height:20px}
  #{{ sid }} .ich-tile__t{font-size:14px;line-height:1.3}
  #{{ sid }} .ich-tile__s{display:none}
  #{{ sid }} .ich-foot{margin-top:14px}
}
{%- unless s.anim == 'none' -%}
@media (prefers-reduced-motion:no-preference){
  #{{ sid }} .ich-a{animation:ich-in-{{ section.id }} var(--spd) cubic-bezier(.2,.7,.2,1) backwards;animation-delay:calc(var(--i,0) * var(--stg))}
  @keyframes ich-in-{{ section.id }}{from{opacity:.01;
    {%- case s.anim -%}
    {%- when 'fade-up' -%}transform:translateY(26px)
    {%- when 'slide' -%}transform:translateX({% if dir == 'rtl' %}40px{% else %}-40px{% endif %})
    {%- when 'zoom' -%}transform:scale(.92)
    {%- else -%}transform:none
    {%- endcase -%}
  }to{opacity:1;transform:none}}
}
{%- endunless -%}
{%- if s.anim_glow -%}
@media (prefers-reduced-motion:no-preference){
  #{{ sid }} .ich-dot-live::after{content:"";position:absolute;inset:0;border-radius:50%;background:var(--ac);animation:ich-pu-{{ section.id }} 2s ease-out infinite}
  @keyframes ich-pu-{{ section.id }}{0%{opacity:.7;transform:scale(1)}100%{opacity:0;transform:scale(3)}}
}
{%- endif -%}
</style>

<section
  id="{{ sid }}"
  class="ich-hero ich-t-concern ich-center"
  dir="{{ dir }}"
  aria-label="{{ s.heading | strip_html | escape | default: shop.name }}"
  {% if popup_on %}data-xpc-section{% endif %}
  style="--xpc-accent:{{ s.c_accent }};--xpc-on-accent:{{ s.c_on_accent }};--xpc-bg:{{ s.c_bg }};--xpc-card:{{ s.c_card }};--xpc-tile:{{ s.popup_tile }};--xpc-text:{{ s.c_text }};--xpc-muted:{{ s.c_muted }};--xpc-border:{{ s.c_border }};--xpc-sale:{{ s.popup_sale }};--xpc-cols-m:{{ s.popup_cols_mobile }};--xpc-cols-d:{{ s.popup_cols_desktop }};"
>
  {%- if s.offer_text != blank -%}
    <div class="ich-offer">{% if s.offer_link != blank %}<a href="{{ s.offer_link }}">{{ s.offer_text }}</a>{% else %}<span>{{ s.offer_text }}</span>{% endif %}</div>
  {%- endif -%}
  {%- if s.image != blank -%}
    <div class="ich-bgmedia">{%- render 'ich-hero-picture', image: s.image, mobile: s.image_m, eager: false -%}</div>
  {%- endif -%}
  <div class="ich-wrap">
    <div class="ich-head">{{ ich_badge }}{{ ich_heading }}{{ ich_sub }}</div>
    {%- if tile_blocks.size > 0 -%}
      <ul class="ich-tiles ich-a" style="--i:3">
        {%- for b in tile_blocks -%}
          {%- liquid
            assign tile_link = b.settings.link
            assign link_handle = ''
            if tile_link contains '/collections/'
              assign link_handle = tile_link | split: '/collections/' | last | split: '?' | first | split: '#' | first | split: '/' | first | url_decode
            endif
            assign col = blank
            if link_handle != blank
              assign col = collections[link_handle]
            endif
            assign use_popup = false
            if popup_on and col != blank
              assign use_popup = true
            endif
            assign pop_img = b.settings.image | default: col.featured_image
          -%}
          <li
            {{ b.shopify_attributes }}
            {% if use_popup %}
              data-xpc-card
              data-handle="{{ col.handle }}"
              data-url="{{ col.url }}"
              data-title="{{ b.settings.title | escape }}"
              data-desc="{{ b.settings.subtitle | escape }}"
              data-count="{{ col.products_count }}"
              {% if pop_img %}data-img="{{ pop_img | image_url: width: 900 }}"{% endif %}
            {% endif %}
          >
            <a class="ich-tile" href="{{ tile_link | default: routes.all_products_collection_url }}"{% if use_popup %} data-xpc-open aria-haspopup="dialog"{% endif %}>
              <span class="ich-tile__ico">
                {%- if b.settings.image != blank -%}
                  {{ b.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', width: 58, height: 58, alt: '' }}
                {%- else -%}
                  {% render 'ich-hero-icon', icon: b.settings.icon %}
                {%- endif -%}
              </span>
              <span><span class="ich-tile__t">{{ b.settings.title }}</span>{%- if b.settings.subtitle != blank -%}<span class="ich-tile__s">{{ b.settings.subtitle }}</span>{%- endif -%}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <div class="ich-foot">{{ ich_buttons }}{{ ich_trust }}</div>
  </div>

  {%- if popup_on -%}
    <script type="application/json" data-xpc-config>
      {
        "sid": {{ sid | json }},
        "file": "ich-ultimate-hero",
        "limit": {{ s.popup_limit | json }},
        "quickAdd": {{ s.popup_quick_add | json }},
        "quickView": {{ s.popup_quick_view | json }},
        "sort": {{ s.popup_sort | json }},
        "badge": {{ s.popup_sale_badge | json }},
        "currency": {{ s.popup_price_format | json }},
        "after": {{ s.popup_after_add | json }},
        "addUrl": {{ routes.cart_add_url | append: '.js' | json }},
        "money": {{ shop.money_format | strip_html | json }},
        "moneyC": {{ shop.money_with_currency_format | strip_html | json }},
        "cartUrl": {{ routes.cart_url | json }},
        "root": {{ routes.root_url | json }},
        "t": {
          "count": {{ s.t_count | json }},
          "add": {{ s.t_add | json }},
          "choose": {{ s.t_choose | json }},
          "added": {{ s.t_added | json }},
          "added_msg": {{ s.t_added_msg | json }},
          "open_cart": {{ s.t_open_cart | json }},
          "sold_out": {{ s.t_sold_out | json }},
          "from": {{ s.t_from | json }},
          "quick_view": {{ s.t_quick_view | json }},
          "view_all": {{ s.t_view_all | json }},
          "close": {{ s.t_close | json }},
          "sort_default": {{ s.t_sort_default | json }},
          "sort_low": {{ s.t_sort_low | json }},
          "sort_high": {{ s.t_sort_high | json }},
          "sort_sale": {{ s.t_sort_sale | json }},
          "empty": {{ s.t_empty | json }},
          "error": {{ s.t_error | json }},
          "retry": {{ s.t_retry | json }},
          "view_page": {{ s.t_view_page | json }},
          "variant": {{ s.t_variant | json }}
        }
      }
    </script>
  {%- endif -%}
</section>

{%- if popup_on -%}
<style>
  /* ---------- Collection popup (shared by every collection-list section on the page) ---------- */
  html.xpc-lock { overflow: hidden; }
  html.xpc-lock .firefly-canvas { display: none !important; }
  html.xpc-lock #MainContent *, html.xpc-lock #MainContent *::before, html.xpc-lock #MainContent *::after { animation-play-state: paused !important; }
  html.xpc-lock .m-modal { z-index: 2147483600 !important; }
  .xpc{position:fixed;inset:0;z-index:2147483000;display:flex;align-items:flex-end;justify-content:center;font-family:inherit;line-height:1.5;color:var(--xpc-text)}
  .xpc[hidden]{display:none}
  .xpc *,.xpc *::before,.xpc *::after{box-sizing:border-box}
  .xpc button{font-family:inherit}
  .xpc img{display:block;max-width:100%}
  .xpc :focus-visible{outline:2px solid var(--xpc-accent);outline-offset:2px}
  .xpc__bg{position:absolute;inset:0;background:rgba(0,0,0,.72);opacity:0;transition:opacity .3s ease}
  .xpc.is-open .xpc__bg{opacity:1}
  .xpc__panel{position:relative;width:100%;max-height:94vh;max-height:94dvh;display:flex;flex-direction:column;background:var(--xpc-bg);border-radius:20px 20px 0 0;overflow:hidden;transform:translateY(100%);will-change:transform;transition:transform .38s cubic-bezier(.2,.8,.2,1),opacity .3s ease}
  .xpc.is-open .xpc__panel{transform:none}
  .xpc__grab{position:absolute;top:8px;left:50%;width:42px;height:4px;margin-left:-21px;border-radius:99px;background:rgba(255,255,255,.35);z-index:4}
  .xpc__scroll{overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;flex:1;min-height:0}
  .xpc__hero{position:relative;height:150px;overflow:hidden;background:var(--xpc-card)}
  .xpc__hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .xpc__hero::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,var(--xpc-bg) 2%,rgba(0,0,0,.25) 60%,rgba(0,0,0,.15))}
  .xpc__head{position:relative;margin-top:-62px;z-index:2;padding:0 16px 10px;display:flex;flex-direction:column;gap:4px}
  .xpc__brand{font-size:12px;font-weight:700;letter-spacing:.06em;color:var(--xpc-accent);text-transform:uppercase}
  .xpc__title{margin:0;font-size:24px;line-height:1.25;font-weight:700;color:var(--xpc-text)}
  .xpc__meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:13px;color:var(--xpc-muted)}
  .xpc__pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:99px;background:var(--xpc-card);border:1px solid var(--xpc-border);color:var(--xpc-text);font-weight:700}
  .xpc__desc{margin:2px 0 0;font-size:14px;color:var(--xpc-muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .xpc__x{position:absolute;top:14px;inset-inline-end:14px;z-index:5;display:inline-flex;align-items:center;gap:6px;min-height:42px;padding:0 14px;border:0;border-radius:99px;background:var(--xpc-accent);color:var(--xpc-on-accent);font-size:14px;font-weight:700;cursor:pointer;box-shadow:0 0 0 3px color-mix(in srgb,var(--xpc-accent) 28%,transparent),0 0 18px color-mix(in srgb,var(--xpc-accent) 65%,transparent)}
  .xpc__x::after{content:"";position:absolute;inset:0;border-radius:inherit;border:2px solid var(--xpc-accent);opacity:0;pointer-events:none;animation:xpcRing 2s ease-out infinite}
  .xpc__x svg{width:16px;height:16px}
  .xpc__bar{position:sticky;top:0;z-index:3;display:flex;gap:8px;overflow-x:auto;padding:10px 16px;background:var(--xpc-bg);border-bottom:1px solid var(--xpc-border);scrollbar-width:none}
  .xpc__bar::-webkit-scrollbar{display:none}
  .xpc__chip{flex:none;min-height:38px;padding:0 14px;border-radius:99px;border:1px solid var(--xpc-border);background:var(--xpc-card);color:var(--xpc-text);font-size:13.5px;font-weight:700;cursor:pointer;white-space:nowrap;transition:background-color .2s ease,color .2s ease,border-color .2s ease}
  .xpc__chip.is-on{background:var(--xpc-accent);border-color:var(--xpc-accent);color:var(--xpc-on-accent)}
  .xpc__grid{display:grid;grid-template-columns:repeat(var(--xpc-cols-m),minmax(0,1fr));gap:10px;padding:14px 12px 4px}
  .xpc-card{position:relative;display:flex;flex-direction:column;background:var(--xpc-card);border-radius:14px;overflow:hidden;border:1px solid var(--xpc-border);content-visibility:auto;contain-intrinsic-size:auto 330px}
  .xpc-card__mwrap{position:relative;overflow:hidden}
  .xpc-card__media{position:relative;display:block;aspect-ratio:1/1;background:var(--xpc-tile);overflow:hidden}
  .xpc-card__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .3s ease}
  .xpc-card__media img + img{opacity:0}
