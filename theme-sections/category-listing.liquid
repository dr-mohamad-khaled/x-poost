  };
  Popup.prototype.show = function (card, retry) {
    var self = this, d = card.dataset, t = this.t;
    var head = (d.img ? '<div class="xpc__hero"><img src="' + esc(d.img) + '" alt="" decoding="async"></div>' : '<div class="xpc__hero"></div>') +
      '<div class="xpc__head">' + (d.brand ? '<span class="xpc__brand">' + esc(d.brand) + '</span>' : '') +
      '<h2 class="xpc__title" id="xpc-title">' + esc(d.title) + '</h2>' +
      '<div class="xpc__meta">' + (d.count ? '<span class="xpc__pill">' + esc(tpl(t.count, { count: d.count })) + '</span>' : '') + '</div>' +
      (d.desc ? '<p class="xpc__desc">' + esc(d.desc) + '</p>' : '') + '</div>';
    var skel = '';
    for (var i = 0; i < 4; i++) skel += '<div class="xpc-skel" aria-hidden="true"><i></i><i></i><i></i></div>';
    this.scroll.innerHTML = head + '<div class="xpc__barwrap"></div><div class="xpc__grid" aria-busy="true">' + skel + '</div>' +
      '<div class="xpc__foot"><a class="xpc__all" href="' + esc(d.url) + '">' + esc(t.view_all) + ICON.arrow + '</a></div>';
    this.scroll.scrollTop = 0;
    this.hideToast();
    load(this.cfg, srcOf(card)).then(function (data) {
      if (self.card !== card || !self.isOpen) return;
      self.data = data;
      var meta = self.scroll.querySelector('.xpc__meta');
      if (meta && !d.count && data.count != null) meta.innerHTML = '<span class="xpc__pill">' + esc(tpl(t.count, { count: data.count })) + '</span>';
      var hero = self.scroll.querySelector('.xpc__hero');
      var hi = data.img || (data.products && data.products[0] && data.products[0].i);
      if (hero && !d.img && hi) hero.innerHTML = '<img src="' + esc(hi) + '" alt="" decoding="async">';
      self.renderBar();
      self.renderGrid(false);
    }).catch(function () {
      if (self.card !== card) return;
      self.scroll.querySelector('.xpc__grid').outerHTML = '<div class="xpc__msg"><span>' + esc(t.error) + '</span><button type="button" data-x="retry">' + esc(t.retry) + '</button></div>';
    });
  };
  Popup.prototype.list = function () {
    var ps = (this.data.products || []).slice(0, this.cfg.limit || 24);
    if (this.sort === 'low') ps.sort(function (a, b) { return a.p - b.p; });
    else if (this.sort === 'high') ps.sort(function (a, b) { return b.p - a.p; });
    else if (this.sort === 'sale') ps = ps.filter(function (p) { return p.cp > p.p; });
    return ps;
  };
  Popup.prototype.renderBar = function () {
    var t = this.t, wrap = this.scroll.querySelector('.xpc__barwrap');
    if (!wrap) return;
    if (!this.cfg.sort || !this.data.products || this.data.products.length < 3) { wrap.innerHTML = ''; return; }
    var hasSale = this.data.products.some(function (p) { return p.cp > p.p; });
    var opts = [['default', t.sort_default], ['low', t.sort_low], ['high', t.sort_high]];
    if (hasSale) opts.push(['sale', t.sort_sale]);
    var self = this;
    wrap.innerHTML = '<div class="xpc__bar">' + opts.map(function (o) {
