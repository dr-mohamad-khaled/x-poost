    return String(fmt || '{' + '{amount}}').replace(/\{\{\s*(\w+)\s*\}\}/, function (m, k) {
      switch (k) {
        case 'amount_no_decimals': return f(0, ',', '.');
        case 'amount_with_comma_separator': return f(2, '.', ',');
        case 'amount_no_decimals_with_comma_separator': return f(0, '.', ',');
        case 'amount_with_apostrophe_separator': return f(2, "'", '.');
        case 'amount_with_space_separator': return f(2, ' ', ',');
        default: return f(2, ',', '.');
      }
    });
  }
  function sized(u, w) {
    if (!u || u.indexOf('data:') === 0) return u;
    return u.replace(/([?&])width=\d+&?/, '$1').replace(/[?&]$/, '') + (u.indexOf('?') > -1 ? '&' : '?') + 'width=' + w;
  }
  /* Full product (all images, description, variants) for the quick view. */
  function loadProduct(cfg, h) {
    if (QCACHE[h]) return QCACHE[h];
    QCACHE[h] = fetch(String(cfg.root || '/').replace(/\/?$/, '/') + 'products/' + encodeURIComponent(h) + '.js', { headers: { Accept: 'application/json' } })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .catch(function (e) { delete QCACHE[h]; throw e; });
    return QCACHE[h];
  }

  /* Fetch a collection's products through this section file rendered on the collection URL. */
  /* A card points at a collection handle, or at any collection-style path (vendor / type pages). */
  function srcOf(card) { return card.dataset.src || ('collections/' + encodeURIComponent(card.dataset.handle)); }
  function load(cfg, path) {
