    }).then(function (html) {
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var node = doc.querySelector('[data-xpc-data]');
      if (!node) throw new Error('no data');
      return JSON.parse(node.textContent);
    }).catch(function (e) { delete CACHE[key]; throw e; });
    return CACHE[key];
  }

  var P = null; // the single popup element, shared by all sections

  function Popup() {
    var el = document.createElement('div');
    el.className = 'xpc';
    el.hidden = true;
    if (document.documentElement.dir) el.setAttribute('dir', document.documentElement.dir);
    el.innerHTML = '<div class="xpc__bg" data-x="close"></div><div class="xpc__panel" role="dialog" aria-modal="true" aria-labelledby="xpc-title"><span class="xpc__grab" aria-hidden="true"></span>' +
      '<button type="button" class="xpc__x" data-x="close"></button><div class="xpc__scroll"></div><div class="xpc__toast" role="status" aria-live="polite"></div></div>' +
      '<div class="xpq" hidden><div class="xpq__bg" data-x="qclose"></div><div class="xpq__panel" role="dialog" aria-modal="true" aria-labelledby="xpq-title"><button type="button" class="xpc__x xpq__x" data-x="qclose"></button><div class="xpq__body"></div></div></div>';
    document.body.appendChild(el);
    this.el = el;
    this.scroll = el.querySelector('.xpc__scroll');
    this.toastEl = el.querySelector('.xpc__toast');
    this.qEl = el.querySelector('.xpq');
    this.qBody = el.querySelector('.xpq__body');
    var self = this;
    el.addEventListener('click', function (e) {
      var b = e.target.closest('[data-x]');
      if (!b) return;
      var a = b.getAttribute('data-x');
      if (a === 'close') self.close();
      else if (a === 'qv') { e.preventDefault(); self.qvOpen(b.getAttribute('data-h')); }
      else if (a === 'qclose') self.qvClose();
      else if (a === 'qthumb') self.qvThumb(Number(b.getAttribute('data-i')));
      else if (a === 'sort') { self.sort = b.getAttribute('data-k'); self.renderGrid(true); }
      else if (a === 'add') { e.preventDefault(); self.add(b); }
      else if (a === 'retry') self.show(self.card, true);
    });
    el.addEventListener('change', function (e) { if (e.target.getAttribute('data-x') === 'qvar') self.qvVariant(Number(e.target.value)); });
    var warmQ = function (e) {
      var b = e.target.closest && e.target.closest('[data-x="qv"]');
      if (b && self.cfg) loadProduct(self.cfg, b.getAttribute('data-h')).catch(function () {});
    };
    el.addEventListener('pointerenter', warmQ, true);
    el.addEventListener('touchstart', warmQ, { passive: true, capture: true });
    el.addEventListener('keydown', function (e) {
