    var startY = null;
    el.querySelector('.xpc__panel').addEventListener('touchstart', function (e) { startY = self.scroll.scrollTop <= 0 ? e.touches[0].clientY : null; }, { passive: true });
    el.querySelector('.xpc__panel').addEventListener('touchend', function (e) { if (startY != null && e.changedTouches[0].clientY - startY > 110) self.close(); startY = null; }, { passive: true });
  }

  Popup.prototype.open = function (card) {
    var self = this, el = this.el, sec = card.closest('[data-xpc-section]');
    this.card = card;
    this.cfg = sec.__xpc;
    this.t = this.cfg.t;
    this.sort = 'default';
    this.data = null;
    el.setAttribute('style', sec.getAttribute('style') || '');
    el.querySelector('.xpc__x').innerHTML = ICON.x + '<span>' + esc(this.t.close) + '</span>';
    this.qEl.querySelector('.xpq__x').innerHTML = ICON.x + '<span>' + esc(this.t.close) + '</span>';
    this.qvClose(true, true);
    this.lastFocus = document.activeElement;
    this.show(card, false);
    if (!this.isOpen) {
      this.isOpen = true;
      el.hidden = false;
      void el.offsetWidth;
