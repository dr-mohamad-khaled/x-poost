{% comment %}
  Category Listing Section with Icons
  Grid layout with customizable styling
{% endcomment %}

{%- comment -%}
  Tapping a category that links to a collection (or vendor / type page) opens a popup with its
  products (quick view, quick add, sort) instead of leaving the page. Products are fetched only when
  the shopper shows intent, through sections/xp-collection-data.liquid. Ctrl/Cmd-click opens the page.
{%- endcomment -%}
{% assign section_id = section.id | replace: '_', '' | downcase %}
{%- liquid
  assign s = section.settings
  assign sid = 'catlist-' | append: section_id
  assign popup_on = false
  if s.click_action == 'popup'
    assign popup_on = true
  endif
-%}

{% style %}
  .category-listing-{{ section_id }} {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    {% if section.settings.background_type == 'gradient' %}
      background: linear-gradient({{ section.settings.gradient_angle }}deg, {{ section.settings.gradient_start }} 0%, {{ section.settings.gradient_end }} 100%);
    {% else %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    padding: {{ section.settings.section_padding_top }}px 20px {{ section.settings.section_padding_bottom }}px;
    overflow: hidden;
  }

  .category-listing__container-{{ section_id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .category-listing__title-{{ section_id }} {
    text-align: {{ section.settings.title_alignment }};
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size }}px;
    font-weight: 700;
    margin: 0 0 {{ section.settings.title_spacing }}px;
  }

  .category-listing__grid-{{ section_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ section.settings.item_spacing }}px;
    justify-content: {{ section.settings.alignment }};
  }

  .category-listing__item-{{ section_id }} {
    flex: 0 0 calc((100% - ({{ section.settings.items_per_row | minus: 1 }} * {{ section.settings.item_spacing }}px)) / {{ section.settings.items_per_row }});
    min-width: {{ section.settings.item_min_width }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .category-listing__item-{{ section_id }}:hover {
    transform: translateY(-5px);
  }

  .category-listing__icon-wrapper-{{ section_id }} {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    background-color: {{ section.settings.icon_background }};
    border-radius: {{ section.settings.icon_border_radius }}px;
    padding: {{ section.settings.icon_padding }}px;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .category-listing__item-{{ section_id }}:hover .category-listing__icon-wrapper-{{ section_id }} {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    transform: scale(1.05);
  }

  .category-listing__icon-{{ section_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .category-listing__icon-{{ section_id }} svg {
    width: 100%;
    height: 100%;
  }

  .category-listing__text-{{ section_id }} {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size }}px;
    font-weight: {{ section.settings.text_weight }};
    line-height: 1.4;
    word-break: break-word;
  }

  @media screen and (max-width: 768px) {
    .category-listing-{{ section_id }} {
      padding: {{ section.settings.section_padding_top | times: 0.7 }}px 15px {{ section.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .category-listing__title-{{ section_id }} {
      font-size: {{ section.settings.title_size | times: 0.8 }}px;
      margin-bottom: {{ section.settings.title_spacing | times: 0.8 }}px;
    }

    .category-listing__grid-{{ section_id }} {
      gap: {{ section.settings.mobile_spacing }}px;
      justify-content: {{ section.settings.mobile_alignment }};
    }

    .category-listing__item-{{ section_id }} {
      flex: 0 0 calc((100% - ({{ section.settings.mobile_columns | minus: 1 }} * {{ section.settings.mobile_spacing }}px)) / {{ section.settings.mobile_columns }});
      min-width: 70px;
    }

    .category-listing__icon-wrapper-{{ section_id }} {
      width: {{ section.settings.icon_size | times: 0.85 }}px;
      height: {{ section.settings.icon_size | times: 0.85 }}px;
      margin-bottom: 8px;
    }

    .category-listing__text-{{ section_id }} {
      font-size: {{ section.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div
  class="category-listing-{{ section_id }}"
  id="{{ sid }}"
  {{ section.shopify_attributes }}
  {% if popup_on %}data-xpc-section{% endif %}
  style="--xpc-accent:{{ s.popup_accent }};--xpc-on-accent:{{ s.popup_on_accent }};--xpc-bg:{{ s.popup_bg }};--xpc-card:{{ s.popup_card }};--xpc-tile:{{ s.popup_tile }};--xpc-text:{{ s.popup_text }};--xpc-muted:{{ s.popup_muted }};--xpc-border:{{ s.popup_border }};--xpc-sale:{{ s.popup_sale }};--xpc-cols-m:{{ s.popup_cols_mobile }};--xpc-cols-d:{{ s.popup_cols_desktop }};"
>
  <div class="category-listing__container-{{ section_id }}">
    {% if section.settings.title != blank %}
      <h2 class="category-listing__title-{{ section_id }}">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="category-listing__grid-{{ section_id }}">
      {% for block in section.blocks %}
        {%- liquid
          assign link = block.settings.link
          assign pop = false
          assign pop_src = ''
          assign col = blank
          if popup_on and link contains '/collections/'
            assign pop = true
            assign pop_path = link | split: '/collections/' | last | split: '#' | first
            assign pop_src = 'collections/' | append: pop_path
            assign col_handle = pop_path | split: '?' | first | split: '/' | first | url_decode
            assign col = collections[col_handle]
          endif
        -%}
        {% if link != blank %}
          <a
            href="{{ link }}"
            class="category-listing__item-{{ section_id }}"
            {{ block.shopify_attributes }}
            {% if pop %}
              data-xpc-card
              data-xpc-open
              aria-haspopup="dialog"
              data-src="{{ pop_src | escape }}"
              data-url="{{ link }}"
              data-title="{{ block.settings.category_name | default: col.title | escape }}"
              {% if col != blank and col.products_count %}data-count="{{ col.products_count }}"{% endif %}
              {% if col != blank and col.featured_image %}data-img="{{ col.featured_image | image_url: width: 900 }}"{% endif %}
            {% endif %}
          >
        {% else %}
          <div class="category-listing__item-{{ section_id }}" {{ block.shopify_attributes }}>
        {% endif %}
          
          <div class="category-listing__icon-wrapper-{{ section_id }}">
            {% if block.settings.icon_type == 'svg' and block.settings.svg_code != blank %}
              <div class="category-listing__icon-{{ section_id }}" style="color: {{ block.settings.svg_color }}; fill: {{ block.settings.svg_color }};">
                {{ block.settings.svg_code }}
              </div>
            {% elsif block.settings.icon_image != blank %}
              <img 
                src="{{ block.settings.icon_image | image_url: width: 200 }}" 
                alt="{{ block.settings.category_name | escape }}"
                class="category-listing__icon-{{ section_id }}"
                loading="lazy"
                width="{{ section.settings.icon_size }}"
                height="{{ section.settings.icon_size }}"
              >
            {% else %}
              <div class="category-listing__icon-{{ section_id }}" style="color: {{ block.settings.svg_color }}; fill: {{ block.settings.svg_color }};">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z"/>
                </svg>
              </div>
            {% endif %}
          </div>

          {% if block.settings.category_name != blank %}
            <span class="category-listing__text-{{ section_id }}">{{ block.settings.category_name }}</span>
          {% endif %}

        {% if block.settings.link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {%- if popup_on -%}
    <script type="application/json" data-xpc-config>
      {
        "sid": {{ sid | json }},
        "file": "xp-collection-data",
        "limit": {{ s.popup_limit | json }},
        "quickAdd": {{ s.popup_quick_add | json }},
        "quickView": {{ s.popup_quick_view | json }},
        "sort": {{ s.popup_sort | json }},
        "badge": {{ s.popup_sale_badge | json }},
        "currency": {{ s.popup_price_format | json }},
        "after": {{ s.popup_after_add | json }},
        "addUrl": {{ routes.cart_add_url | append: '.js' | json }},
        "money": {{ shop.money_format | strip_html | json }},
        "moneyC": {{ shop.money_with_currency_format | strip_html | json }},
        "cartUrl": {{ routes.cart_url | json }},
        "root": {{ routes.root_url | json }},
        "t": {
          "count": {{ s.t_count | json }},
          "add": {{ s.t_add | json }},
          "choose": {{ s.t_choose | json }},
          "added": {{ s.t_added | json }},
          "added_msg": {{ s.t_added_msg | json }},
          "open_cart": {{ s.t_open_cart | json }},
          "sold_out": {{ s.t_sold_out | json }},
          "from": {{ s.t_from | json }},
          "quick_view": {{ s.t_quick_view | json }},
          "view_all": {{ s.t_view_all | json }},
          "close": {{ s.t_close | json }},
          "sort_default": {{ s.t_sort_default | json }},
          "sort_low": {{ s.t_sort_low | json }},
          "sort_high": {{ s.t_sort_high | json }},
          "sort_sale": {{ s.t_sort_sale | json }},
          "empty": {{ s.t_empty | json }},
          "error": {{ s.t_error | json }},
          "retry": {{ s.t_retry | json }},
          "view_page": {{ s.t_view_page | json }},
          "variant": {{ s.t_variant | json }}
        }
      }
    </script>
  {%- endif -%}
</div>

{%- if popup_on -%}
<style>
  /* ---------- Collection popup (shared by every collection-list section on the page) ---------- */
  html.xpc-lock { overflow: hidden; }
  html.xpc-lock .firefly-canvas { display: none !important; }
  html.xpc-lock #MainContent *, html.xpc-lock #MainContent *::before, html.xpc-lock #MainContent *::after { animation-play-state: paused !important; }
  html.xpc-lock .m-modal { z-index: 2147483600 !important; }
  .xpc{position:fixed;inset:0;z-index:2147483000;display:flex;align-items:flex-end;justify-content:center;font-family:inherit;line-height:1.5;color:var(--xpc-text)}
  .xpc[hidden]{display:none}
  .xpc *,.xpc *::before,.xpc *::after{box-sizing:border-box}
  .xpc button{font-family:inherit}
  .xpc img{display:block;max-width:100%}
  .xpc :focus-visible{outline:2px solid var(--xpc-accent);outline-offset:2px}
  .xpc__bg{position:absolute;inset:0;background:rgba(0,0,0,.72);opacity:0;transition:opacity .3s ease}
  .xpc.is-open .xpc__bg{opacity:1}
  .xpc__panel{position:relative;width:100%;max-height:94vh;max-height:94dvh;display:flex;flex-direction:column;background:var(--xpc-bg);border-radius:20px 20px 0 0;overflow:hidden;transform:translateY(100%);will-change:transform;transition:transform .38s cubic-bezier(.2,.8,.2,1),opacity .3s ease}
  .xpc.is-open .xpc__panel{transform:none}
  .xpc__grab{position:absolute;top:8px;left:50%;width:42px;height:4px;margin-left:-21px;border-radius:99px;background:rgba(255,255,255,.35);z-index:4}
  .xpc__scroll{overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;flex:1;min-height:0}
  .xpc__hero{position:relative;height:150px;overflow:hidden;background:var(--xpc-card)}
  .xpc__hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .xpc__hero::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,var(--xpc-bg) 2%,rgba(0,0,0,.25) 60%,rgba(0,0,0,.15))}
  .xpc__head{position:relative;margin-top:-62px;z-index:2;padding:0 16px 10px;display:flex;flex-direction:column;gap:4px}
  .xpc__brand{font-size:12px;font-weight:700;letter-spacing:.06em;color:var(--xpc-accent);text-transform:uppercase}
  .xpc__title{margin:0;font-size:24px;line-height:1.25;font-weight:700;color:var(--xpc-text)}
  .xpc__meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:13px;color:var(--xpc-muted)}
  .xpc__pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:99px;background:var(--xpc-card);border:1px solid var(--xpc-border);color:var(--xpc-text);font-weight:700}
  .xpc__desc{margin:2px 0 0;font-size:14px;color:var(--xpc-muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .xpc__x{position:absolute;top:14px;inset-inline-end:14px;z-index:5;display:inline-flex;align-items:center;gap:6px;min-height:42px;padding:0 14px;border:0;border-radius:99px;background:var(--xpc-accent);color:var(--xpc-on-accent);font-size:14px;font-weight:700;cursor:pointer;box-shadow:0 0 0 3px color-mix(in srgb,var(--xpc-accent) 28%,transparent),0 0 18px color-mix(in srgb,var(--xpc-accent) 65%,transparent)}
  .xpc__x::after{content:"";position:absolute;inset:0;border-radius:inherit;border:2px solid var(--xpc-accent);opacity:0;pointer-events:none;animation:xpcRing 2s ease-out infinite}
  .xpc__x svg{width:16px;height:16px}
  .xpc__bar{position:sticky;top:0;z-index:3;display:flex;gap:8px;overflow-x:auto;padding:10px 16px;background:var(--xpc-bg);border-bottom:1px solid var(--xpc-border);scrollbar-width:none}
  .xpc__bar::-webkit-scrollbar{display:none}
  .xpc__chip{flex:none;min-height:38px;padding:0 14px;border-radius:99px;border:1px solid var(--xpc-border);background:var(--xpc-card);color:var(--xpc-text);font-size:13.5px;font-weight:700;cursor:pointer;white-space:nowrap;transition:background-color .2s ease,color .2s ease,border-color .2s ease}
  .xpc__chip.is-on{background:var(--xpc-accent);border-color:var(--xpc-accent);color:var(--xpc-on-accent)}
  .xpc__grid{display:grid;grid-template-columns:repeat(var(--xpc-cols-m),minmax(0,1fr));gap:10px;padding:14px 12px 4px}
  .xpc-card{position:relative;display:flex;flex-direction:column;background:var(--xpc-card);border-radius:14px;overflow:hidden;border:1px solid var(--xpc-border);content-visibility:auto;contain-intrinsic-size:auto 330px}
  .xpc-card__mwrap{position:relative;overflow:hidden}
  .xpc-card__media{position:relative;display:block;aspect-ratio:1/1;background:var(--xpc-tile);overflow:hidden}
  .xpc-card__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .3s ease}
  .xpc-card__media img + img{opacity:0}
  .xpc-badge{position:absolute;top:8px;inset-inline-start:8px;z-index:2;background:var(--xpc-sale);color:#fff;font-size:12px;font-weight:700;padding:3px 8px;border-radius:6px}
  .xpc-soldout{position:absolute;top:8px;inset-inline-start:8px;z-index:2;background:#121111;color:#fff;font-size:12px;font-weight:700;padding:3px 8px;border-radius:6px}
  .xpc-qv{position:absolute;bottom:8px;inset-inline-end:8px;z-index:2;width:38px;height:38px;padding:0;border-radius:99px;border:1px solid color-mix(in srgb,#fff 35%,var(--xpc-accent));background:linear-gradient(135deg,var(--xpc-accent),color-mix(in srgb,var(--xpc-accent) 62%,#000));color:var(--xpc-on-accent);display:flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;font-size:13px;font-weight:700;box-shadow:0 2px 8px rgba(0,0,0,.5)}
  .xpc-qv svg{width:17px;height:17px;flex:none}
  .xpc-qv span{display:none}
  .xpc-qv.m-spinner-loading{pointer-events:none}
  .xpc-qv.m-spinner-loading svg{animation:xpcSpin .8s linear infinite;will-change:transform}
  .xpc-card__info{display:flex;flex-direction:column;gap:4px;padding:10px 10px 0;flex:1}
  .xpc-card__title{font-size:13.5px;font-weight:700;line-height:1.4;color:var(--xpc-text);text-decoration:none;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .xpc-card__price{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 8px;font-size:14px;font-weight:700;unicode-bidi:plaintext}
  .xpc-card__price.is-sale > span:first-child{color:var(--xpc-sale)}
  .xpc-card__price s{color:var(--xpc-muted);font-size:12px;font-weight:500}
  .xpc-add{position:relative;margin:10px;min-height:42px;border:0;border-radius:8px;background:var(--xpc-accent);color:var(--xpc-on-accent);font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;overflow:hidden;transition:background-color .2s ease,transform .15s ease}
  .xpc-add--ghost{background:transparent;color:var(--xpc-text);border:1px solid var(--xpc-border)}
  .xpc-add[disabled]{background:var(--xpc-border);color:var(--xpc-text);cursor:not-allowed}
  .xpc-add:not([disabled]):active,.xpc__chip:active{transform:scale(.96)}
  .xpc-qv:active{opacity:.85}
  .xpc-add svg{width:16px;height:16px;flex:none}
  .xpc-add.is-busy svg{animation:xpcSpin .8s linear infinite;will-change:transform}
  .xpc-add.is-done{background:#2f7d4f;color:#fff}
  .xpc-add.is-done svg{animation:xpcPop .45s cubic-bezier(.3,1.5,.5,1) both}
  .xpc__foot{padding:8px 12px calc(16px + env(safe-area-inset-bottom))}
  .xpc__all{display:flex;align-items:center;justify-content:center;gap:8px;min-height:50px;border-radius:10px;border:1px solid var(--xpc-accent);color:var(--xpc-accent);font-weight:700;text-decoration:none;font-size:15px}
  .xpc__all svg{width:16px;height:16px}
  html:not([dir=rtl]) .xpc__all svg{transform:scaleX(-1)}
  .xpc__msg{padding:30px 16px;text-align:center;color:var(--xpc-muted);display:flex;flex-direction:column;align-items:center;gap:12px}
  .xpc__msg button{min-height:44px;padding:0 20px;border-radius:8px;border:1px solid var(--xpc-accent);background:transparent;color:var(--xpc-accent);font-weight:700;cursor:pointer}
  .xpc-skel{background:var(--xpc-card);border-radius:14px;overflow:hidden;border:1px solid var(--xpc-border)}
  .xpc-skel i{display:block;position:relative;overflow:hidden;background:color-mix(in srgb,var(--xpc-text) 7%,var(--xpc-card))}
  .xpc-skel i:first-child{aspect-ratio:1/1}
  .xpc-skel i:nth-child(2){height:12px;margin:12px 10px 6px;border-radius:6px}
  .xpc-skel i:nth-child(3){height:12px;width:55%;margin:0 10px 12px;border-radius:6px}
  .xpc-skel i::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--xpc-text) 9%,transparent),transparent);transform:translateX(-100%);animation:xpcShimmer 1.2s ease-in-out infinite}
  .xpc__toast{position:absolute;left:12px;right:12px;bottom:calc(14px + env(safe-area-inset-bottom));z-index:6;display:flex;align-items:center;gap:10px;padding:10px 10px 10px 14px;padding-inline:14px 10px;border-radius:12px;background:#1d1c1b;border:1px solid var(--xpc-accent);box-shadow:0 10px 30px rgba(0,0,0,.5);transform:translateY(140%);opacity:0;transition:transform .35s cubic-bezier(.2,.8,.2,1),opacity .25s ease;pointer-events:none}
  .xpc__toast.is-on{transform:none;opacity:1;pointer-events:auto}
  .xpc__toast img{width:42px;height:42px;border-radius:8px;object-fit:cover;background:var(--xpc-tile);flex:none}
  .xpc__toast span{flex:1;font-size:14px;font-weight:700;color:var(--xpc-text)}
  .xpc__toast a{flex:none;min-height:40px;display:inline-flex;align-items:center;padding:0 14px;border-radius:8px;background:var(--xpc-accent);color:var(--xpc-on-accent);font-weight:700;font-size:13.5px;text-decoration:none}
  .xpc.is-open .xpc-card:nth-child(-n+8),.xpc.is-open .xpc-skel{animation:xpcRise .4s cubic-bezier(.2,.8,.2,1) backwards}
  .xpc-card:nth-child(2),.xpc-skel:nth-child(2){animation-delay:.04s}
  .xpc-card:nth-child(3),.xpc-skel:nth-child(3){animation-delay:.08s}
  .xpc-card:nth-child(4),.xpc-skel:nth-child(4){animation-delay:.12s}
  .xpc-card:nth-child(5){animation-delay:.16s}
  .xpc-card:nth-child(6){animation-delay:.2s}
  .xpc-card:nth-child(7){animation-delay:.24s}
  .xpc-card:nth-child(8){animation-delay:.28s}
  .xpc__grid.is-static .xpc-card{animation:none}
  @keyframes xpcRise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
  @keyframes xpcPop{0%{transform:scale(.3)}60%{transform:scale(1.2)}100%{transform:scale(1)}}
  @keyframes xpcShimmer{to{transform:translateX(100%)}}
  @keyframes xpcRing{0%{opacity:.8;transform:scale(1)}100%{opacity:0;transform:scale(1.35,1.7)}}
  @media (hover:hover){
        .xpc-card:hover .xpc-card__media img + img{opacity:1}
    .xpc-card__title:hover{text-decoration:underline;text-underline-offset:3px}
  }
  @media (min-width:750px){
    .xpc{align-items:center;padding:24px}
    .xpc__panel{width:min(1100px,100%);max-height:90vh;border-radius:20px;opacity:0;transform:translateY(24px) scale(.98)}
    .xpc.is-open .xpc__panel{opacity:1;transform:none}
    .xpc__grab{display:none}
    .xpc__hero{height:190px}
    .xpc__head{padding:0 24px 12px;margin-top:-72px}
    .xpc__title{font-size:30px}
    .xpc__bar{padding:12px 24px}
    .xpc__grid{grid-template-columns:repeat(var(--xpc-cols-d),minmax(0,1fr));gap:16px;padding:18px 24px 6px}
    .xpc__foot{padding:10px 24px 22px;display:flex;justify-content:center}
    .xpc__all{min-width:340px}
    .xpc__toast{left:auto;right:24px;width:380px;bottom:24px}
    .xpc-qv{inset-inline:0;bottom:0;width:auto;height:40px;border-radius:0;border:0;transform:translateY(100%);opacity:0;transition:transform .3s cubic-bezier(.2,.8,.2,1),opacity .3s ease}
    .xpc-card:hover .xpc-qv,.xpc-qv:focus-visible{transform:none;opacity:1}
    .xpc-qv span{display:inline}
  }
  /* ---------- Quick view (built in) ---------- */
  .xpq{position:absolute;inset:0;z-index:20;display:flex;align-items:flex-end;justify-content:center}
  .xpq[hidden]{display:none}
  .xpq__bg{position:absolute;inset:0;background:rgba(0,0,0,.72);opacity:0;transition:opacity .25s ease}
  .xpq.is-open .xpq__bg{opacity:1}
  .xpq__panel{position:relative;width:100%;height:88vh;height:88dvh;display:flex;flex-direction:column;background:var(--xpc-bg);border-radius:20px 20px 0 0;overflow:hidden;transform:translateY(100%);will-change:transform;transition:transform .32s cubic-bezier(.2,.8,.2,1)}
  .xpq.is-open .xpq__panel{transform:none}
  .xpq__x{top:12px}
  .xpq__body{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
  .xpq__gallery{background:var(--xpc-tile)}
  .xpq__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain}
  .xpq__track::-webkit-scrollbar,.xpq__thumbs::-webkit-scrollbar{display:none}
  .xpq__track img{flex:0 0 100%;width:100%;height:auto;aspect-ratio:1/1;object-fit:contain;scroll-snap-align:start;background:var(--xpc-tile)}
  .xpq__thumbs{display:flex;gap:6px;padding:8px;overflow-x:auto;background:var(--xpc-bg);scrollbar-width:none}
  .xpq__thumbs button{flex:none;width:52px;height:52px;padding:0;border:1px solid var(--xpc-border);border-radius:8px;overflow:hidden;background:var(--xpc-tile);cursor:pointer}
  .xpq__thumbs button.is-on{border-color:var(--xpc-accent)}
  .xpq__thumbs img{width:100%;height:100%;object-fit:cover}
  .xpq__info{padding:16px 16px calc(20px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:12px}
  .xpq__title{margin:0;font-size:20px;font-weight:700;line-height:1.35;color:var(--xpc-text)}
  .xpq__price{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 10px;margin:0;font-size:20px;font-weight:700;color:var(--xpc-accent);unicode-bidi:plaintext}
  .xpq__price s{color:var(--xpc-muted);font-size:14px;font-weight:500}
  .xpq__price.is-sale > span:first-child{color:var(--xpc-sale)}
  .xpq__var{display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--xpc-muted)}
  .xpq__var select{width:100%;min-height:46px;padding:0 12px;border-radius:8px;border:1px solid var(--xpc-border);background:var(--xpc-card);color:var(--xpc-text);font-size:15px;font-family:inherit}
  .xpq .xpc-add{margin:0;min-height:50px;font-size:16px}
  .xpq__page{display:flex;align-items:center;justify-content:center;min-height:46px;border-radius:8px;border:1px solid var(--xpc-accent);color:var(--xpc-accent);font-weight:700;text-decoration:none;font-size:14.5px}
  .xpq__desc{font-size:14px;line-height:1.7;color:var(--xpc-text);border-top:1px solid var(--xpc-border);padding-top:12px;overflow-wrap:anywhere}
  .xpq__desc img{max-width:100%;height:auto}
  .xpq__desc a{color:var(--xpc-accent)}
  .xpq__skel{display:block;height:12px;border-radius:6px;background:var(--xpc-card);margin:8px 0}
  .xpq__skel--s{width:60%}
  .xpc.is-open .xpq__skel{animation:xpcBlink .9s ease-in-out infinite alternate}
  @keyframes xpcBlink{from{opacity:.4}to{opacity:1}}
  @media (min-width:750px){
    .xpq{align-items:center;padding:24px}
    .xpq__panel{width:min(920px,100%);height:min(88vh,680px);border-radius:20px;opacity:0;transform:translateY(20px) scale(.98);transition:transform .3s cubic-bezier(.2,.8,.2,1),opacity .25s ease}
    .xpq.is-open .xpq__panel{opacity:1;transform:none}
    .xpq__body{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);align-items:start}
    .xpq__gallery{position:sticky;top:0}
    .xpq__info{padding-top:72px}
  }
  @media (prefers-reduced-motion:reduce){
    .xpc *,.xpc *::before,.xpc *::after{animation:none !important;transition:none !important}
  }
</style>

<script>
(function () {
