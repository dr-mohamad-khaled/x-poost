{%- comment -%}
  Instachiq Ultimate Hero
  7 templates: spotlight, fullbleed, concern, editorial, slideshow, compare, video
  Zero external dependencies. CSS is scoped and only the chosen template's CSS is printed.
  JavaScript (under 1.5 KB) is printed only for the slideshow, compare and video templates.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign tpl = s.template
  assign sid = 'ich-' | append: section.id
  assign dir = 'ltr'
  if request.locale.iso_code == 'ar'
    assign dir = 'rtl'
  endif
  assign eager = s.is_first
  if section.index and section.index > 2
    assign eager = false
  endif
  assign trust_blocks = section.blocks | where: 'type', 'trust'
  assign tile_blocks = section.blocks | where: 'type', 'tile'
  assign brand_blocks = section.blocks | where: 'type', 'brand'
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign p = s.product
  assign htag = s.heading_tag | default: 'h2'
-%}

{%- capture ich_badge -%}
  {%- if s.badge != blank -%}<span class="ich-badge ich-a" style="--i:0"><span class="ich-dot-live"></span>{{ s.badge }}</span>{%- endif -%}
{%- endcapture -%}

{%- capture ich_heading -%}
  {%- if s.heading != blank -%}<{{ htag }} class="ich-h ich-a" style="--i:1">{{ s.heading }}</{{ htag }}>{%- endif -%}
{%- endcapture -%}

{%- capture ich_sub -%}
  {%- if s.subheading != blank -%}<p class="ich-sub ich-a" style="--i:2">{{ s.subheading }}</p>{%- endif -%}
{%- endcapture -%}

{%- capture ich_buttons -%}
  {%- if s.btn1_label != blank or s.btn2_label != blank -%}
    <div class="ich-btns ich-a" style="--i:3">
      {%- if s.btn1_label != blank -%}<a class="ich-btn ich-btn--1" href="{{ s.btn1_link | default: routes.all_products_collection_url }}">{{ s.btn1_label }}</a>{%- endif -%}
      {%- if s.btn2_label != blank -%}<a class="ich-btn ich-btn--2" href="{{ s.btn2_link | default: routes.all_products_collection_url }}">{{ s.btn2_label }}</a>{%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture ich_trust -%}
  {%- if trust_blocks.size > 0 -%}
    <ul class="ich-trust ich-a" style="--i:4">
      {%- for b in trust_blocks -%}
        <li {{ b.shopify_attributes }}>{% render 'ich-hero-icon', icon: b.settings.icon %}<span>{{ b.settings.text }}</span></li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
{%- endcapture -%}

{%- capture ich_card -%}
  {%- if s.show_card and p != blank -%}
    {%- assign v = p.selected_or_first_available_variant -%}
    <div class="ich-card ich-a{% if s.anim_float %} ich-float{% endif %}" style="--i:5">
      <a class="ich-card__img" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
        {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', width: 120, height: 120, alt: p.featured_image.alt }}{%- endif -%}
      </a>
      <div class="ich-card__body">
        {%- if s.card_label != blank -%}<span class="ich-card__tag">{{ s.card_label }}</span>{%- endif -%}
        <a class="ich-card__title" href="{{ p.url }}"><bdi>{{ p.title }}</bdi></a>
        <span class="ich-card__price">
          {{ v.price | money }}
          {%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}
        </span>
        {%- if s.card_atc and v.available -%}
          {%- form 'product', p, class: 'ich-card__form' -%}
            <input type="hidden" name="id" value="{{ v.id }}">
            <button type="submit" class="ich-card__atc">{{ s.card_atc_label | default: 'Add to cart' }}</button>
          {%- endform -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture ich_offer -%}
  {%- if s.offer_text != blank -%}
    <div class="ich-offer">{% if s.offer_link != blank %}<a href="{{ s.offer_link }}">{{ s.offer_text }}</a>{% else %}<span>{{ s.offer_text }}</span>{% endif %}</div>
  {%- endif -%}
{%- endcapture -%}

<style>
#{{ sid }}{
  --bg:{{ s.c_bg }};--bg2:{{ s.c_bg2 }};--tx:{{ s.c_text }};--mu:{{ s.c_muted }};--ac:{{ s.c_accent }};--on:{{ s.c_on_accent }};
  --cd:{{ s.c_card }};--bd:{{ s.c_border }};--ov:{{ s.c_overlay }};--ovo:{{ s.overlay | divided_by: 100.0 }};
  --r:{{ s.radius }}px;--br:{{ s.btn_radius }}px;--hd:{{ s.h_size }}px;--hm:{{ s.h_size_m }}px;--sd:{{ s.sub_size }}px;
  --cw:{{ s.content_w }}px;--spd:{{ s.anim_speed }}ms;--stg:{{ s.anim_stagger }}ms;
  --pt:{{ s.pad_t }}px;--pb:{{ s.pad_b }}px;--ptm:{{ s.pad_t_m }}px;--pbm:{{ s.pad_b_m }}px;
  position:relative;isolation:isolate;overflow:hidden;color:var(--tx);
  background:{% if s.bg_style == 'radial' %}radial-gradient(ellipse 70% 90% at {% if dir == 'rtl' %}25%{% else %}75%{% endif %} 55%,var(--bg2) 0%,var(--bg) 70%){% elsif s.bg_style == 'linear' %}linear-gradient(180deg,var(--bg) 0%,var(--bg2) 100%){% else %}var(--bg){% endif %};
  padding-block:var(--pt) var(--pb);
  min-height:{{ s.height | replace: 'svh', 'vh' }};min-height:{{ s.height }};
  display:flex;flex-direction:column;justify-content:center;
}
#{{ sid }} *,#{{ sid }} *::before,#{{ sid }} *::after{box-sizing:border-box}
#{{ sid }} .ich-wrap{position:relative;z-index:2;width:100%;max-width:{{ s.max_w }}px;margin-inline:auto;padding-inline:clamp(16px,4vw,64px)}
#{{ sid }} .ich-content{max-width:var(--cw);display:flex;flex-direction:column;gap:20px;align-items:flex-start;text-align:start}
#{{ sid }}.ich-center .ich-content{align-items:center;text-align:center;margin-inline:auto}
#{{ sid }} .ich-badge{display:inline-flex;align-items:center;gap:10px;border:1px solid var(--ac);border-radius:999px;padding:6px 16px;font-size:14px;font-weight:700;color:var(--ac);letter-spacing:.2px}
#{{ sid }} .ich-dot-live{width:8px;height:8px;border-radius:50%;background:var(--ac);box-shadow:0 0 0 0 var(--ac)}
#{{ sid }} .ich-h{margin:0;font-size:var(--hd);line-height:1.2;font-weight:{{ s.h_weight }};color:var(--tx);letter-spacing:{% if dir == 'rtl' %}0{% else %}-.02em{% endif %};text-wrap:balance}
#{{ sid }} .ich-h em,#{{ sid }} .ich-h strong{font-style:normal;color:var(--ac)}
#{{ sid }} .ich-sub{margin:0;font-size:var(--sd);line-height:1.8;color:var(--mu);max-width:56ch;text-wrap:pretty}
#{{ sid }} .ich-sub em,#{{ sid }} .ich-sub strong{font-style:normal;color:var(--tx)}
#{{ sid }} .ich-btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:4px}
#{{ sid }} .ich-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 30px;border-radius:var(--br);font-weight:800;font-size:17px;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease,background-color .2s ease}
#{{ sid }} .ich-btn--1{background:var(--ac);color:var(--on);box-shadow:0 8px 24px -10px var(--ac)}
#{{ sid }} .ich-btn--2{border:1.5px solid var(--ac);color:var(--tx)}
#{{ sid }} .ich-btn:hover{transform:translateY(-2px)}
#{{ sid }} .ich-btn--1:hover{box-shadow:0 14px 30px -10px var(--ac)}
#{{ sid }} .ich-btn--2:hover{background:color-mix(in srgb,var(--ac) 14%,transparent)}
#{{ sid }} .ich-btn:focus-visible,#{{ sid }} a:focus-visible,#{{ sid }} button:focus-visible{outline:2px solid var(--ac);outline-offset:3px}
#{{ sid }} .ich-trust{list-style:none;margin:10px 0 0;padding:18px 0 0;border-top:1px solid var(--bd);display:flex;flex-wrap:wrap;gap:14px 28px}
#{{ sid }}.ich-center .ich-trust{justify-content:center}
#{{ sid }} .ich-trust li{display:flex;align-items:center;gap:9px;font-size:14px;font-weight:500;color:var(--mu)}
#{{ sid }} .ich-trust .ich-ico{color:var(--ac);width:22px;height:22px;flex-shrink:0}
#{{ sid }} .ich-offer{position:absolute;top:0;left:0;right:0;z-index:3;text-align:center;background:var(--ac);color:var(--on);font-weight:800;font-size:14px;padding:9px 16px}
#{{ sid }} .ich-offer a{color:inherit;text-decoration:none}
#{{ sid }} .ich-card{display:flex;align-items:center;gap:14px;background:color-mix(in srgb,var(--cd) 90%,transparent);border:1px solid var(--bd);border-radius:calc(var(--r) * .8);padding:12px;max-width:340px;box-shadow:0 18px 40px -18px rgba(0,0,0,.7)}
#{{ sid }} .ich-card__img{flex-shrink:0;width:84px;height:84px;border-radius:calc(var(--r) * .6);overflow:hidden;background:#fff;display:block}
#{{ sid }} .ich-card__img img{width:100%;height:100%;object-fit:contain;display:block}
#{{ sid }} .ich-card__body{display:flex;flex-direction:column;gap:3px;min-width:0}
#{{ sid }} .ich-card__tag{font-size:12px;font-weight:700;color:var(--ac)}
#{{ sid }} .ich-card__title{font-weight:800;font-size:15px;line-height:1.4;color:var(--tx);text-decoration:none;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
#{{ sid }} .ich-card__price{font-size:14px;color:var(--mu)}
#{{ sid }} .ich-card__price s{opacity:.6;margin-inline-start:8px;font-size:12px}
#{{ sid }} .ich-card__form{margin:4px 0 0}
#{{ sid }} .ich-card__atc{cursor:pointer;border:0;background:var(--ac);color:var(--on);font-weight:800;font-size:13px;padding:8px 16px;border-radius:var(--br);font-family:inherit}
#{{ sid }} .ich-ph{background:color-mix(in srgb,var(--tx) 6%,transparent);display:flex;align-items:center;justify-content:center}
#{{ sid }} .ich-ph-svg{width:60%;height:60%;fill:var(--mu);opacity:.35}
#{{ sid }} picture{display:block}
#{{ sid }} picture img{display:block;width:100%;height:100%;object-fit:cover}
#{{ sid }} .ich-glow{position:absolute;z-index:-1;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--ac) 45%,transparent) 0%,transparent 68%);pointer-events:none}
#{{ sid }} .ich-bgmedia,#{{ sid }} .ich-overlay{position:absolute;inset:0;z-index:0}
#{{ sid }} .ich-bgmedia picture,#{{ sid }} .ich-bgmedia video{width:100%;height:100%;object-fit:cover;display:block}
#{{ sid }} .ich-bgmedia video{position:absolute;inset:0}
#{{ sid }} .ich-overlay{z-index:1;background:linear-gradient({% if dir == 'rtl' %}270deg{% else %}90deg{% endif %},var(--ov) 0%,color-mix(in srgb,var(--ov) 40%,transparent) 60%,transparent 100%);opacity:var(--ovo)}
#{{ sid }}.ich-center .ich-overlay{background:var(--ov)}

{%- case tpl -%}
{%- when 'spotlight' or 'compare' -%}
#{{ sid }} .ich-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:clamp(24px,5vw,72px);align-items:center}
#{{ sid }} .ich-grid--swap .ich-content{order:2}
#{{ sid }} .ich-media{position:relative}
#{{ sid }} .ich-media .ich-frame{position:relative;border-radius:var(--r);overflow:hidden;aspect-ratio:{{ s.media_ratio }};box-shadow:0 30px 60px -30px rgba(0,0,0,.8)}
#{{ sid }} .ich-media .ich-frame picture,#{{ sid }} .ich-media .ich-frame .ich-ph{width:100%;height:100%}
#{{ sid }} .ich-media .ich-glow{inset:-15%}
#{{ sid }} .ich-media .ich-card{position:absolute;z-index:3;inset-inline-end:-24px;bottom:28px}
{%- if tpl == 'compare' -%}
#{{ sid }} .ich-cmp{--pos:50%;position:relative;border-radius:var(--r);overflow:hidden;aspect-ratio:{{ s.media_ratio }};user-select:none;touch-action:pan-y}
#{{ sid }} .ich-cmp picture,#{{ sid }} .ich-cmp .ich-ph{position:absolute;inset:0;width:100%;height:100%}
#{{ sid }} .ich-cmp .ich-cmp__after{clip-path:inset(0 0 0 var(--pos))}
#{{ sid }} .ich-cmp__line{position:absolute;top:0;bottom:0;left:var(--pos);width:2px;margin-left:-1px;background:var(--ac);z-index:2;pointer-events:none}
#{{ sid }} .ich-cmp__knob{position:absolute;top:50%;left:var(--pos);width:46px;height:46px;margin:-23px 0 0 -23px;border-radius:50%;background:var(--ac);color:var(--on);display:flex;align-items:center;justify-content:center;z-index:3;pointer-events:none;box-shadow:0 6px 20px rgba(0,0,0,.5)}
#{{ sid }} .ich-cmp__knob .ich-ico{width:18px;height:18px}
#{{ sid }} .ich-cmp input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:ew-resize;z-index:4}
#{{ sid }} .ich-cmp__lbl{position:absolute;top:14px;z-index:2;font-size:13px;font-weight:800;padding:5px 12px;border-radius:999px;background:color-mix(in srgb,var(--bg) 75%,transparent);color:var(--tx);pointer-events:none}
#{{ sid }} .ich-cmp__lbl--b{left:14px}
#{{ sid }} .ich-cmp__lbl--a{right:14px}
#{{ sid }} .ich-cmp__note{margin:10px 0 0;font-size:12px;color:var(--mu);opacity:.8}
{%- endif -%}
@media (max-width:749px){
