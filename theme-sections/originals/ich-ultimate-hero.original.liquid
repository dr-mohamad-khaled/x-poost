}

{%- unless s.anim == 'none' -%}
@media (prefers-reduced-motion:no-preference){
  #{{ sid }} .ich-a{animation:ich-in-{{ section.id }} var(--spd) cubic-bezier(.2,.7,.2,1) both;animation-delay:calc(var(--i,0) * var(--stg))}
  @keyframes ich-in-{{ section.id }}{from{opacity:.01;
    {%- case s.anim -%}
    {%- when 'fade-up' -%}transform:translateY(26px)
    {%- when 'blur' -%}filter:blur(12px);transform:scale(.98)
    {%- when 'slide' -%}transform:translateX({% if dir == 'rtl' %}40px{% else %}-40px{% endif %})
    {%- when 'zoom' -%}transform:scale(.92)
    {%- else -%}transform:none
    {%- endcase -%}
  }to{opacity:1;transform:none;filter:none}}
}
{%- endunless -%}
@media (prefers-reduced-motion:no-preference){
  {%- if s.anim_kenburns -%}
  #{{ sid }} .ich-kb img{animation:ich-kb-{{ section.id }} 22s ease-in-out infinite alternate;will-change:transform}
  @keyframes ich-kb-{{ section.id }}{from{transform:scale(1)}to{transform:scale(1.08)}}
  {%- endif -%}
  {%- if s.anim_float -%}
  #{{ sid }} .ich-float{animation:ich-in-{{ section.id }} var(--spd) cubic-bezier(.2,.7,.2,1) both,ich-fl-{{ section.id }} 6s ease-in-out calc(var(--spd) + 400ms) infinite}
  @keyframes ich-fl-{{ section.id }}{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
  {%- endif -%}
  {%- if s.anim_glow -%}
  #{{ sid }} .ich-glow{animation:ich-gl-{{ section.id }} 7s ease-in-out infinite}
  #{{ sid }} .ich-dot-live{animation:ich-pu-{{ section.id }} 2s ease-out infinite}
  @keyframes ich-gl-{{ section.id }}{0%,100%{opacity:.75;transform:scale(1)}50%{opacity:1;transform:scale(1.06)}}
  @keyframes ich-pu-{{ section.id }}{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--ac) 70%,transparent)}100%{box-shadow:0 0 0 10px transparent}}
  {%- endif -%}
}
</style>

<section id="{{ sid }}" class="ich-hero ich-t-{{ tpl }}{% if s.align == 'center' %} ich-center{% endif %}" dir="{{ dir }}" aria-label="{{ s.heading | strip_html | escape | default: shop.name }}">
  {%- unless tpl == 'editorial' -%}{%- if tpl != 'slideshow' -%}{{ ich_offer }}{%- endif -%}{%- endunless -%}

  {%- case tpl -%}

  {%- when 'spotlight' -%}
    <div class="ich-wrap ich-grid{% if s.media_side == 'start' %} ich-grid--swap{% endif %}">
      <div class="ich-content">{{ ich_badge }}{{ ich_heading }}{{ ich_sub }}{{ ich_buttons }}{{ ich_trust }}</div>
      <div class="ich-media">
        {%- if s.anim_glow -%}<div class="ich-glow"></div>{%- endif -%}
        <div class="ich-frame{% if s.anim_kenburns %} ich-kb{% endif %}">
          {%- render 'ich-hero-picture', image: s.image, mobile: s.image_m, eager: eager, sizes: '(min-width: 750px) 50vw, 100vw' -%}
        </div>
        {{ ich_card }}
      </div>
    </div>

  {%- when 'fullbleed' -%}
    <div class="ich-bgmedia{% if s.anim_kenburns %} ich-kb{% endif %}">
      {%- render 'ich-hero-picture', image: s.image, mobile: s.image_m, eager: eager -%}
    </div>
    <div class="ich-overlay"></div>
    <div class="ich-wrap ich-fb">
      <div class="ich-content">{{ ich_badge }}{{ ich_heading }}{{ ich_sub }}{{ ich_buttons }}{{ ich_card }}{{ ich_trust }}</div>
    </div>

  {%- when 'video' -%}
    <div class="ich-bgmedia">
      {%- if s.image != blank -%}
        {%- render 'ich-hero-picture', image: s.image, mobile: s.image_m, eager: eager -%}
      {%- endif -%}
      {%- if s.video != blank -%}
        {{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, preload: 'metadata', image_size: '1200x', class: 'ich-video' }}
        {%- unless s.video_mobile -%}
          <script>(function(){if(matchMedia('(max-width:749px)').matches){var v=document.querySelector('#{{ sid }} .ich-video');if(v)v.remove();}})();</script>
        {%- endunless -%}
      {%- elsif s.image == blank -%}
        <div class="ich-ph" style="width:100%;height:100%">{{ 'lifestyle-1' | placeholder_svg_tag: 'ich-ph-svg' }}</div>
      {%- endif -%}
    </div>
    <div class="ich-overlay"></div>
    <div class="ich-wrap ich-fb">
      <div class="ich-content">{{ ich_badge }}{{ ich_heading }}{{ ich_sub }}{{ ich_buttons }}{{ ich_card }}{{ ich_trust }}</div>
    </div>

  {%- when 'concern' -%}
    {%- if s.image != blank -%}
      <div class="ich-bgmedia">{%- render 'ich-hero-picture', image: s.image, mobile: s.image_m, eager: false -%}</div>
    {%- endif -%}
    <div class="ich-wrap">
      <div class="ich-head">{{ ich_badge }}{{ ich_heading }}{{ ich_sub }}</div>
      {%- if tile_blocks.size > 0 -%}
        <ul class="ich-tiles ich-a" style="--i:3">
          {%- for b in tile_blocks -%}
            <li {{ b.shopify_attributes }}>
              <a class="ich-tile" href="{{ b.settings.link | default: routes.all_products_collection_url }}">
                <span class="ich-tile__ico">
                  {%- if b.settings.image != blank -%}
                    {{ b.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', width: 58, height: 58, alt: '' }}
                  {%- else -%}
                    {% render 'ich-hero-icon', icon: b.settings.icon %}
                  {%- endif -%}
                </span>
                <span><span class="ich-tile__t">{{ b.settings.title }}</span>{%- if b.settings.subtitle != blank -%}<span class="ich-tile__s">{{ b.settings.subtitle }}</span>{%- endif -%}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <div class="ich-foot">{{ ich_buttons }}{{ ich_trust }}</div>
    </div>

  {%- when 'editorial' -%}
    {{ ich_offer }}
    <div class="ich-wrap ich-ed">
      <div class="ich-content">
        {%- if s.kicker != blank -%}<span class="ich-kicker ich-a" style="--i:0">{{ s.kicker }}</span>{%- endif -%}
        {{ ich_heading }}{{ ich_sub }}{{ ich_buttons }}{{ ich_trust }}
      </div>
      <div class="ich-aside">
        {%- if s.image != blank -%}
          <div class="ich-frame ich-a{% if s.anim_kenburns %} ich-kb{% endif %}" style="--i:2">
            {%- render 'ich-hero-picture', image: s.image, mobile: s.image_m, eager: eager, sizes: '(min-width: 750px) 40vw, 100vw' -%}
          </div>
        {%- endif -%}
        {{ ich_card }}
        {%- if brand_blocks.size > 0 -%}
          <div class="ich-brands ich-a" style="--i:6">
            {%- if s.brands_label != blank -%}<span class="ich-brands__l">{{ s.brands_label }}</span>{%- endif -%}
            <ul dir="ltr">
              {%- for b in brand_blocks -%}
                <li {{ b.shopify_attributes }}>{%- if b.settings.link != blank -%}<a href="{{ b.settings.link }}">{{ b.settings.name }}</a>{%- else -%}<span>{{ b.settings.name }}</span>{%- endif -%}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>

  {%- when 'compare' -%}
    <div class="ich-wrap ich-grid{% if s.media_side == 'start' %} ich-grid--swap{% endif %}">
      <div class="ich-content">{{ ich_badge }}{{ ich_heading }}{{ ich_sub }}{{ ich_buttons }}{{ ich_card }}{{ ich_trust }}</div>
      <div class="ich-media">
        {%- if s.anim_glow -%}<div class="ich-glow"></div>{%- endif -%}
        <div class="ich-cmp" dir="ltr">
          {%- render 'ich-hero-picture', image: s.image, eager: eager, sizes: '(min-width: 750px) 50vw, 100vw', class: 'ich-cmp__before' -%}
          {%- render 'ich-hero-picture', image: s.image_2, eager: false, sizes: '(min-width: 750px) 50vw, 100vw', class: 'ich-cmp__after' -%}
          {%- if s.before_label != blank -%}<span class="ich-cmp__lbl ich-cmp__lbl--b">{{ s.before_label }}</span>{%- endif -%}
          {%- if s.after_label != blank -%}<span class="ich-cmp__lbl ich-cmp__lbl--a">{{ s.after_label }}</span>{%- endif -%}
          <span class="ich-cmp__line"></span>
          <span class="ich-cmp__knob">{% render 'ich-hero-icon', icon: 'arrow' %}{% render 'ich-hero-icon', icon: 'arrow-r' %}</span>
          <input type="range" min="0" max="100" value="50" aria-label="{{ s.before_label | default: 'Before' }} / {{ s.after_label | default: 'After' }}">
        </div>
        {%- if s.compare_note != blank -%}<p class="ich-cmp__note">{{ s.compare_note }}</p>{%- endif -%}
      </div>
    </div>

  {%- when 'slideshow' -%}
    <div class="ich-stage">
    <div class="ich-track" dir="ltr" tabindex="0" aria-roledescription="carousel">
      {%- for b in slide_blocks -%}
        {%- liquid
          assign bs = b.settings
          assign slide_eager = false
          if forloop.first and eager
            assign slide_eager = true
          endif
        -%}
        <div class="ich-slide" {{ b.shopify_attributes }} aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ forloop.length }}">
          <div class="ich-bgmedia{% if s.anim_kenburns %} ich-kb{% endif %}">{%- render 'ich-hero-picture', image: bs.image, mobile: bs.image_m, eager: slide_eager -%}</div>
          <div class="ich-overlay"></div>
          <div class="ich-wrap" dir="{{ dir }}">
            <div class="ich-content">
              {%- if bs.badge != blank -%}<span class="ich-badge{% if forloop.first %} ich-a{% endif %}" style="--i:0"><span class="ich-dot-live"></span>{{ bs.badge }}</span>{%- endif -%}
              {%- if bs.heading != blank -%}
                {%- if forloop.first -%}<{{ htag }} class="ich-h ich-a" style="--i:1">{{ bs.heading }}</{{ htag }}>{%- else -%}<p class="ich-h" role="heading" aria-level="2">{{ bs.heading }}</p>{%- endif -%}
              {%- endif -%}
              {%- if bs.text != blank -%}<p class="ich-sub{% if forloop.first %} ich-a{% endif %}" style="--i:2">{{ bs.text }}</p>{%- endif -%}
              {%- if bs.btn_label != blank -%}<div class="ich-btns{% if forloop.first %} ich-a{% endif %}" style="--i:3"><a class="ich-btn ich-btn--1" href="{{ bs.btn_link | default: routes.all_products_collection_url }}">{{ bs.btn_label }}</a>{%- if bs.btn2_label != blank -%}<a class="ich-btn ich-btn--2" href="{{ bs.btn2_link | default: routes.all_products_collection_url }}">{{ bs.btn2_label }}</a>{%- endif -%}</div>{%- endif -%}
            </div>
          </div>
        </div>
      {%- else -%}
        <div class="ich-slide"><div class="ich-wrap" dir="{{ dir }}"><div class="ich-content">{{ ich_heading }}{{ ich_sub }}{{ ich_buttons }}</div></div></div>
      {%- endfor -%}
    </div>
    {%- if slide_blocks.size > 1 -%}
      <div class="ich-nav" dir="ltr">
        <button type="button" class="ich-arr ich-prev" aria-label="Previous">{% render 'ich-hero-icon', icon: 'arrow' %}</button>
        <div class="ich-dots">{%- for b in slide_blocks -%}<button type="button" class="ich-dotb" aria-label="{{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{%- endfor -%}</div>
        <button type="button" class="ich-arr ich-next" aria-label="Next">{% render 'ich-hero-icon', icon: 'arrow-r' %}</button>
      </div>
    {%- endif -%}
    </div>
    {%- if trust_blocks.size > 0 -%}<div class="ich-strip"><div class="ich-wrap">{{ ich_trust }}</div></div>{%- endif -%}

  {%- endcase -%}
</section>

{%- if tpl == 'slideshow' and slide_blocks.size > 1 -%}
<script>
(function(){var r=document.getElementById('{{ sid }}');if(!r)return;var t=r.querySelector('.ich-track'),sl=t.children,d=r.querySelectorAll('.ich-dotb'),n=sl.length,i=0,tm=null,vis=false,hov=false,ms={{ s.interval | times: 1000 }},auto={% if s.autoplay %}true{% else %}false{% endif %}&&!matchMedia('(prefers-reduced-motion:reduce)').matches;
function go(k){i=(k+n)%n;var x=sl[i].offsetLeft;t.scrollTo({left:x,behavior:'smooth'});setTimeout(function(){if(Math.abs(t.scrollLeft-x)>4){t.scrollLeft=x;mark();}},700);}
function mark(){var k=Math.round(t.scrollLeft/t.clientWidth);if(k<0)k=0;if(k>n-1)k=n-1;i=k;for(var j=0;j<d.length;j++)d[j].setAttribute('aria-current',j===k?'true':'false');}
function stop(){clearInterval(tm);tm=null;}function play(){stop();if(auto&&vis&&!hov)tm=setInterval(function(){go(i+1)},ms);}
var st;t.addEventListener('scroll',function(){clearTimeout(st);st=setTimeout(mark,90)},{passive:true});
for(var j=0;j<d.length;j++)(function(j){d[j].addEventListener('click',function(){go(j);play();})})(j);
var pv=r.querySelector('.ich-prev'),nx=r.querySelector('.ich-next');if(pv)pv.addEventListener('click',function(){go(i-1);play();});if(nx)nx.addEventListener('click',function(){go(i+1);play();});
r.addEventListener('mouseenter',function(){hov=true;stop()});r.addEventListener('mouseleave',function(){hov=false;play()});
r.addEventListener('focusin',function(){hov=true;stop()});r.addEventListener('focusout',function(){hov=false;play()});
if('IntersectionObserver'in window){new IntersectionObserver(function(e){vis=e[0].isIntersecting;vis?play():stop()},{threshold:.3}).observe(r);}else{vis=true;play();}
document.addEventListener('shopify:block:select',function(e){if(!r.contains(e.target))return;for(var k=0;k<n;k++)if(sl[k]===e.target){auto=false;stop();go(k);}});
})();
</script>
{%- elsif tpl == 'compare' -%}
<script>
(function(){var c=document.querySelector('#{{ sid }} .ich-cmp');if(!c)return;var x=c.querySelector('input');x.addEventListener('input',function(){c.style.setProperty('--pos',x.value+'%')});})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Instachiq Ultimate Hero",
  "tag": "div",
  "class": "ich-hero-shell",
  "settings": [
    { "type": "select", "id": "template", "label": "Template", "default": "spotlight", "options": [
      { "value": "spotlight", "label": "1. Spotlight: text + image + product card" },
      { "value": "fullbleed", "label": "2. Full-bleed image" },
      { "value": "concern", "label": "3. Concern picker (tiles)" },
      { "value": "editorial", "label": "4. Korean editorial + brands" },
      { "value": "slideshow", "label": "5. Slideshow (uses Slide blocks)" },
      { "value": "compare", "label": "6. Before / after slider" },
      { "value": "video", "label": "7. Video background" }
    ]},
    { "type": "checkbox", "id": "is_first", "label": "This is the first section on the page", "default": true, "info": "Loads the main image immediately with high priority for the best speed score. Turn off if the hero is lower on the page." },

    { "type": "header", "content": "Text" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "وصل حديثاً في المتجر" },
    { "type": "text", "id": "kicker", "label": "Kicker (editorial template)", "default": "K-BEAUTY / SKINCARE / HAIR" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Make words italic or bold to color them with the accent color.", "default": "اللي مش مضمون بره، <em>مضمون هنا</em>" },
    { "type": "select", "id": "heading_tag", "label": "Heading tag (SEO)", "default": "h2", "options": [ { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" } ] },
    { "type": "inline_richtext", "id": "subheading", "label": "Subheading", "default": "سيرومات وكريمات وعناية شعر كورية وعالمية، أصلية فقط، بتوصلك في مصر وفي أي مكان في العالم." },
    { "type": "text", "id": "btn1_label", "label": "Primary button label", "default": "تسوق الأحدث" },
    { "type": "url", "id": "btn1_link", "label": "Primary button link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button label", "default": "ابني روتين بشرتك" },
    { "type": "url", "id": "btn2_link", "label": "Secondary button link" },
    { "type": "text", "id": "offer_text", "label": "Offer bar text", "info": "Thin bar on top of the hero. Leave empty to hide." },
    { "type": "url", "id": "offer_link", "label": "Offer bar link" },

    { "type": "header", "content": "Images and video" },
    { "type": "image_picker", "id": "image", "label": "Main image", "info": "Spotlight and editorial: product shot. Full-bleed and concern: background. Compare: BEFORE image. Video: poster shown while the video loads." },
    { "type": "image_picker", "id": "image_m", "label": "Mobile image (optional)", "info": "Portrait image for phones. Not used by the compare template." },
    { "type": "image_picker", "id": "image_2", "label": "AFTER image (compare template)" },
    { "type": "select", "id": "media_ratio", "label": "Image shape", "default": "1/1", "options": [ { "value": "1/1", "label": "Square" }, { "value": "4/5", "label": "Portrait 4:5" }, { "value": "3/4", "label": "Portrait 3:4" }, { "value": "4/3", "label": "Landscape 4:3" }, { "value": "16/9", "label": "Wide 16:9" } ] },
    { "type": "select", "id": "media_side", "label": "Image side (desktop)", "default": "end", "options": [ { "value": "end", "label": "After text" }, { "value": "start", "label": "Before text" } ] },
    { "type": "checkbox", "id": "mobile_media_first", "label": "Show image above text on mobile", "default": false },
    { "type": "video", "id": "video", "label": "Background video (video template)", "info": "Upload a short, muted MP4 under 8 MB for best speed." },
    { "type": "checkbox", "id": "video_mobile", "label": "Play video on mobile", "default": false, "info": "Off = phones show the poster image only, which saves data and speeds up the page." },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "قبل" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "بعد" },
    { "type": "text", "id": "compare_note", "label": "Note under compare image", "default": "صور توضيحية، والنتائج بتختلف من شخص للتاني." },

    { "type": "header", "content": "Featured product card" },
    { "type": "checkbox", "id": "show_card", "label": "Show product card", "default": true },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "card_label", "label": "Card tag", "default": "جديد" },
    { "type": "checkbox", "id": "card_atc", "label": "Show add to cart button", "default": true },
    { "type": "text", "id": "card_atc_label", "label": "Add to cart label", "default": "أضف للعربة" },

    { "type": "header", "content": "Concern and brand templates" },
    { "type": "select", "id": "tile_cols", "label": "Tiles per row (desktop)", "default": "3", "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ] },
    { "type": "text", "id": "brands_label", "label": "Brands title", "default": "براندات بنوفرها" },

    { "type": "header", "content": "Colors" },
    { "type": "select", "id": "bg_style", "label": "Background style", "default": "radial", "options": [ { "value": "solid", "label": "Solid" }, { "value": "radial", "label": "Soft glow" }, { "value": "linear", "label": "Vertical gradient" } ] },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#0a0a0a" },
    { "type": "color", "id": "c_bg2", "label": "Background glow / gradient", "default": "#3a2c0a" },
    { "type": "color", "id": "c_text", "label": "Heading text", "default": "#fff8e6" },
    { "type": "color", "id": "c_muted", "label": "Body text", "default": "#e4dcc6" },
    { "type": "color", "id": "c_accent", "label": "Accent (buttons, highlights)", "default": "#e6c36a" },
    { "type": "color", "id": "c_on_accent", "label": "Text on accent", "default": "#1a1405" },
    { "type": "color", "id": "c_card", "label": "Cards and tiles", "default": "#15110a" },
    { "type": "color", "id": "c_border", "label": "Borders", "default": "#4a3c1c" },
    { "type": "color", "id": "c_overlay", "label": "Image overlay", "default": "#000000" },
    { "type": "range", "id": "overlay", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 60 },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "h_size", "label": "Heading size (desktop)", "min": 28, "max": 96, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "h_size_m", "label": "Heading size (mobile)", "min": 20, "max": 60, "step": 1, "unit": "px", "default": 28 },
    { "type": "select", "id": "h_weight", "label": "Heading weight", "default": "900", "options": [ { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
    { "type": "range", "id": "sub_size", "label": "Subheading size", "min": 14, "max": 26, "step": 1, "unit": "px", "default": 20 },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "align", "label": "Text alignment", "default": "start", "options": [ { "value": "start", "label": "Start" }, { "value": "center", "label": "Center" } ] },
    { "type": "select", "id": "height", "label": "Height (desktop)", "default": "auto", "options": [ { "value": "auto", "label": "Fit content" }, { "value": "60svh", "label": "60% of screen" }, { "value": "75svh", "label": "75% of screen" }, { "value": "90svh", "label": "90% of screen" }, { "value": "100svh", "label": "Full screen" } ] },
    { "type": "select", "id": "height_m", "label": "Height (mobile)", "default": "auto", "options": [ { "value": "auto", "label": "Fit content" }, { "value": "50svh", "label": "50% of screen" }, { "value": "60svh", "label": "60% of screen" }, { "value": "75svh", "label": "75% of screen" }, { "value": "90svh", "label": "90% of screen" }, { "value": "100svh", "label": "Full screen" } ] },
    { "type": "range", "id": "max_w", "label": "Max content width", "min": 960, "max": 1920, "step": 40, "unit": "px", "default": 1320 },
    { "type": "range", "id": "content_w", "label": "Text column width", "min": 400, "max": 900, "step": 20, "unit": "px", "default": 600 },
