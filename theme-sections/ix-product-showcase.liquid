          });
      },

      /* Close: the product flies back into its card when both are on screen. */
      close: function (fromPop, instant) {
        var self = this, el = this.el, src = this.src;
        if (!this.isOpen) return;
        this.isOpen = false;
        if (this.flyAnim) { try { this.flyAnim.finish(); } catch (e) {} this.flyAnim = null; }
        var hero = this.body.querySelector('.ixq__hero'), track = this.body.querySelector('.ixq__track');
        var back = !instant && !reduce && src && hero && track && Math.abs(track.scrollLeft) < 4;
        var tr = back ? src.getBoundingClientRect() : null, hr = back ? hero.getBoundingClientRect() : null;
        if (back && !(visible(tr) && visible(hr))) back = false;
        el.classList.remove('is-open', 'is-in');
        document.documentElement.classList.remove('xpc-lock');
        var done = function () {
          if (src) src.style.visibility = '';
          if (!self.isOpen) { el.hidden = true; el.classList.remove('is-landed', 'is-fly'); self.body.innerHTML = ''; }
        };
        if (back) {
          var f = this.flyer(hero, hr);
          f.style.objectFit = getComputedStyle(src).objectFit;
          hero.style.opacity = '0';
          var anim = f.animate([
            { transform: 'translate3d(0,0,0) scale(1,1)' },
            { transform: 'translate3d(' + (tr.left - hr.left) + 'px,' + (tr.top - hr.top) + 'px,0) scale(' + tr.width / hr.width + ',' + tr.height / hr.height + ')' }
          ], { duration: 460, easing: 'cubic-bezier(.4,0,.2,1)', fill: 'forwards' });
          anim.onfinish = function () { f.remove(); done(); };
        } else if (instant || reduce) {
          done();
        } else {
          setTimeout(done, 300);
        }
        if (this.pushed && !fromPop) { this.pushed = false; try { history.back(); } catch (e) {} }
        this.pushed = false;
        if (!instant && this.last && this.last.focus && document.contains(this.last)) this.last.focus({ preventScroll: true });
      }
    };

    /* ---------- Wire up each showcase ---------- */
    function Sec(root) {
      var self = this;
      this.root = root;
      try {
        this.cfg = JSON.parse(root.querySelector('[data-ixq-config]').textContent);
        this.items = JSON.parse(root.querySelector('[data-ixq-items]').textContent).filter(Boolean);
      } catch (e) { return; }
      var byK = {};
      this.items.forEach(function (it) { byK[it.k] = it; });
      function itemOf(el) { var li = el.closest('[data-ix]'); return li ? byK[li.getAttribute('data-ix')] : null; }
      root.addEventListener('click', function (e) {
        var trig = e.target.closest('[data-ixq-open]');
        if (!trig || e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
        var it = itemOf(trig);
        if (!it) return;
        e.preventDefault();
        var li = trig.closest('[data-ix]');
        Q.open(self, it, li.querySelector('.ixps__img'));
      });
      var warm = function (e) {
        var li = e.target.closest && e.target.closest('[data-ix]');
        var it = li && byK[li.getAttribute('data-ix')];
        if (it) loadProduct(self.cfg.root, it.h).catch(function () {});
      };
      root.addEventListener('pointerover', warm, { passive: true });
      root.addEventListener('touchstart', warm, { passive: true });
      root.addEventListener('focusin', warm);
    }
    function scan() { Array.prototype.forEach.call(document.querySelectorAll('[data-ixq-section]'), function (r) { if (!r.__ixq) r.__ixq = new Sec(r); }); }
    window.IXQuickView = { scan: scan };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', scan); else scan();
    document.addEventListener('shopify:section:load', scan);
  })();
  {% endraw %}
  </script>
  {%- endif -%}
</section>
{%- endif -%}

