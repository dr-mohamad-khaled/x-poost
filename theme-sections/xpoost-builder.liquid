    .xpb-chip.is-on{background:var(--xpb-accent);border-color:var(--xpb-accent);color:var(--xpb-on-accent)}
    .xpb-list{display:flex;flex-direction:column;gap:10px}
    .xpb-row{background:var(--xpb-card);border-radius:var(--xpb-radius);padding:8px;display:flex;align-items:center;gap:12px;border:2px solid var(--xpb-card)}
    .xpb-row.is-on{border-color:var(--xpb-accent)}
    .xpb-row .xpb-media{width:96px;flex:none;aspect-ratio:1/1}
    .xpb-row .xpb-select{margin-top:4px;min-height:38px}

    .xpb-stack{display:flex;flex-direction:column;max-width:560px;margin:0 auto}
    .xpb-rcard{background:var(--xpb-card);border:1px solid var(--xpb-border);border-radius:var(--xpb-radius);padding:8px 8px 12px;display:flex;flex-direction:column;gap:10px}
    .xpb-rcard.is-main{border-color:var(--xpb-accent)}
    .xpb-rcard.is-off{opacity:.92}
    .xpb-rrow{display:flex;align-items:flex-start;gap:10px;padding:4px 4px 0}
    .xpb-checkrow{display:flex;align-items:flex-start;gap:10px;flex:1;min-width:0;cursor:pointer}
    .xpb-checkrow input{width:22px;height:22px;margin:2px 0 0;accent-color:var(--xpb-accent);flex:none}
    .xpb-checkrow > span{display:flex;flex-direction:column;gap:3px;min-width:0}
    .xpb-vrow{display:flex;align-items:center;gap:10px;padding:0 4px;font-size:13px;color:var(--xpb-muted)}
    .xpb-plus{display:flex;justify-content:center;margin:-10px 0;position:relative;z-index:1}
    .xpb-plus span{width:36px;height:36px;border-radius:99px;background:var(--xpb-accent);color:var(--xpb-on-accent);border:4px solid var(--xpb-bg);display:flex;align-items:center;justify-content:center}
    .xpb-summary{max-width:560px;margin:16px auto 0;background:var(--xpb-bar);border:1px solid var(--xpb-border);border-radius:var(--xpb-radius);padding:16px;display:flex;flex-direction:column;gap:12px}

    .xpb-steps{list-style:none;margin:0 0 18px;padding:0;display:grid;grid-template-columns:repeat(var(--xpb-n),minmax(0,1fr))}
    .xpb-steps li{position:relative;display:flex;justify-content:center}
    .xpb-steps li + li::before{content:"";position:absolute;top:17px;inset-inline-end:50%;width:100%;height:2px;background:var(--xpb-border)}
    .xpb-steps li.is-reached::before{background:var(--xpb-accent)}
    .xpb-steps button{position:relative;background:none;border:0;padding:0;color:var(--xpb-text);display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;font-size:13px;min-width:44px}
    .xpb-dot{width:36px;height:36px;border-radius:99px;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700;background:var(--xpb-card);color:var(--xpb-muted);border:1px solid var(--xpb-border)}
    .is-done .xpb-dot{background:var(--xpb-accent);color:var(--xpb-on-accent);border-color:var(--xpb-accent)}
    .is-active .xpb-dot{background:var(--xpb-bg);color:var(--xpb-accent);border:2px solid var(--xpb-accent)}
    .is-active .xpb-steps__label,.is-done .xpb-steps__label{font-weight:700}
    .xpb-steps__label{color:var(--xpb-text)}
    .xpb-banner{position:relative;min-height:170px;border-radius:var(--xpb-radius);overflow:hidden;display:flex;align-items:flex-end;background:linear-gradient(160deg,color-mix(in srgb,var(--xpb-accent) 18%,var(--xpb-card)) 0%,var(--xpb-card) 60%,var(--xpb-bg) 100%);margin-bottom:14px}
    .xpb-banner img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .xpb-banner__c{position:relative;width:100%;padding:50px 16px 16px;background:linear-gradient(to top,rgba(0,0,0,.72),rgba(0,0,0,0));display:flex;flex-direction:column;gap:4px}
    .xpb-banner__k{font-size:13px;font-weight:700;color:var(--xpb-accent)}
    .xpb-banner__t{margin:0;font-size:22px;font-weight:700;color:#fff}
    .xpb-banner__d{margin:0;font-size:14px;line-height:1.55;color:#e6e6e6}
    .xpb-skip{margin-top:12px}

    .xpb-acc{display:flex;flex-direction:column;gap:10px}
    .xpb-acc__item{background:var(--xpb-card);border-radius:var(--xpb-radius);border:1px solid var(--xpb-border);overflow:hidden}
    .xpb-acc__item.is-open{border:2px solid var(--xpb-accent)}
    .xpb-acc__head{width:100%;display:flex;align-items:center;gap:12px;padding:10px;border:0;background:transparent;color:var(--xpb-text);text-align:start;cursor:pointer}
    .xpb-acc__img{width:72px;height:72px;flex:none;border-radius:max(0px,calc(var(--xpb-radius) - 4px));background:var(--xpb-tile);overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700;color:#121111}
    .xpb-acc__img img{width:100%;height:100%;object-fit:cover}
    .xpb-acc__txt{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
    .xpb-acc__k{font-size:13px;color:var(--xpb-muted)}
    .xpb-acc__t{font-size:18px;font-weight:700}
    .xpb-acc__s{font-size:13.5px;color:var(--xpb-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;unicode-bidi:plaintext}
    .xpb-acc__s.is-done{color:var(--xpb-accent);font-weight:700}
    .xpb-acc__ok{width:26px;height:26px;flex:none;border-radius:99px;background:var(--xpb-accent);color:var(--xpb-on-accent);display:flex;align-items:center;justify-content:center}
    .xpb-chev{flex:none;transition:transform .2s}
    .is-open .xpb-chev{transform:rotate(180deg)}
    .xpb-acc__body{padding:2px 10px 14px}
    .xpb-scroller{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:2px}
    .xpb-scroller .xpb-card{flex:0 0 150px;scroll-snap-align:start;background:var(--xpb-bg);border-color:var(--xpb-border);border-width:1px}
    .xpb-scroller .xpb-card.is-on{border-color:var(--xpb-accent);border-width:2px}

    .xpb-box{position:relative;border-radius:var(--xpb-radius);background-color:var(--xpb-box);background-size:cover;background-position:center;padding:16px;overflow:hidden;margin-bottom:16px}
    .xpb-box__rib{position:absolute;background:var(--xpb-accent);opacity:.85;pointer-events:none}
    .xpb-box__rib--v{top:0;bottom:0;left:50%;width:14px;margin-left:-7px}
    .xpb-box__rib--h{left:0;right:0;top:50%;height:14px;margin-top:-7px}
    .xpb-box__top{position:relative;display:flex;justify-content:flex-start;margin-bottom:12px}
    .xpb-box__count{font-size:14px;font-weight:700;color:#121111;background:rgba(255,255,255,.9);padding:4px 12px;border-radius:99px}
    .xpb-box__grid{position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .xpb-bslot{aspect-ratio:1/1;border-radius:max(0px,calc(var(--xpb-radius) - 4px));overflow:hidden;display:flex;flex-direction:column;border:0;padding:0;cursor:pointer;background:var(--xpb-tile);box-shadow:0 8px 20px rgba(0,0,0,.35);color:var(--xpb-text);text-align:start}
    .xpb-bslot__img{flex:1;min-height:0;width:100%;display:flex;align-items:center;justify-content:center}
    .xpb-bslot__img img{width:100%;height:100%;object-fit:cover}
    .xpb-bslot__cap{background:var(--xpb-bg);padding:6px 8px;display:flex;flex-direction:column;gap:1px;width:100%}
    .xpb-bslot__cap b{font-size:11.5px;color:var(--xpb-accent)}
    .xpb-bslot__cap span{font-size:12px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;unicode-bidi:plaintext}
    .xpb-bslot--empty{background:rgba(18,17,17,.72);border:2px dashed rgba(255,255,255,.7);box-shadow:none;align-items:center;justify-content:center;gap:6px;color:#fff;font-weight:700;font-size:14px}
    .xpb-bslot--empty i{font-style:normal;font-size:28px;line-height:1;color:var(--xpb-accent);font-weight:400}
    .xpb-tabs{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;margin-bottom:14px;scrollbar-width:none}
    .xpb-tab{flex:none;display:flex;align-items:center;gap:8px;padding:6px 14px 6px 6px;padding-inline:6px 14px;border-radius:99px;background:var(--xpb-card);border:1px solid var(--xpb-border);color:var(--xpb-text);cursor:pointer;text-align:start}
    .xpb-tab.is-on{border:2px solid var(--xpb-accent)}
    .xpb-tab__dot{width:36px;height:36px;border-radius:99px;flex:none;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700;background:var(--xpb-border);color:var(--xpb-text);overflow:hidden}
    .xpb-tab__dot img{width:100%;height:100%;object-fit:cover}
    .xpb-tab.is-done .xpb-tab__dot{background:var(--xpb-accent);color:var(--xpb-on-accent)}
    .xpb-tab__txt{display:flex;flex-direction:column;line-height:1.3}
    .xpb-tab__txt b{font-size:14px}
    .xpb-tab__txt span{font-size:11.5px;color:var(--xpb-muted)}

    @media (min-width:750px){
      .xpb__wrap{padding:0 24px}
      .xpb-grid{grid-template-columns:repeat(var(--xpb-cols-d),minmax(0,1fr));gap:16px}
      .xpb-bar{margin:22px 0 0;border:1px solid var(--xpb-accent);border-radius:var(--xpb-radius)}
      .xpb-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}
      .xpb-slot{flex-basis:160px}
      .xpb-hero__img--d{display:block}
      .xpb-hero__img--m{display:none}
      .xpb-scroller{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));overflow:visible}
