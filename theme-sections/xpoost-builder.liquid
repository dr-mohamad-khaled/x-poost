{% schema %}
{
  "name": "XPoost Builder",
  "tag": "div",
  "class": "xpb-section",
  "settings": [
    { "type": "header", "content": "Builder type" },
    {
      "type": "select",
      "id": "mode",
      "label": "Type",
      "options": [
        { "value": "bundle", "label": "Bundle builder" },
        { "value": "kit", "label": "Kit builder (steps)" }
      ],
      "default": "bundle",
      "info": "Bundle: add Product blocks. Kit: add Step blocks, each with its own products."
    },
    {
      "type": "select",
      "id": "bundle_layout",
      "label": "Bundle layout",
      "options": [
        { "value": "hero_grid", "label": "A · Hero + grid" },
        { "value": "slots_chips", "label": "B · Slots + concern chips" },
        { "value": "routine_stack", "label": "C · Routine stack" }
      ],
      "default": "hero_grid"
    },
    {
      "type": "select",
      "id": "kit_layout",
      "label": "Kit layout",
      "options": [
        { "value": "stepper", "label": "A · Stepper + step banner" },
        { "value": "accordion", "label": "B · Image accordion" },
        { "value": "box", "label": "C · Fill the box" }
      ],
      "default": "stepper"
    },
    {
      "type": "range",
      "id": "bundle_size",
      "label": "Bundle: maximum products",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 3,
      "info": "Used by layouts A and B. Layout C adds every ticked product."
    },
    {
      "type": "range",
      "id": "bundle_min",
      "label": "Bundle: minimum to add to cart",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1,
      "info": "1 lets shoppers add a single product."
    },
    {
      "type": "select",
      "id": "kit_rule",
      "label": "Kit: step rules",
      "options": [
        { "value": "free", "label": "Free: skip any step, 1 product is enough" },
        { "value": "rules", "label": "Strict: follow each step's minimum" }
      ],
      "default": "free"
    },

    { "type": "header", "content": "Display" },
    {
      "type": "select",
      "id": "display",
      "label": "Show as",
      "options": [
        { "value": "inline", "label": "On the page" },
        { "value": "drawer", "label": "Side drawer" },
        { "value": "popup", "label": "Popup (bottom sheet on mobile)" }
      ],
      "default": "inline"
    },
    { "type": "checkbox", "id": "show_trigger", "label": "Show open button on the page", "default": true, "info": "Drawer and popup only. Turn off if you only open it from a link." },
    { "type": "text", "id": "trigger_label", "label": "Open button text", "default": "ابني روتينك" },
    {
