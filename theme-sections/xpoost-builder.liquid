    }
    @media (min-width:990px){
      .xpb__cols--split{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:32px;align-items:start}
      .xpb__cols--split .xpb-hero{position:sticky;top:24px;margin-bottom:0;min-height:max(var(--xpb-hero-h),560px)}
      .xpb--box .xpb-split{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:28px;align-items:start}
      .xpb--box .xpb-split .xpb-box{position:sticky;top:24px}
      .xpb--box .xpb-box__grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    }

    .xpb-trig{display:flex;justify-content:center}
    html.xpb-lock{overflow:hidden}
    .xpb.xpb-ov{position:fixed;inset:0;z-index:2147483000;display:flex;padding:0;background:transparent}
    .xpb.xpb-ov[hidden]{display:none}
    .xpb-ov__bg{position:absolute;inset:0;background:rgba(0,0,0,.65);opacity:0;transition:opacity .25s ease}
    .xpb-ov.is-open .xpb-ov__bg{opacity:1}
    .xpb-panel{position:relative;display:flex;flex-direction:column;background:var(--xpb-bg);color:var(--xpb-text);box-shadow:0 10px 40px rgba(0,0,0,.5);transition:transform .3s ease,opacity .3s ease}
    .xpb-panel__head{flex:none;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 14px;border-bottom:1px solid var(--xpb-border)}
    .xpb-panel__title{margin:0;font-size:18px;font-weight:700;color:var(--xpb-accent);line-height:1.3}
    .xpb-panel__body{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;padding-top:16px;-webkit-overflow-scrolling:touch}
    .xpb-ov--drawer.xpb-ov--end{justify-content:flex-end}
    .xpb-ov--drawer.xpb-ov--start{justify-content:flex-start}
    .xpb-ov--end{--xpb-from:100%}
    .xpb-ov--start{--xpb-from:-100%}
    [dir=rtl] .xpb-ov--end,.xpb-ov--end[dir=rtl]{--xpb-from:-100%}
    [dir=rtl] .xpb-ov--start,.xpb-ov--start[dir=rtl]{--xpb-from:100%}
    .xpb-ov--drawer .xpb-panel{width:min(var(--xpb-dw),100%);height:100%;transform:translateX(var(--xpb-from))}
    .xpb-ov--popup{align-items:flex-end;justify-content:center}
    .xpb-ov--popup .xpb-panel{width:100%;max-height:92vh;max-height:92dvh;border-radius:var(--xpb-radius) var(--xpb-radius) 0 0;transform:translateY(100%)}
    .xpb-ov.is-open .xpb-panel{transform:none;opacity:1}

    @media (min-width:750px){
      .xpb.xpb-ov.xpb-ov--popup{align-items:center;padding:24px}
      .xpb-ov--popup .xpb-panel{width:min(1040px,100%);max-height:90vh;border-radius:var(--xpb-radius);transform:translateY(24px);opacity:0}
    }
    /* Inside a drawer the panel is narrow, so keep the phone layout at any screen size. */
    .xpb-ov--drawer .xpb__wrap{padding:0 14px}
    .xpb-ov--drawer .xpb-grid{grid-template-columns:repeat(var(--xpb-cols-m),minmax(0,1fr));gap:10px}
    .xpb-ov--drawer .xpb-list{display:flex}
    .xpb-ov--drawer .xpb-scroller{display:flex;overflow-x:auto}
    .xpb-ov--drawer .xpb-slot{flex-basis:calc((100% - 16px)/3)}
    .xpb-ov--drawer .xpb-bar{margin:18px -14px 0;border:0;border-top:1px solid var(--xpb-accent);border-radius:0}
    .xpb-ov--drawer .xpb__cols--split{display:block}
