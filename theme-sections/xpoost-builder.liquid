    .xpb-ov--drawer .xpb-hero__img--d{display:none}
    .xpb-ov--drawer .xpb-hero__img--m{display:block}
    .xpb-ov--drawer .xpb-split{display:block}
    .xpb-ov--drawer .xpb-split .xpb-box{position:relative;top:auto}
    .xpb-ov--drawer .xpb-box__grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .xpb-ov .xpb-bar{bottom:0}


    /* ---------- v3: links, icons, quick view, glowing close, trigger ---------- */
    .xpb__main:empty{min-height:420px}
    .xpb-media__link{display:block;width:100%;height:100%}
    a.xpb-name{color:inherit;text-decoration:none}
    a.xpb-name:hover{text-decoration:underline;text-underline-offset:3px}
    html:not([dir=rtl]) .xpb-dir{transform:scaleX(-1)}
    .xpb-ico{display:block;flex:none}
    .xpb-dot .xpb-ico{width:22px;height:22px}
    .xpb-thumb--empty .xpb-ico{width:24px;height:24px;color:var(--xpb-accent)}
    .xpb-banner__ico{position:absolute;top:10px;inset-inline-end:12px;color:var(--xpb-accent);opacity:.55;pointer-events:none}
    .xpb-banner__ico svg{width:104px;height:104px}
    .xpb-acc__img.is-ico{background:var(--xpb-bg);color:var(--xpb-accent);border:1px solid var(--xpb-border)}
    .xpb-acc__img .xpb-ico{width:40px;height:40px}
    .xpb-bslot__art{display:flex;align-items:center;justify-content:center;width:64px;height:64px;border-radius:99px;background:rgba(255,255,255,.1);color:var(--xpb-accent);overflow:hidden}
    .xpb-bslot__art img{width:100%;height:100%;object-fit:cover}
    .xpb-bslot__art i{font-style:normal;font-size:28px;line-height:1;font-weight:400}
    .xpb-bslot--empty.is-on{border-color:var(--xpb-accent);border-style:solid}
    .xpb-tab__dot .xpb-ico{width:24px;height:24px}
    .xpb-desc{margin:0 0 12px;-webkit-line-clamp:4}
    .xpb-summary--wide{max-width:none}
    .xpb-bar__top,.xpb-bar__row{display:flex;align-items:center;gap:8px}
    .xpb-bar__row .xpb-btn{padding:0 14px;flex:none}
    .xpb-next{gap:6px}

    .xpb-qvbtn{position:absolute;bottom:8px;inset-inline-end:8px;z-index:2;width:38px;height:38px;padding:0;border-radius:99px;border:1px solid color-mix(in srgb,#fff 35%,var(--xpb-accent));background:linear-gradient(135deg,var(--xpb-accent),color-mix(in srgb,var(--xpb-accent) 65%,#000));color:var(--xpb-on-accent);display:flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;font-size:13px;font-weight:700;box-shadow:0 4px 12px rgba(0,0,0,.45),0 0 10px color-mix(in srgb,var(--xpb-accent) 45%,transparent)}
    .xpb-qvbtn span{display:none}
    .xpb-row .xpb-qvbtn,.xpb-slot .xpb-qvbtn{width:30px;height:30px;bottom:4px;inset-inline-end:4px}
    .xpb-qvbtn.m-spinner-loading{opacity:.75}
    @media (min-width:750px) and (hover:hover){
      .xpb-card .xpb-qvbtn{inset-inline:0;bottom:0;width:auto;height:40px;border-radius:0;border:0;transform:translateY(100%);opacity:0;transition:transform .3s cubic-bezier(.2,.7,.2,1),opacity .3s ease}
      .xpb-card:hover .xpb-qvbtn,.xpb-card .xpb-qvbtn:focus-visible{transform:none;opacity:1}
      .xpb-card .xpb-qvbtn span{display:inline}
    }

    .xpb-x{position:relative;flex:none;display:inline-flex;align-items:center;gap:6px;min-height:42px;padding:0 14px;border:0;border-radius:99px;background:var(--xpb-accent);color:var(--xpb-on-accent);font-size:14px;font-weight:700;cursor:pointer;box-shadow:0 0 0 3px color-mix(in srgb,var(--xpb-accent) 28%,transparent),0 0 18px color-mix(in srgb,var(--xpb-accent) 65%,transparent)}
