{%- comment -%}
  XPoost Builder: Bundle Builder + Kit Builder in one theme section.
  No app needed. Products, images, texts and colors are all set in the theme editor.
  Mode "Bundle": shoppers pick products from a list and add them to cart together.
  Mode "Kit": shoppers build a routine step by step (one block per step).
  Every line added to cart carries a hidden "_bundle" property so orders show which items came together.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign mode = s.mode
  if mode == 'bundle'
    assign layout = s.bundle_layout
  else
    assign layout = s.kit_layout
  endif
  assign has_hero = false
  if layout == 'hero_grid' or layout == 'slots_chips' or layout == 'accordion'
    assign has_hero = true
  endif
  assign split = false
  if layout == 'hero_grid' or layout == 'accordion'
    assign split = true
  endif
  assign overlay = s.hero_overlay | divided_by: 100.0
-%}

{%- capture xpb_vars -%}--xpb-accent:{{ s.accent }};--xpb-on-accent:{{ s.on_accent }};--xpb-bg:{{ s.bg }};--xpb-card:{{ s.card }};--xpb-tile:{{ s.tile }};--xpb-text:{{ s.text }};--xpb-muted:{{ s.muted }};--xpb-border:{{ s.border }};--xpb-bar:{{ s.bar }};--xpb-box:{{ s.box_bg }};--xpb-radius:{{ s.radius }}px;--xpb-btn-radius:{{ s.btn_radius }}px;--xpb-cols-m:{{ s.cols_mobile }};--xpb-cols-d:{{ s.cols_desktop }};--xpb-ratio:{{ s.image_ratio }};--xpb-fit:{{ s.image_fit }};--xpb-pt:{{ s.padding_top }}px;--xpb-pb:{{ s.padding_bottom }}px;--xpb-hsize:{{ s.heading_size }}px;--xpb-hero-h:{{ s.hero_height }}px;--xpb-overlay:{{ overlay }};--xpb-dw:{{ s.drawer_width }}px;{%- endcapture -%}

{%- capture xpb_content -%}
    {%- unless has_hero -%}
      <div class="xpb-intro">
        {%- if s.eyebrow != blank -%}<span class="xpb-pill">{{ s.eyebrow | escape }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="xpb-intro__title">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.show_bar -%}<span class="xpb-intro__bar" aria-hidden="true"></span>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="xpb-intro__sub">{{ s.subheading | escape }}</p>{%- endif -%}
      </div>
    {%- endunless -%}

    <div class="xpb__cols{% if split %} xpb__cols--split{% endif %}">
      {%- if has_hero -%}
        <div class="xpb-hero xpb-hero--{{ s.hero_align }}">
          {%- liquid
            assign dclass = 'xpb-hero__img'
            if s.hero_image_mobile != blank
              assign dclass = 'xpb-hero__img xpb-hero__img--d'
            endif
          -%}
          {%- if s.hero_image != blank -%}
            {{ s.hero_image | image_url: width: 1600 | image_tag: widths: '450, 750, 1100, 1600', sizes: '(min-width: 990px) 50vw, 100vw', class: dclass, loading: 'lazy', alt: s.heading }}
          {%- endif -%}
          {%- if s.hero_image_mobile != blank -%}
            {{ s.hero_image_mobile | image_url: width: 900 | image_tag: widths: '375, 600, 900', sizes: '100vw', class: 'xpb-hero__img xpb-hero__img--m', loading: 'lazy', alt: s.heading }}
          {%- endif -%}
          {%- if s.sparkles -%}
            <div class="xpb-spark" aria-hidden="true">
              {%- assign sp = '6,6,3;22,30,2;40,12,4;62,40,2;80,8,3;92,26,2;14,60,2;34,72,3;70,64,2;88,80,3;50,88,2;8,90,3;28,46,2;76,50,2' | split: ';' -%}
              {%- for d in sp -%}
                {%- assign a = d | split: ',' -%}
                <span style="left:{{ a[0] }}%;top:{{ a[1] }}%;width:{{ a[2] }}px;height:{{ a[2] }}px;animation-delay:{{ forloop.index | times: 0.37 | modulo: 3 }}s"></span>
              {%- endfor -%}
            </div>
          {%- endif -%}
          <div class="xpb-hero__content">
            {%- if s.eyebrow != blank -%}<span class="xpb-pill">{{ s.eyebrow | escape }}</span>{%- endif -%}
            {%- if s.heading != blank -%}<h2 class="xpb-hero__title">{{ s.heading | escape }}</h2>{%- endif -%}
            {%- if s.subheading != blank -%}<p class="xpb-hero__sub">{{ s.subheading | escape }}</p>{%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <div class="xpb__main" data-xpb-mount>
        {%- if request.design_mode -%}<p class="xpb-empty">XPoost Builder…</p>{%- endif -%}
      </div>
    </div>
{%- endcapture -%}

<section
  id="xpb-{{ section.id }}"
  class="xpb xpb--{{ mode }} xpb--{{ layout }} xpb--show-{{ s.display }}"
  style="{{ xpb_vars }}"
>
  {%- if s.display == 'inline' -%}
    <div class="xpb__wrap">{{ xpb_content }}</div>
  {%- else -%}
    {%- if s.show_trigger -%}
      <div class="xpb__wrap xpb-trig">
        <button
          type="button"
          class="xpb-tbtn xpb-tbtn--{{ s.trigger_style }}{% if s.trigger_full %} xpb-tbtn--block{% endif %}"
          style="--xpb-ts:{{ s.trigger_speed }}"
          data-xpb-open
          aria-haspopup="dialog"
          aria-controls="xpb-ov-{{ section.id }}"
        >
          <span class="xpb-tbtn__in">
            {%- case s.trigger_icon -%}
              {%- when 'sparkles' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.7 4.7 1.8-4.7 1.8L12 16l-1.8-4.7-4.7-1.8 4.7-1.8z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/><path d="M5 2.5l.6 1.4L7 4.5l-1.4.6L5 6.5l-.6-1.4L3 4.5l1.4-.6z"/></svg>
              {%- when 'gift' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v9h14v-9M12 8v13M12 8S10.5 3 8 4s0 4 4 4zM12 8s1.5-5 4-4 0 4-4 4z"/></svg>
              {%- when 'serum' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 2h2v5h-2z"/><path d="M9.5 7h5v2h-5z"/><rect x="8.5" y="9" width="7" height="12" rx="2"/><path d="M12 13v3"/></svg>
              {%- when 'box' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8l9-5 9 5v8l-9 5-9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>
              {%- when 'heart' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
              {%- when 'wand' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20L15 9"/><path d="M14 4v2M19 9h2M17.5 5.5L19 4"/><path d="M8 3l.5 1.5L10 5l-1.5.5L8 7l-.5-1.5L6 5l1.5-.5z"/></svg>
            {%- endcase -%}
            <span class="xpb-tbtn__txt">{{ s.trigger_label | escape }}</span>
          </span>
          {%- if s.trigger_style == 'sparkle' -%}
            <i class="xpb-star" aria-hidden="true"></i><i class="xpb-star" aria-hidden="true"></i><i class="xpb-star" aria-hidden="true"></i><i class="xpb-star" aria-hidden="true"></i><i class="xpb-star" aria-hidden="true"></i>
          {%- endif -%}
        </button>
        {%- if s.trigger_note != blank -%}<p class="xpb-tnote">{{ s.trigger_note | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div
      id="xpb-ov-{{ section.id }}"
      class="xpb xpb-ov xpb-ov--{{ s.display }} xpb-ov--{{ s.drawer_side }} xpb--{{ mode }} xpb--{{ layout }}"
      style="{{ xpb_vars }}"
      data-xpb-ov
      hidden
    >
      <div class="xpb-ov__bg" data-xpb-close></div>
      <div class="xpb-panel" role="dialog" aria-modal="true" aria-labelledby="xpb-ov-t-{{ section.id }}">
        <div class="xpb-panel__head">
          <h2 class="xpb-panel__title" id="xpb-ov-t-{{ section.id }}">{{ s.panel_title | default: s.heading | default: s.trigger_label | escape }}</h2>
          <button type="button" class="xpb-x xpb-panel__x" data-xpb-close>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            <span>{{ s.t_close | escape }}</span>
          </button>
        </div>
        <div class="xpb-panel__body">
          <div class="xpb__wrap">{{ xpb_content }}</div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <script type="application/json" data-xpb-config>
    {
      "mode": {{ mode | json }},
      "sid": {{ section.id | json }},
      "display": {{ s.display | json }},
      "anim": {{ s.animations | json }},
      "hash": {{ s.open_hash | strip | remove: '#' | json }},
      "layout": {{ layout | json }},
      "size": {{ s.bundle_size | json }},
      "min": {{ s.bundle_min | json }},
      "kitRule": {{ s.kit_rule | json }},
      "qv": {{ s.quick_view | json }},
      "imgClick": {{ s.image_click | json }},
      "money": {% if s.price_format == 'with_currency' %}{{ shop.money_with_currency_format | strip_html | json }}{% else %}{{ shop.money_format | strip_html | json }}{% endif %},
      "after": {{ s.after_add | json }},
      "cartUrl": {{ routes.cart_url | json }},
      "addUrl": {{ routes.cart_add_url | append: '.js' | json }},
      "rootUrl": {{ routes.root_url | json }},
      "name": {{ s.heading | default: 'Bundle' | json }},
      "current": {% if product %}{{ product.id }}{% else %}null{% endif %},
      "design": {{ request.design_mode | json }},
      "split": {{ s.split_title | json }},
      "subSource": {{ s.subtitle_source | json }},
      "boxImg": {% if s.box_image != blank %}{{ s.box_image | image_url: width: 1000 | json }}{% else %}null{% endif %},
      "ribbon": {{ s.box_ribbon | json }},
      "t": {
        "pick": {{ s.t_pick | json }},
        "progress": {{ s.t_progress | json }},
        "add": {{ s.t_add | json }},
        "remove": {{ s.t_remove | json }},
        "full": {{ s.t_full | json }},
        "more": {{ s.t_more | json }},
        "cta": {{ s.t_cta | json }},
        "cta_count": {{ s.t_cta_count | json }},
        "total": {{ s.t_total | json }},
        "all": {{ s.t_all | json }},
        "concerns": {{ s.t_concerns | json }},
        "slot": {{ s.t_slot | json }},
        "sold_out": {{ s.t_sold_out | json }},
        "this_item": {{ s.t_this_item | json }},
        "variant": {{ s.t_variant | json }},
        "step": {{ s.t_step | json }},
        "rule_exact": {{ s.t_rule_exact | json }},
        "rule_range": {{ s.t_rule_range | json }},
        "rule_up": {{ s.t_rule_up | json }},
        "optional": {{ s.t_optional | json }},
        "choose": {{ s.t_choose | json }},
        "chosen": {{ s.t_chosen | json }},
        "next": {{ s.t_next | json }},
        "skip": {{ s.t_skip | json }},
        "your_kit": {{ s.t_your_kit | json }},
        "not_yet": {{ s.t_not_yet | json }},
        "steps_done": {{ s.t_steps_done | json }},
        "steps_left": {{ s.t_steps_left | json }},
        "step_full": {{ s.t_step_full | json }},
        "in_box": {{ s.t_in_box | json }},
        "put": {{ s.t_put | json }},
        "in": {{ s.t_in | json }},
        "done": {{ s.t_done | json }},
        "adding": {{ s.t_adding | json }},
        "added": {{ s.t_added | json }},
        "error": {{ s.t_error | json }},
        "close": {{ s.t_close | json }},
        "quick_view": {{ s.t_quick_view | json }},
        "view_page": {{ s.t_view_page | json }},
        "pick_one": {{ s.t_pick_one | json }},
        "next_short": {{ s.t_next_short | json }}
      },
      "items": [
        {%- assign sep = '' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'item' and block.settings.product != blank -%}
            {%- assign p = block.settings.product -%}
            {%- unless s.hide_sold_out and p.available == false -%}
              {{ sep }}{"key":{{ block.id | json }},"label":{{ block.settings.label | json }},"concern":{{ block.settings.concern | strip | json }},"p":{"id":{{ p.id }},"h":{{ p.handle | json }},"title":{{ p.title | json }},"url":{{ p.url | json }},"v":{{ p.vendor | json }},"ty":{{ p.type | json }},"available":{{ p.available | json }},"img":{% if p.featured_image %}{{ p.featured_image | image_url: width: 400 | json }},"img2":{{ p.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %},"variants":[{%- for v in p.variants limit: 50 -%}{"id":{{ v.id }},"title":{{ v.title | json }},"price":{{ v.price | json }},"available":{{ v.available | json }},"img":{% if v.featured_image %}{{ v.featured_image | image_url: width: 400 | json }},"img2":{{ v.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}}
              {%- assign sep = ',' -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      ],
      "steps": [
        {%- assign ssep = '' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {{ ssep }}{"key":{{ block.id | json }},"label":{{ block.settings.label | json }},"title":{{ block.settings.title | json }},"desc":{{ block.settings.description | json }},"img":{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | json }}{% else %}null{% endif %},"icon":{{ block.settings.icon | json }},"min":{{ block.settings.min_picks | json }},"max":{{ block.settings.max_picks | json }},"products":[
              {%- assign psep = '' -%}
              {%- for p in block.settings.products -%}
                {%- unless s.hide_sold_out and p.available == false -%}
                  {{ psep }}{"id":{{ p.id }},"h":{{ p.handle | json }},"title":{{ p.title | json }},"url":{{ p.url | json }},"v":{{ p.vendor | json }},"ty":{{ p.type | json }},"available":{{ p.available | json }},"img":{% if p.featured_image %}{{ p.featured_image | image_url: width: 400 | json }},"img2":{{ p.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %},"variants":[{%- for v in p.variants limit: 50 -%}{"id":{{ v.id }},"title":{{ v.title | json }},"price":{{ v.price | json }},"available":{{ v.available | json }},"img":{% if v.featured_image %}{{ v.featured_image | image_url: width: 400 | json }},"img2":{{ v.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}
                  {%- assign psep = ',' -%}
                {%- endunless -%}
              {%- endfor -%}
            ]}
            {%- assign ssep = ',' -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>

  <style>
    .xpb{position:relative;background:var(--xpb-bg);color:var(--xpb-text);padding:var(--xpb-pt) 0 var(--xpb-pb);font-family:inherit;line-height:1.5}
    .xpb *,.xpb *::before,.xpb *::after{box-sizing:border-box}
    .xpb__wrap{max-width:1200px;margin:0 auto;padding:0 14px}
    .xpb img{display:block;max-width:100%}
    .xpb button,.xpb select,.xpb input{font-family:inherit}
    .xpb button:focus-visible,.xpb select:focus-visible,.xpb input:focus-visible{outline:2px solid var(--xpb-accent);outline-offset:2px}
    .xpb-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
    .xpb-empty{text-align:center;color:var(--xpb-muted);padding:24px;border:1px dashed var(--xpb-border);border-radius:var(--xpb-radius)}

    .xpb-pill{display:inline-block;background:var(--xpb-accent);color:var(--xpb-on-accent);font-size:12px;font-weight:700;padding:5px 12px;border-radius:99px}
    .xpb-intro{display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;margin-bottom:22px}
    .xpb-intro__title{margin:0;color:var(--xpb-accent);font-size:var(--xpb-hsize);line-height:1.3;font-weight:600}
    .xpb-intro__bar{width:140px;height:2px;background:var(--xpb-text)}
    .xpb-intro__sub{margin:4px 0 0;color:var(--xpb-muted);font-size:15px;line-height:1.6;max-width:560px}

    .xpb-hero{position:relative;min-height:var(--xpb-hero-h);border-radius:var(--xpb-radius);overflow:hidden;display:flex;align-items:flex-end;background:radial-gradient(circle at 50% 40%,color-mix(in srgb,var(--xpb-accent) 28%,var(--xpb-bg)) 0%,var(--xpb-bg) 75%);margin-bottom:18px}
    .xpb-hero__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .xpb-hero__img--d{display:none}
    .xpb-hero__content{position:relative;width:100%;padding:64px 18px 22px;background:linear-gradient(to top,rgba(0,0,0,var(--xpb-overlay)),rgba(0,0,0,0));display:flex;flex-direction:column;gap:8px;align-items:center;text-align:center}
    .xpb-hero--start .xpb-hero__content{align-items:flex-start;text-align:start}
    .xpb-hero__title{margin:0;color:#fff;font-size:var(--xpb-hsize);line-height:1.3;font-weight:700}
    .xpb-hero__sub{margin:0;color:#e6e6e6;font-size:15px;line-height:1.6;max-width:520px}
    .xpb-spark span{position:absolute;border-radius:99px;background:var(--xpb-accent);box-shadow:0 0 8px var(--xpb-accent);opacity:.8;animation:xpb-tw 3s ease-in-out infinite;pointer-events:none}
    @keyframes xpb-tw{0%,100%{opacity:.25}50%{opacity:.95}}

    .xpb-head{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:8px}
    .xpb-head__title{font-size:17px;font-weight:700}
    .xpb-head__count{font-size:14px;font-weight:700;color:var(--xpb-accent)}
    .xpb-progress{height:6px;background:var(--xpb-card);border-radius:99px;overflow:hidden;margin-bottom:16px}
    .xpb-progress span{display:block;height:100%;background:var(--xpb-accent);border-radius:99px;transition:width .25s}

    .xpb-grid{display:grid;grid-template-columns:repeat(var(--xpb-cols-m),minmax(0,1fr));gap:10px}
    .xpb-card{background:var(--xpb-card);border-radius:var(--xpb-radius);padding:8px;display:flex;flex-direction:column;gap:10px;border:2px solid var(--xpb-card)}
    .xpb-card.is-on{border-color:var(--xpb-accent)}
    .xpb-media{position:relative;aspect-ratio:var(--xpb-ratio);background:var(--xpb-tile);border-radius:max(0px,calc(var(--xpb-radius) - 4px));overflow:hidden;display:flex;align-items:center;justify-content:center}
    .xpb-media img{width:100%;height:100%;object-fit:var(--xpb-fit)}
    .xpb-media--wide{aspect-ratio:16/10}
    .xpb-media--wide img{object-fit:contain}
    .xpb-ph{width:34%;height:34%;color:var(--xpb-muted)}
    .xpb-tick{position:absolute;top:8px;inset-inline-end:8px;width:28px;height:28px;border-radius:99px;background:var(--xpb-accent);color:var(--xpb-on-accent);display:flex;align-items:center;justify-content:center}
    .xpb-soldout{position:absolute;bottom:8px;inset-inline-start:8px;background:#121111;color:#fff;font-size:12px;font-weight:700;padding:4px 10px;border-radius:99px}
    .xpb-tag{position:absolute;top:10px;inset-inline-start:10px;background:#121111;color:#fff;font-size:12px;font-weight:700;padding:5px 10px;border-radius:99px}
    .xpb-tag--accent{inset-inline-start:auto;inset-inline-end:10px;background:var(--xpb-accent);color:var(--xpb-on-accent)}
    .xpb-info{padding:0 4px;display:flex;flex-direction:column;gap:3px;flex:1;min-width:0}
    .xpb-name{font-size:14px;font-weight:700;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .xpb-sub{font-size:12.5px;line-height:1.5;color:var(--xpb-muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .xpb-price{font-size:15px;font-weight:700;unicode-bidi:plaintext}
    .xpb-select{width:100%;min-height:42px;background:var(--xpb-bg);color:var(--xpb-text);border:1px solid var(--xpb-border);border-radius:var(--xpb-btn-radius);padding:0 10px;font-size:14px}

    .xpb-btn{min-height:44px;padding:0 16px;border-radius:var(--xpb-btn-radius);border:1px solid transparent;font-size:15px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;text-align:center;line-height:1.2}
    .xpb-btn--block{width:100%}
    .xpb-btn--primary{background:var(--xpb-accent);color:var(--xpb-on-accent)}
    .xpb-btn--ghost{background:transparent;color:var(--xpb-text);border-color:var(--xpb-border)}
    .xpb-btn--outline{background:transparent;color:var(--xpb-accent);border-color:var(--xpb-accent)}
    .xpb-btn--dashed{background:transparent;color:var(--xpb-text);border:1px dashed var(--xpb-border);font-weight:600}
    .xpb-btn[disabled]{background:var(--xpb-border);color:var(--xpb-text);border-color:transparent;cursor:not-allowed}
    .xpb-btn--lg{min-height:52px;font-size:16px}
    .xpb-round{width:44px;height:44px;flex:none;border-radius:99px;border:0;background:var(--xpb-accent);color:var(--xpb-on-accent);display:flex;align-items:center;justify-content:center;cursor:pointer}
    .xpb-round.is-on{background:transparent;color:var(--xpb-accent);border:2px solid var(--xpb-accent)}
    .xpb-round[disabled]{background:var(--xpb-border);color:var(--xpb-text);cursor:not-allowed}

    .xpb-bar{position:sticky;bottom:0;z-index:5;margin:18px -14px 0;background:var(--xpb-bar);border-top:1px solid var(--xpb-accent);padding:12px 14px calc(14px + env(safe-area-inset-bottom));display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    .xpb-bar--col{flex-direction:column;align-items:stretch}
    .xpb-bar__label{font-size:14px;font-weight:700;flex:1}
    .xpb-tray{display:flex;gap:6px;flex-wrap:nowrap}
    .xpb-thumb{width:40px;height:40px;border-radius:10px;overflow:hidden;background:var(--xpb-tile);border:1px solid var(--xpb-accent);flex:none;display:flex;align-items:center;justify-content:center}
    .xpb-thumb img{width:100%;height:100%;object-fit:cover}
    .xpb-thumb--empty{background:transparent;border:1.5px dashed var(--xpb-border);color:var(--xpb-muted);font-size:14px}
    .xpb-total{flex:1;display:flex;flex-direction:column;gap:1px;min-width:90px}
    .xpb-total__label{font-size:12px;color:var(--xpb-muted)}
    .xpb-total__value{font-size:18px;font-weight:700;unicode-bidi:plaintext;white-space:nowrap}
    .xpb-row-between{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
    .xpb-msg{width:100%;margin:0;font-size:14px;font-weight:700;color:var(--xpb-accent)}
    .xpb-msg--err{color:#ff8a80}

    .xpb-slots{display:flex;gap:8px;overflow-x:auto;padding:8px 8px 4px;margin:0 -8px 4px;scrollbar-width:none}
    .xpb-slots::-webkit-scrollbar,.xpb-chips::-webkit-scrollbar,.xpb-tabs::-webkit-scrollbar,.xpb-scroller::-webkit-scrollbar{display:none}
    .xpb-slot{position:relative;flex:0 0 calc((100% - 16px)/3);background:var(--xpb-card);border:2px solid var(--xpb-accent);border-radius:var(--xpb-radius);padding:6px;display:flex;flex-direction:column;gap:6px}
    .xpb-slot .xpb-media{aspect-ratio:1/1}
    .xpb-slot .xpb-name{font-size:11.5px}
    .xpb-slot__x{position:absolute;top:-8px;inset-inline-start:-8px;width:28px;height:28px;border-radius:99px;border:0;background:#fff;color:#121111;display:flex;align-items:center;justify-content:center;cursor:pointer}
    .xpb-slot--empty{border:1.5px dashed var(--xpb-border);background:transparent;align-items:center;justify-content:center;min-height:120px;color:var(--xpb-muted);font-size:13px}
    .xpb-slot--empty b{width:40px;height:40px;border-radius:99px;background:var(--xpb-card);color:var(--xpb-accent);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:400}
    .xpb-subhead{display:flex;flex-direction:column;align-items:center;gap:8px;margin:20px 0 12px}
