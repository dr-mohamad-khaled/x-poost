{%- comment -%}
  XPoost Hero Cards
  Looping product cards for the top of the home page.
  - Moves on its own (smooth glide or one card at a time), pauses while touched / hovered,
    and resumes a few seconds after the shopper lets go. Drag and swipe supported.
  - Every card: gradient colors, custom or product image, short description, quick view button.
  - Quick view opens the same popup used by the other XPoost sections (images, description, options, add to cart).
  - Follows the page direction automatically: RTL on Arabic pages, LTR on English pages.
  - Speed: all cards are rendered by the server with fixed sizes (no layout shift). Motion uses one
    transform on one layer, runs only while the section is on screen, and stops when idle.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign cards = section.blocks | where: 'type', 'card'
  assign trusts = section.blocks | where: 'type', 'trust'
  assign show_dots = false
  if s.mode == 'slide' and cards.size > 1 and s.show_dots
    assign show_dots = true
  endif
-%}

<style>
  #xph-{{ sid }}{
    --gap:{{ s.gap }}px;--r:{{ s.radius }}px;--pad:16px;
    --cw:min({{ s.cw_m }}vw,440px);--ch:{{ s.ch_m }}px;--ts:{{ s.title_m }}px;
    --xpc-accent:{{ s.qv_accent }};--xpc-on-accent:{{ s.qv_on_accent }};--xpc-bg:{{ s.qv_bg }};--xpc-card:{{ s.qv_card }};--xpc-tile:{{ s.qv_tile }};--xpc-text:{{ s.qv_text }};--xpc-muted:{{ s.qv_muted }};--xpc-border:{{ s.qv_border }};--xpc-sale:{{ s.qv_sale }};
    position:relative;background:{{ s.bg }};padding:{{ s.pad_t }}px 0 {{ s.pad_b }}px;overflow:hidden;
  }
  @media (min-width:750px){ #xph-{{ sid }}{--cw:{{ s.cw_d }}px;--ch:{{ s.ch_d }}px;--ts:{{ s.title_d }}px;--pad:max(24px,calc((100vw - {{ s.max_w }}px) / 2))} }
</style>

{%- comment -%} Static CSS (identical for every instance) {%- endcomment -%}
<style>
  .xph *,.xph *::before,.xph *::after{box-sizing:border-box}
  .xph__vp{position:relative;overflow:hidden;touch-action:pan-y;-webkit-user-select:none;user-select:none;cursor:grab}
  .xph__vp.is-drag{cursor:grabbing}
  .xph__vp img{-webkit-user-drag:none;pointer-events:none}
  .xph__track{display:flex;gap:var(--gap);padding-inline:var(--pad);width:max-content;will-change:transform;transform:translate3d(0,0,0)}
  .xph-card{position:relative;flex:0 0 var(--cw);width:var(--cw);height:var(--ch);display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,.88fr);border-radius:var(--r);overflow:hidden;color:var(--tx);background:linear-gradient(var(--ang),var(--c1),var(--c2));contain:layout paint;-webkit-tap-highlight-color:transparent;transition:transform .25s ease}
  .xph-card::before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(120% 80% at 85% 0%,rgba(255,255,255,.38),transparent 55%),radial-gradient(90% 70% at 0% 100%,rgba(0,0,0,.16),transparent 60%)}
  [dir=rtl] .xph-card::before,.xph[dir=rtl] .xph-card::before{background:radial-gradient(120% 80% at 15% 0%,rgba(255,255,255,.38),transparent 55%),radial-gradient(90% 70% at 100% 100%,rgba(0,0,0,.16),transparent 60%)}
  .xph-card:active{transform:scale(.985)}
  .xph-card.is-link{cursor:pointer}
  .xph-card__txt{position:relative;z-index:2;display:flex;flex-direction:column;align-items:flex-start;gap:6px;min-width:0;padding:18px 0 16px;padding-inline:18px 6px}
  .xph-brand{font-size:13px;font-weight:700;letter-spacing:.02em;opacity:.92;line-height:1.2}
  .xph-title{margin:0;font-size:var(--ts);font-weight:800;line-height:1.15;color:inherit;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;text-wrap:balance}
  .xph-desc{margin:0;font-size:12.5px;line-height:1.45;opacity:.9;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .xph-price{display:flex;flex-wrap:wrap;align-items:baseline;gap:0 8px;font-size:15px;font-weight:800;unicode-bidi:plaintext}
  .xph-price span,.xph-price s{white-space:nowrap}
  .xph-price s{font-size:12px;font-weight:500;opacity:.75}
  .xph-cta{position:relative;margin-top:auto;display:inline-flex;align-items:center;gap:8px;min-height:40px;max-width:100%;padding:0 16px;border-radius:99px;border:0;background:var(--cta);color:var(--cta-tx);font:inherit;font-size:13px;font-weight:800;cursor:pointer;overflow:hidden;white-space:nowrap;box-shadow:0 6px 18px -8px rgba(0,0,0,.45);text-decoration:none}
  .xph-cta b{font-weight:900}
  .xph-cta i{width:1px;height:14px;background:currentColor;opacity:.35}
  .xph-cta svg{width:16px;height:16px;flex:none}
  .xph-cta span{overflow:hidden;text-overflow:ellipsis}
  .xph-badge{position:absolute;z-index:3;top:12px;inset-inline-end:12px;padding:4px 10px;border-radius:99px;background:#111;color:#fff;font-size:11px;font-weight:800;letter-spacing:.03em;line-height:1.3}
  .xph-card__media{position:relative;z-index:1;display:flex;align-items:flex-end;justify-content:center;min-width:0;padding:14px 12px 16px}
  .xph-card__media img,.xph-card__media svg{display:block;max-width:100%;max-height:100%;width:100%;height:auto}
  .xph-card__media::after{content:"";position:absolute;z-index:-1;left:18%;right:18%;bottom:10px;height:16px;border-radius:50%;background:rgba(0,0,0,.28);opacity:.55;transform:scaleY(.6)}
  .xph-card--framed .xph-card__media{align-items:center}
  .xph-card--framed .xph-card__media img{aspect-ratio:1/1;object-fit:contain;background:#fff;border-radius:16px;padding:6%;box-shadow:0 14px 30px -12px rgba(0,0,0,.45);--rot:-4deg;transform:rotate(var(--rot))}
  .xph-card--framed .xph-card__media::after{display:none}
  .xph-card--cutout .xph-card__media img{object-fit:contain;max-height:calc(var(--ch) - 30px);width:auto}
  .xph-card--cover .xph-card__media{padding:0}
  .xph-card--cover .xph-card__media img{position:absolute;inset:0;width:100%;height:100%;max-height:none;object-fit:cover}
  .xph-card--cover .xph-card__media::after{display:none}
  .xph-ph{width:100%;height:100%;opacity:.35;fill:currentColor}
  .xph__ctrl{position:absolute;z-index:4;top:8px;inset-inline-end:8px;width:30px;height:30px;padding:0;border-radius:50%;border:0;background:rgba(0,0,0,.45);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer}
  .xph__ctrl svg{width:14px;height:14px}
  .xph__arr{position:absolute;z-index:4;top:50%;width:44px;height:44px;margin-top:-22px;padding:0;border-radius:50%;border:0;background:rgba(255,255,255,.92);color:#111;display:none;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 6px 18px rgba(0,0,0,.3);opacity:0;transition:opacity .25s ease}
  .xph__vp:hover .xph__arr,.xph__arr:focus-visible{opacity:1}
  .xph__arr svg{width:18px;height:18px}
  .xph__arr--prev{inset-inline-start:12px}
  .xph__arr--next{inset-inline-end:12px}
  [dir=rtl] .xph__arr svg,.xph[dir=rtl] .xph__arr svg{transform:scaleX(-1)}
  @media (min-width:750px) and (hover:hover){ .xph__arr{display:flex} }
  .xph__dots{display:flex;justify-content:center;gap:7px;height:8px;margin-top:12px}
  .xph__dots button{width:8px;height:8px;padding:0;border:0;border-radius:99px;background:var(--dot);opacity:.35;cursor:pointer;transition:width .3s ease,opacity .3s ease}
  .xph__dots button[aria-current=true]{width:24px;opacity:1}
  .xph-trust{list-style:none;margin:0;padding:14px var(--pad) 0;display:flex;flex-wrap:wrap;justify-content:center;gap:10px 28px}
  .xph-trust li{display:flex;align-items:center;gap:9px;min-width:0;font-size:var(--tr-fs);font-weight:600;color:var(--tr-tx);line-height:1.3}
  .xph-trust svg,.xph-trust img{width:var(--tr-ic);height:var(--tr-ic);flex:none;color:var(--tr-icc);object-fit:contain}
  @media (max-width:749px){ .xph-cta{padding:0 13px;gap:6px;font-size:12.5px} .xph-cta b ~ span ~ svg{display:none} .xph-trust{gap:8px 14px;flex-wrap:nowrap;justify-content:space-around} .xph-trust li{gap:5px;font-size:max(11px,calc(var(--tr-fs) - 3px))} .xph-trust svg,.xph-trust img{width:calc(var(--tr-ic) * .8);height:calc(var(--tr-ic) * .8)} }

  /* Motion (transform / opacity only). Paused when the section is off screen. */
  @media (prefers-reduced-motion:no-preference){
    .xph.xph-fx .xph-card:not(.is-clone) .xph-card__txt > *{animation:xph-in .7s cubic-bezier(.2,.75,.2,1) backwards;animation-delay:calc(var(--k,0) * 90ms + var(--d,0ms))}
    .xph.xph-fx .xph-card:not(.is-clone) .xph-card__media{animation:xph-pop .9s cubic-bezier(.2,.75,.2,1) backwards;animation-delay:calc(var(--d,0ms) + 120ms)}
    .xph.xph-fx .xph-card__media img{animation:xph-float 6s ease-in-out infinite;animation-delay:calc(var(--i,0) * -1.3s)}
    .xph.xph-fx .xph-card--cover .xph-card__media img{animation:none}
    .xph.xph-fx .xph-cta::after{content:"";position:absolute;top:0;bottom:0;left:0;width:40%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent);transform:translateX(-120%) skewX(-18deg);animation:xph-shine 4.5s ease-in-out infinite;animation-delay:calc(var(--i,0) * .6s + 1.5s);pointer-events:none}
    .xph.xph-fx .xph-trust li{animation:xph-in .6s cubic-bezier(.2,.75,.2,1) backwards;animation-delay:calc(var(--k,0) * 100ms + 500ms)}
    .xph:not(.is-vis) *,.xph:not(.is-vis) *::after{animation-play-state:paused !important}
  }
  @keyframes xph-in{from{opacity:.01;transform:translateY(14px)}to{opacity:1;transform:none}}
  @keyframes xph-pop{from{opacity:.01;transform:translateY(24px) scale(.9)}to{opacity:1;transform:none}}
  @keyframes xph-float{0%,100%{transform:translateY(0) rotate(var(--rot,0deg))}50%{transform:translateY(-7px) rotate(var(--rot,0deg))}}
  @keyframes xph-shine{0%,55%{transform:translateX(-120%) skewX(-18deg)}100%{transform:translateX(320%) skewX(-18deg)}}

  /* ---------- Quick view (same look as the other XPoost popups) ---------- */
  html.xpc-lock{overflow:hidden}
  html.xpc-lock .firefly-canvas{display:none !important}
  html.xpc-lock #MainContent *,html.xpc-lock #MainContent *::before,html.xpc-lock #MainContent *::after{animation-play-state:paused !important}
  .xpq.xph-q{position:fixed;inset:0;z-index:2147483000;display:flex;align-items:flex-end;justify-content:center;font-family:inherit;line-height:1.5;color:var(--xpc-text)}
  .xpq.xph-q[hidden]{display:none}
  .xph-q *,.xph-q *::before,.xph-q *::after{box-sizing:border-box}
  .xph-q button,.xph-q select{font-family:inherit}
  .xph-q img{display:block;max-width:100%}
  .xph-q :focus-visible{outline:2px solid var(--xpc-accent);outline-offset:2px}
  .xph-q .xpq__bg{position:absolute;inset:0;background:rgba(0,0,0,.72);opacity:0;transition:opacity .25s ease}
  .xph-q.is-open .xpq__bg{opacity:1}
  .xph-q .xpq__panel{position:relative;width:100%;height:88vh;height:88dvh;display:flex;flex-direction:column;background:var(--xpc-bg);border-radius:20px 20px 0 0;overflow:hidden;transform:translateY(100%);will-change:transform;transition:transform .32s cubic-bezier(.2,.8,.2,1)}
  .xph-q.is-open .xpq__panel{transform:none}
  .xph-q .xpc__x{position:absolute;top:12px;inset-inline-end:14px;z-index:5;display:inline-flex;align-items:center;gap:6px;min-height:42px;padding:0 14px;border:0;border-radius:99px;background:var(--xpc-accent);color:var(--xpc-on-accent);font-size:14px;font-weight:700;cursor:pointer;box-shadow:0 0 0 3px color-mix(in srgb,var(--xpc-accent) 28%,transparent),0 0 18px color-mix(in srgb,var(--xpc-accent) 65%,transparent)}
  .xph-q .xpc__x::after{content:"";position:absolute;inset:0;border-radius:inherit;border:2px solid var(--xpc-accent);opacity:0;pointer-events:none;animation:xpcRing 2s ease-out infinite}
  .xph-q .xpc__x svg{width:16px;height:16px}
  .xph-q .xpq__body{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
  .xph-q .xpq__gallery{background:var(--xpc-tile)}
  .xph-q .xpq__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain}
  .xph-q .xpq__track::-webkit-scrollbar,.xph-q .xpq__thumbs::-webkit-scrollbar{display:none}
  .xph-q .xpq__track img{flex:0 0 100%;width:100%;height:auto;aspect-ratio:1/1;object-fit:contain;scroll-snap-align:start;background:var(--xpc-tile)}
  .xph-q .xpq__thumbs{display:flex;gap:6px;padding:8px;overflow-x:auto;background:var(--xpc-bg);scrollbar-width:none}
  .xph-q .xpq__thumbs button{flex:none;width:52px;height:52px;padding:0;border:1px solid var(--xpc-border);border-radius:8px;overflow:hidden;background:var(--xpc-tile);cursor:pointer}
  .xph-q .xpq__thumbs button.is-on{border-color:var(--xpc-accent)}
  .xph-q .xpq__thumbs img{width:100%;height:100%;object-fit:cover}
  .xph-q .xpq__info{padding:16px 16px calc(20px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:12px}
  .xph-q .xpq__brand{font-size:12px;font-weight:700;letter-spacing:.06em;color:var(--xpc-accent);text-transform:uppercase;margin-bottom:-8px}
  .xph-q .xpq__title{margin:0;font-size:20px;font-weight:700;line-height:1.35;color:var(--xpc-text)}
  .xph-q .xpq__price{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 10px;margin:0;font-size:20px;font-weight:700;color:var(--xpc-accent);unicode-bidi:plaintext}
  .xph-q .xpq__price s{color:var(--xpc-muted);font-size:14px;font-weight:500}
  .xph-q .xpq__price.is-sale > span:first-child{color:var(--xpc-sale)}
  .xph-q .xpq__var{display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--xpc-muted)}
  .xph-q .xpq__var select{width:100%;min-height:46px;padding:0 12px;border-radius:8px;border:1px solid var(--xpc-border);background:var(--xpc-card);color:var(--xpc-text);font-size:15px}
  .xph-q .xpc-add{position:relative;margin:0;min-height:50px;border:0;border-radius:8px;background:var(--xpc-accent);color:var(--xpc-on-accent);font-size:16px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;overflow:hidden;transition:background-color .2s ease,transform .15s ease}
  .xph-q .xpc-add[disabled]{background:var(--xpc-border);color:var(--xpc-text);cursor:not-allowed}
  .xph-q .xpc-add:not([disabled]):active{transform:scale(.97)}
  .xph-q .xpc-add svg{width:16px;height:16px;flex:none}
  .xph-q .xpc-add.is-busy svg{animation:xpcSpin .8s linear infinite;will-change:transform}
  .xph-q .xpc-add.is-done{background:#2f7d4f;color:#fff}
  .xph-q .xpc-add.is-done svg{animation:xpcPop .45s cubic-bezier(.3,1.5,.5,1) both}
  .xph-q .xpq__page{display:flex;align-items:center;justify-content:center;min-height:46px;border-radius:8px;border:1px solid var(--xpc-accent);color:var(--xpc-accent);font-weight:700;text-decoration:none;font-size:14.5px}
  .xph-q .xpq__desc{font-size:14px;line-height:1.7;color:var(--xpc-text);border-top:1px solid var(--xpc-border);padding-top:12px;overflow-wrap:anywhere}
  .xph-q .xpq__desc img{max-width:100%;height:auto}
  .xph-q .xpq__desc a{color:var(--xpc-accent)}
  .xph-q .xpq__skel{display:block;height:12px;border-radius:6px;background:var(--xpc-card);margin:8px 0}
  .xph-q .xpq__skel--s{width:60%}
  .xph-q.is-open .xpq__skel{animation:xpcBlink .9s ease-in-out infinite alternate}
  @keyframes xpcBlink{from{opacity:.4}to{opacity:1}}
  @keyframes xpcSpin{to{transform:rotate(360deg)}}
  @keyframes xpcPop{0%{transform:scale(.3)}60%{transform:scale(1.2)}100%{transform:scale(1)}}
  @keyframes xpcRing{0%{opacity:.8;transform:scale(1)}100%{opacity:0;transform:scale(1.35,1.7)}}
  @media (min-width:750px){
    .xpq.xph-q{align-items:center;padding:24px}
    .xph-q .xpq__panel{width:min(920px,100%);height:min(88vh,680px);border-radius:20px;opacity:0;transform:translateY(20px) scale(.98);transition:transform .3s cubic-bezier(.2,.8,.2,1),opacity .25s ease}
    .xph-q.is-open .xpq__panel{opacity:1;transform:none}
    .xph-q .xpq__body{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);align-items:start}
    .xph-q .xpq__gallery{position:sticky;top:0}
    .xph-q .xpq__info{padding-top:72px}
  }
  @media (prefers-reduced-motion:reduce){ .xph-q *,.xph-q *::before,.xph-q *::after{animation:none !important;transition:none !important} }
</style>

<section
  id="xph-{{ sid }}"
  class="xph xph-fx"
  aria-roledescription="carousel"
  aria-label="{{ s.aria_label | escape }}"
  style="--dot:{{ s.dot_color }};--tr-tx:{{ s.trust_text }};--tr-icc:{{ s.trust_icon }};--tr-fs:{{ s.trust_size }}px;--tr-ic:{{ s.trust_icon_size }}px;"
>
  <div class="xph__vp">
    <div class="xph__track">
      {%- for block in cards -%}
        {%- liquid
          assign b = block.settings
          assign p = b.product
          assign v = p.selected_or_first_available_variant
          assign img = b.image | default: p.featured_image
          assign brand = b.brand | default: p.vendor
          assign title = b.title | default: p.title | default: 'اسم المنتج'
          assign off = 0
          if v.compare_at_price > v.price
            assign off = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price | floor
          endif
          assign eager = false
          if forloop.first and s.is_first
            assign eager = true
          endif
          assign is_link = false
          if p != blank and s.card_click == 'quickview'
            assign is_link = true
          elsif p == blank and b.link != blank
            assign is_link = true
          endif
        -%}
        <article
          class="xph-card xph-card--{{ b.image_style }}{% if is_link %} is-link{% endif %}"
          data-i="{{ forloop.index0 }}"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} / {{ forloop.length }}"
          style="--c1:{{ b.c1 }};--c2:{{ b.c2 }};--ang:{{ b.angle }}deg;--tx:{{ b.text_color }};--cta:{{ b.cta_bg }};--cta-tx:{{ b.cta_text }};--i:{{ forloop.index0 }};--d:{{ forloop.index0 | times: 120 }}ms;"
          {{ block.shopify_attributes }}
        >
          {%- if b.badge != blank -%}<span class="xph-badge">{{ b.badge }}</span>{%- endif -%}
          <div class="xph-card__txt">
            {%- if brand != blank -%}<span class="xph-brand" style="--k:0">{{ brand }}</span>{%- endif -%}
            <h3 class="xph-title" style="--k:1">{{ title }}</h3>
            {%- if b.text != blank -%}<p class="xph-desc" style="--k:2">{{ b.text }}</p>{%- endif -%}
            {%- if s.show_price and p != blank -%}
              <div class="xph-price" style="--k:3">
                <span>{% if p.price_varies %}{{ s.t_from }} {% endif %}{% if s.price_format == 'with_currency' %}{{ v.price | money_with_currency }}{% else %}{{ v.price | money }}{% endif %}</span>
                {%- if v.compare_at_price > v.price -%}<s>{% if s.price_format == 'with_currency' %}{{ v.compare_at_price | money_with_currency }}{% else %}{{ v.compare_at_price | money }}{% endif %}</s>{%- endif -%}
              </div>
            {%- endif -%}
            {%- capture cta_inner -%}
              {%- if off > 0 and b.show_discount -%}<b>-{{ off }}%</b><i></i>{%- endif -%}
              <span>{{ b.cta | default: s.t_quick_view }}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            {%- endcapture -%}
            {%- if p != blank -%}
              <button type="button" class="xph-cta" style="--k:4" data-xph-qv="{{ forloop.index0 }}" aria-haspopup="dialog" aria-label="{{ b.cta | default: s.t_quick_view | escape }}: {{ title | escape }}">{{ cta_inner }}</button>
            {%- elsif b.link != blank -%}
              <a class="xph-cta" style="--k:4" href="{{ b.link }}">{{ cta_inner }}</a>
            {%- else -%}
              <span class="xph-cta" style="--k:4">{{ cta_inner }}</span>
            {%- endif -%}
          </div>
          <div class="xph-card__media">
            {%- if img != blank -%}
              {%- if eager -%}
                {{ img | image_url: width: 640 | image_tag: widths: '240, 320, 480, 640', sizes: '(min-width: 750px) 300px, 42vw', loading: 'eager', fetchpriority: 'high', alt: title }}
              {%- else -%}
                {{ img | image_url: width: 640 | image_tag: widths: '240, 320, 480, 640', sizes: '(min-width: 750px) 300px, 42vw', loading: 'lazy', alt: title }}
              {%- endif -%}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'xph-ph' }}
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if cards.size > 1 -%}
      {%- if s.show_arrows -%}
        <button type="button" class="xph__arr xph__arr--prev" data-xph="prev" aria-label="{{ s.t_prev | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
        <button type="button" class="xph__arr xph__arr--next" data-xph="next" aria-label="{{ s.t_next | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
      {%- endif -%}
      {%- if s.show_pause -%}
        <button type="button" class="xph__ctrl" data-xph="pause" aria-pressed="false" aria-label="{{ s.t_pause | escape }}" data-l-pause="{{ s.t_pause | escape }}" data-l-play="{{ s.t_play | escape }}"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z"/></svg></button>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- if show_dots -%}
    <div class="xph__dots">
      {%- for block in cards -%}<button type="button" data-xph="dot" data-i="{{ forloop.index0 }}" aria-label="{{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{%- endfor -%}
    </div>
  {%- endif -%}

  {%- if trusts.size > 0 -%}
    <ul class="xph-trust">
      {%- for block in trusts -%}
        <li style="--k:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 80 | image_tag: loading: 'lazy', width: 40, height: 40, alt: '' }}
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>
                {%- when 'plane' -%}<path d="M3 12l18-8-5 17-4-7z"/><path d="M12 14l9-10"/>
                {%- when 'return' -%}<path d="M4 12a8 8 0 0 1 14-5l2 2"/><path d="M20 4v5h-5"/><path d="M20 12a8 8 0 0 1-14 5l-2-2"/><path d="M4 20v-5h5"/>
                {%- when 'truck' -%}<path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/>
                {%- when 'cash' -%}<rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 9v.01M18 15v.01"/>
                {%- when 'star' -%}<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>
                {%- when 'users' -%}<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.6-3.6 3.2-6 6.5-6s5.9 2.4 6.5 6"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18.5 14.4c1.7.9 2.8 2.9 3 5.6"/>
                {%- when 'heart' -%}<path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/>
                {%- when 'leaf' -%}<path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15"/><path d="M5 19l7-7"/>
                {%- when 'chat' -%}<path d="M4 5h16v11H9l-5 4z"/><path d="M8 10h8M8 13h5"/>
                {%- when 'lock' -%}<rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
                {%- when 'gift' -%}<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12"/><path d="M12 8c-2-4-6-3-5-.5S12 8 12 8zM12 8c2-4 6-3 5-.5S12 8 12 8z"/>
                {%- else -%}<path d="M5 12l4 4 10-10"/>
              {%- endcase -%}
            </svg>
          {%- endif -%}
          <span>{{ block.settings.text }}</span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <script type="application/json" data-xph-config>
    {
      "mode": {{ s.mode | json }},
      "speed": {{ s.speed | json }},
      "interval": {{ s.interval | json }},
      "resume": {{ s.resume_delay | json }},
      "hoverPause": {{ s.hover_pause | json }},
      "cardClick": {{ s.card_click | json }},
      "after": {{ s.after_add | json }},
      "quickAdd": {{ s.qv_add | json }},
      "currency": {{ s.price_format | json }},
      "money": {{ shop.money_format | strip_html | json }},
      "moneyC": {{ shop.money_with_currency_format | strip_html | json }},
      "addUrl": {{ routes.cart_add_url | append: '.js' | json }},
      "root": {{ routes.root_url | json }},
      "t": {
        "add": {{ s.t_add | json }},
        "added": {{ s.t_added | json }},
        "sold_out": {{ s.t_sold_out | json }},
        "from": {{ s.t_from | json }},
        "close": {{ s.t_close | json }},
        "view_page": {{ s.t_view_page | json }},
        "variant": {{ s.t_variant | json }}
      },
      "items": [
        {%- for block in cards -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            {%- assign v = p.selected_or_first_available_variant -%}
            {"h":{{ p.handle | json }},"t":{{ p.title | json }},"b":{{ block.settings.brand | default: p.vendor | json }},"u":{{ p.url | json }},"a":{{ p.available | json }},"vid":{{ v.id | json }},"vc":{{ p.variants.size }},"varies":{{ p.price_varies | json }},"p":{{ v.price | json }},"cp":{{ v.compare_at_price | default: 0 | json }},"i":{% if p.featured_image %}{{ p.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %}}
          {%- else -%}
            {"link":{{ block.settings.link | json }}}
          {%- endif -%}
          {%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
</section>

<script>
{% raw %}
(function () {
  'use strict';
  if (window.XPHero) { window.XPHero.scan(); return; }
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var ICON = {
    bag: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l1 13H5z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>',
    check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>',
    spin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9"/></svg>',
    x: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>',
    pause: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z"/></svg>',
    play: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5l11 7-11 7z"/></svg>'
  };
  function esc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function money(cents, fmt) {
    cents = Math.round(Number(cents) || 0);
    function f(dec, th, dp) { var n = (cents / 100).toFixed(dec).split('.'); return n[0].replace(/\B(?=(\d{3})+(?!\d))/g, th) + (n[1] ? dp + n[1] : ''); }
    return String(fmt || '{{amount}}').replace(/\{\{\s*(\w+)\s*\}\}/, function (m, k) {
      switch (k) {
        case 'amount_no_decimals': return f(0, ',', '.');
        case 'amount_with_comma_separator': return f(2, '.', ',');
        case 'amount_no_decimals_with_comma_separator': return f(0, '.', ',');
        case 'amount_with_apostrophe_separator': return f(2, "'", '.');
        case 'amount_with_space_separator': return f(2, ' ', ',');
        default: return f(2, ',', '.');
      }
    });
  }
  function sized(u, w) {
    if (!u || u.indexOf('data:') === 0) return u;
    return u.replace(/([?&])width=\d+&?/, '$1').replace(/[?&]$/, '') + (u.indexOf('?') > -1 ? '&' : '?') + 'width=' + w;
  }
  function mod(a, b) { return b ? ((a % b) + b) % b : 0; }
  function ease(k) { return 1 - Math.pow(1 - k, 3); }

  /* ================= Quick view (one shared popup per page) ================= */
  var QCACHE = {};
  function loadProduct(root, h) {
    if (QCACHE[h]) return QCACHE[h];
    QCACHE[h] = fetch(String(root || '/').replace(/\/?$/, '/') + 'products/' + encodeURIComponent(h) + '.js', { headers: { Accept: 'application/json' } })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .catch(function (e) { delete QCACHE[h]; throw e; });
    return QCACHE[h];
  }
  function themeDrawer() {
    var d = document.querySelector('m-cart-drawer') || document.querySelector('cart-drawer');
    return d && typeof d.getSectionsToRender === 'function' ? d : null;
  }
  function fillDrawer(d, j) {
    var cache = {};
    d.getSectionsToRender().forEach(function (x) {
      var id = x.section || x.id, html = j.sections && j.sections[id];
      if (!html) return;
      var el = x.selector ? document.querySelector(x.selector) : document.getElementById(x.id);
      if (!el) return;
      var doc = cache[id] || (cache[id] = new DOMParser().parseFromString(html, 'text/html'));
      var src = x.selector ? doc.querySelector(x.selector) : doc.querySelector('.shopify-section');
      if (src) el.innerHTML = src.innerHTML;
    });
    d.classList.remove('m-cart--empty', 'is-empty');
    var items = d.querySelector('m-cart-drawer-items, cart-drawer-items');
    if (items) items.classList.remove('m-cart--empty', 'is-empty');
  }

  var Q = {
    el: null,
    build: function () {
      if (this.el) return this.el;
      var self = this, el = document.createElement('div');
      el.className = 'xpq xph-q';
      el.hidden = true;
      el.innerHTML = '<div class="xpq__bg" data-q="close"></div><div class="xpq__panel" role="dialog" aria-modal="true" aria-labelledby="xph-q-title">' +
        '<button type="button" class="xpc__x" data-q="close"></button><div class="xpq__body"></div></div>';
      document.body.appendChild(el);
      this.el = el;
      this.body = el.querySelector('.xpq__body');
      el.addEventListener('click', function (e) {
        var b = e.target.closest('[data-q]');
        if (!b) return;
        var a = b.getAttribute('data-q');
        if (a === 'close') self.close();
        else if (a === 'add') self.add(b);
        else if (a === 'thumb') self.thumb(Number(b.getAttribute('data-i')));
      });
      el.addEventListener('change', function (e) { if (e.target.getAttribute('data-q') === 'var') self.variant(Number(e.target.value)); });
      el.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { e.preventDefault(); self.close(); return; }
        if (e.key !== 'Tab') return;
        var f = Array.prototype.filter.call(el.querySelectorAll('button,select,a[href]'), function (x) { return !x.disabled && x.offsetParent !== null; });
        if (!f.length) return;
        if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f[f.length - 1].focus(); }
        else if (!e.shiftKey && document.activeElement === f[f.length - 1]) { e.preventDefault(); f[0].focus(); }
      });
      window.addEventListener('popstate', function () { if (self.isOpen && !(history.state && history.state.xph)) self.close(true); });
      var sy = null;
      el.querySelector('.xpq__panel').addEventListener('touchstart', function (e) { sy = self.body.scrollTop <= 0 ? e.touches[0].clientY : null; }, { passive: true });
      el.querySelector('.xpq__panel').addEventListener('touchend', function (e) { if (sy != null && e.changedTouches[0].clientY - sy > 110) self.close(); sy = null; }, { passive: true });
      return el;
    },
    open: function (hero, item) {
      var el = this.build(), self = this;
      this.hero = hero;
      this.cfg = hero.cfg;
      this.t = hero.cfg.t;
      this.p = item;
      this.full = null;
      this.v = null;
      this.last = document.activeElement;
      el.removeAttribute('style');
      var cs = getComputedStyle(hero.root);
      ['--xpc-accent', '--xpc-on-accent', '--xpc-bg', '--xpc-card', '--xpc-tile', '--xpc-text', '--xpc-muted', '--xpc-border', '--xpc-sale'].forEach(function (k) {
        el.style.setProperty(k, cs.getPropertyValue(k));
      });
      el.setAttribute('dir', hero.rtl ? 'rtl' : 'ltr');
      el.querySelector('.xpc__x').innerHTML = ICON.x + '<span>' + esc(this.t.close) + '</span>';
      this.render();
      if (!this.isOpen) {
        this.isOpen = true;
        el.hidden = false;
        void el.offsetWidth;
        el.classList.add('is-open');
        document.documentElement.classList.add('xpc-lock');
        try { history.pushState({ xph: 1 }, ''); this.pushed = true; } catch (e) { this.pushed = false; }
      }
      hero.hold('qv', true);
      el.querySelector('.xpc__x').focus({ preventScroll: true });
      loadProduct(this.cfg.root, item.h).then(function (j) {
        if (self.p !== item) return;
        self.full = j;
        var vs = j.variants || [];
        for (var i = 0; i < vs.length; i++) if (vs[i].id === item.vid) self.v = vs[i];
        if (!self.v || !self.v.available) for (var k = 0; k < vs.length; k++) if (vs[k].available) { self.v = vs[k]; break; }
        if (!self.v) self.v = vs[0] || null;
        self.render();
      }).catch(function () {
        if (self.p !== item) return;
        var d = self.body.querySelector('.xpq__desc');
        if (d) d.innerHTML = '';
      });
    },
    price: function (price, comp) {
      var c = this.cfg, f = c.currency === 'with_currency' ? c.moneyC : c.money, sale = comp > price;
      return { sale: sale, html: '<span>' + esc(money(price, f)) + '</span>' + (sale ? '<s>' + esc(money(comp, f)) + '</s>' : '') };
    },
    render: function () {
      var p = this.p, t = this.t, full = this.full, v = this.v, c = this.cfg;
      var imgs = (full && full.images && full.images.length ? full.images : [p.i]).filter(Boolean).map(function (u) { return sized(u, 900); });
      var track = imgs.map(function (u, i) { return '<img src="' + esc(u) + '" alt="' + esc(p.t) + '" ' + (i ? 'loading="lazy" ' : '') + 'decoding="async" width="900" height="900">'; }).join('');
      var thumbs = imgs.length > 1 ? '<div class="xpq__thumbs">' + imgs.map(function (u, i) {
        return '<button type="button" data-q="thumb" data-i="' + i + '" class="' + (i ? '' : 'is-on') + '" aria-label="' + (i + 1) + '/' + imgs.length + '"><img src="' + esc(sized(u, 160)) + '" alt="" loading="lazy" decoding="async"></button>';
      }).join('') + '</div>' : '';
      var vs = full ? (full.variants || []) : [];
      var sel = '';
      if (vs.length > 1) {
        sel = '<label class="xpq__var"><span>' + esc(t.variant) + '</span><select data-q="var">' + vs.map(function (x) {
          return '<option value="' + x.id + '"' + (v && x.id === v.id ? ' selected' : '') + (x.available ? '' : ' disabled') + '>' + esc(x.title + (x.available ? '' : ' (' + t.sold_out + ')')) + '</option>';
        }).join('') + '</select></label>';
      }
      var pr = v ? this.price(v.price, v.compare_at_price || 0) : this.price(p.p, p.cp);
      var avail = v ? v.available : p.a;
      var vid = v ? v.id : p.vid;
      var btn = c.quickAdd ? '<button type="button" class="xpc-add xpq__add" data-q="add" data-id="' + vid + '"' + (avail && (v || p.vc <= 1) ? '' : ' disabled') + '>' +
        (avail ? ICON.bag + '<span>' + esc(t.add) + '</span>' : esc(t.sold_out)) + '</button>' : '';
      this.body.innerHTML = '<div class="xpq__gallery"><div class="xpq__track">' + track + '</div>' + thumbs + '</div>' +
        '<div class="xpq__info">' + (p.b ? '<span class="xpq__brand">' + esc(p.b) + '</span>' : '') + '<h2 class="xpq__title" id="xph-q-title">' + esc(p.t) + '</h2>' +
        '<p class="xpq__price' + (pr.sale ? ' is-sale' : '') + '">' + (p.varies && !v ? esc(t.from) + ' ' : '') + pr.html + '</p>' + sel + btn +
        '<a class="xpq__page" href="' + esc(p.u) + '">' + esc(t.view_page) + '</a>' +
        '<div class="xpq__desc">' + (full ? (full.description || '') : '<span class="xpq__skel"></span><span class="xpq__skel"></span><span class="xpq__skel xpq__skel--s"></span>') + '</div></div>';
      var tr = this.body.querySelector('.xpq__track');
      if (tr && imgs.length > 1) tr.addEventListener('scroll', function () {
        var i = Math.round(Math.abs(tr.scrollLeft) / tr.clientWidth);
        Array.prototype.forEach.call(tr.parentNode.querySelectorAll('.xpq__thumbs button'), function (b, k) { b.classList.toggle('is-on', k === i); });
      }, { passive: true });
    },
    variant: function (id) {
      var vs = (this.full && this.full.variants) || [], v = null, t = this.t;
      for (var i = 0; i < vs.length; i++) if (vs[i].id === id) v = vs[i];
      if (!v) return;
      this.v = v;
      var pr = this.price(v.price, v.compare_at_price || 0), pe = this.body.querySelector('.xpq__price'), b = this.body.querySelector('.xpq__add');
      pe.className = 'xpq__price' + (pr.sale ? ' is-sale' : '');
      pe.innerHTML = pr.html;
      if (b) {
        b.setAttribute('data-id', v.id);
        b.disabled = !v.available;
        b.classList.remove('is-done', 'is-busy');
        b.innerHTML = v.available ? ICON.bag + '<span>' + esc(t.add) + '</span>' : esc(t.sold_out);
      }
      var fi = v.featured_image && v.featured_image.src;
      if (fi) {
        var base = String(fi).split('?')[0].replace(/^https?:/, ''), imgs = this.body.querySelectorAll('.xpq__track img');
        for (var k = 0; k < imgs.length; k++) if (imgs[k].src.split('?')[0].replace(/^https?:/, '') === base) { this.thumb(k); break; }
      }
    },
    thumb: function (i) {
      var img = this.body.querySelectorAll('.xpq__track img')[i];
      if (img) img.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest', inline: 'start' });
    },
    add: function (b) {
      var self = this, c = this.cfg, t = this.t;
      if (b.disabled || b.classList.contains('is-busy') || b.classList.contains('is-done')) return;
      b.classList.add('is-busy');
      b.innerHTML = ICON.spin + '<span>' + esc(t.add) + '</span>';
      var body = { items: [{ id: Number(b.getAttribute('data-id')), quantity: 1 }] };
      var d = themeDrawer();
      if (d) {
        var ids = [];
        try { d.getSectionsToRender().forEach(function (x) { var id = x.section || x.id; if (ids.indexOf(id) < 0) ids.push(id); }); } catch (e) {}
        if (ids.length) { body.sections = ids; body.sections_url = window.location.pathname; }
      }
      fetch(c.addUrl, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify(body) })
        .then(function (r) { return r.json().then(function (j) { if (!r.ok || j.status) throw new Error(j.description || j.message || 'error'); return j; }); })
        .then(function (j) {
          b.classList.remove('is-busy');
          b.classList.add('is-done');
          b.innerHTML = ICON.check + '<span>' + esc(t.added) + '</span>';
          var sync = function () {
            try {
              if (d && j.sections) fillDrawer(d, j);
              else if (d && typeof d.onCartDrawerUpdate === 'function') d.onCartDrawerUpdate();
              if (window.FoxKitV2 && window.FoxKitV2.Modules && window.FoxKitV2.Modules.InCart) window.FoxKitV2.Modules.InCart.getCart();
              if (window.MinimogEvents && window.MinimogTheme && window.MinimogTheme.pubSubEvents) window.MinimogEvents.emit(window.MinimogTheme.pubSubEvents.cartUpdate, j);
            } catch (e) {}
            document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          };
          if (c.after === 'drawer' && d && typeof d.open === 'function') {
            sync();
            setTimeout(function () { self.close(); setTimeout(function () { d.open(); }, 60); }, 450);
          } else {
            requestAnimationFrame(function () { setTimeout(sync, 120); });
            setTimeout(function () { if (b.isConnected) { b.classList.remove('is-done'); b.innerHTML = ICON.bag + '<span>' + esc(t.add) + '</span>'; } }, 2200);
          }
        })
        .catch(function (e) {
          b.classList.remove('is-busy');
          b.innerHTML = '<span>' + esc(e.message) + '</span>';
          setTimeout(function () { if (b.isConnected) b.innerHTML = ICON.bag + '<span>' + esc(t.add) + '</span>'; }, 2600);
        });
    },
    close: function (fromPop) {
      var self = this, el = this.el;
      if (!this.isOpen) return;
      this.isOpen = false;
      el.classList.remove('is-open');
      document.documentElement.classList.remove('xpc-lock');
      setTimeout(function () { if (!self.isOpen) { el.hidden = true; self.body.innerHTML = ''; } }, reduce ? 0 : 320);
      if (this.pushed && !fromPop) { this.pushed = false; try { history.back(); } catch (e) {} }
      this.pushed = false;
      if (this.hero) this.hero.hold('qv', false, true);
      if (this.last && this.last.focus && document.contains(this.last)) this.last.focus({ preventScroll: true });
    }
  };

  /* ================= Carousel ================= */
  function Hero(root) {
