{% comment %}
  XPoost — Product Information Scarcity & Urgency Block
  Target: section (Add directly inside Product Information section in Theme Editor)
  Zero speed impact — 100% server-rendered in Liquid.
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign show_block = true %}

{% comment %} Product targeting: all / specific / exclude {% endcomment %}
{% if block.settings.target_mode == 'specific' %}
  {% assign show_block = false %}
  {% if block.settings.target_products contains product %}
    {% assign show_block = true %}
  {% endif %}
{% elsif block.settings.target_mode == 'exclude' %}
  {% if block.settings.target_products contains product %}
    {% assign show_block = false %}
  {% endif %}
{% endif %}

{% if show_block %}
  {% comment %} Calculate remaining stock {% endcomment %}
  {% assign stock_qty = 5 %}
  {% if block.settings.stock_source == 'shopify' %}
    {% if current_variant.inventory_quantity > 0 %}
      {% assign stock_qty = current_variant.inventory_quantity %}
    {% else %}
      {% assign stock_qty = block.settings.min_stock | default: 3 %}
    {% endif %}

    {% assign threshold = block.settings.threshold | default: 0 | plus: 0 %}
    {% assign is_initially_hidden = false %}
    {% if threshold > 0 and stock_qty > threshold %}
      {% assign is_initially_hidden = true %}
    {% endif %}
  {% else %}
    {% comment %} Simulated deterministic range based on product ID {% endcomment %}
    {% assign min_s = block.settings.min_stock | default: 3 | plus: 0 %}
    {% assign max_s = block.settings.max_stock | default: 12 | plus: 0 %}
    {% if max_s <= min_s %}
      {% assign max_s = min_s | plus: 5 %}
    {% endif %}
    {% assign range_diff = max_s | minus: min_s | plus: 1 %}
    {% assign stock_qty = product.id | modulo: range_diff | plus: min_s %}
  {% endif %}

  {% comment %} Deterministic live viewers counter {% endcomment %}
  {% assign viewers_count = product.id | modulo: 24 | plus: 9 %}

  {% comment %} Dynamic variable spans for live continuous updating {% endcomment %}
  {% capture stock_span %}<span class="xpp-ps-stock-num">{{ stock_qty }}</span>{% endcapture %}
  {% capture viewers_span %}<span class="xpp-ps-viewers-num">{{ viewers_count }}</span>{% endcapture %}

  {% comment %} Replace template variables {% endcomment %}
  {% assign headline = block.settings.headline | default: 'Hurry! Only {stock} items left in stock' | replace: '{stock}', stock_span | replace: '{viewers}', viewers_span %}
  {% assign subtext = block.settings.subtext | default: 'High demand: selling fast' | replace: '{stock}', stock_span | replace: '{viewers}', viewers_span %}

  {% comment %} Progress bar percentage {% endcomment %}
  {% assign max_meter = block.settings.max_stock | default: 15 | plus: 0 %}
  {% if max_meter < stock_qty %}
    {% assign max_meter = stock_qty | plus: 5 %}
  {% endif %}
  {% assign bar_percent = stock_qty | times: 100 | divided_by: max_meter %}
  {% if bar_percent < 8 %}
    {% assign bar_percent = 8 %}
  {% elsif bar_percent > 100 %}
    {% assign bar_percent = 100 %}
  {% endif %}

  {% if show_block %}
    <div
      class="xpp-ps-root{% if is_initially_hidden %} xpp-ps-hidden{% endif %}"
      data-product-id="{{ product.id }}"
      data-variant-id="{{ current_variant.id }}"
      data-stock-source="{{ block.settings.stock_source }}"
      data-min-stock="{{ block.settings.min_stock | default: 3 }}"
      data-max-stock="{{ block.settings.max_stock | default: 12 }}"
      data-threshold="{{ block.settings.threshold | default: 0 }}"
      data-initial-viewers="{{ viewers_count }}"
      data-headline="{{ block.settings.headline | escape }}"
      data-subtext="{{ block.settings.subtext | escape }}"
      data-proxy-path="/apps/xpoost/config"
    data-locale="{{ request.locale.iso_code }}"
      style="
        --xpp-ps-accent: {{ block.settings.accent_color | default: '#D4AF37' }};
        --xpp-ps-bg: {{ block.settings.bg_color | default: '#141414' }};
        --xpp-ps-text: {{ block.settings.text_color | default: '#FFFFFF' }};
        --xpp-ps-border: {{ block.settings.border_color | default: '#2d2d2d' }};
      "
    >
      {% case block.settings.design_preset %}
        {% when 'urgency_badge' %}
          {% comment %} Design 2: Urgency Radar & Stock Pill {% endcomment %}
          <div class="xpp-ps-urgency-badge">
            <div class="xpp-ps-radar" aria-hidden="true">
              <div class="xpp-ps-radar-dot"></div>
              <div class="xpp-ps-radar-wave"></div>
            </div>
            <p class="xpp-ps-headline">
              {{ headline }}
            </p>
          </div>

        {% when 'luxury_card' %}
          {% comment %} Design 3: Luxury Minimalist Box {% endcomment %}
          <div class="xpp-ps-luxury-card">
            <div class="xpp-ps-luxury-left">
              <span class="xpp-ps-icon-flame" aria-hidden="true">
                <svg viewBox="0 0 1200 1200" width="18" height="18" fill="currentColor">
                  <path d="M 381.63997,1200 C 135.77919,1061.434 71.049038,930.27865 108.05732,751.14866 135.37841,618.87726 224.83888,511.26304 233.417,379.24524 271.63184,448.78945 287.59935,498.9368 291.87036,571.60898 413.41348,422.69507 493.73121,216.54632 498.48692,0 c 0,0 316.57523,186.01008 337.34836,466.98023 27.25312,-57.91289 40.97132,-149.89172 13.7182,-209.5043 C 931.31098,317.09086 1409.8464,846.31428 784.73519,1200 902.263,971.16186 815.05535,662.38827 610.99652,519.78234 624.62426,581.10164 600.73114,809.80288 510.45434,910.29655 535.46754,742.38092 486.6538,671.37843 486.6538,671.37843 c 0,0 -16.75337,94.05444 -81.7575,189.06609 C 345.53708,947.20639 304.40709,1039.2914 381.64021,1200 z" />
                </svg>
              </span>
              <div>
                <p class="xpp-ps-headline">{{ headline }}</p>
                {% if subtext != blank %}
                  <div class="xpp-ps-subtext">{{ subtext }}</div>
                {% endif %}
              </div>
            </div>
            <div class="xpp-ps-luxury-right">
              <span class="xpp-ps-live-dot" aria-hidden="true"></span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <span><span class="xpp-ps-viewers-num">{{ viewers_count }}</span> viewing</span>
            </div>
          </div>

        {% when 'flash_demand' %}
          {% comment %} Design 4: Flash Warehouse Scarcity Banner {% endcomment %}
          <div class="xpp-ps-flash-demand">
            <div class="xpp-ps-flash-header">
              <span class="xpp-ps-badge-tag">High Demand</span>
              <p class="xpp-ps-headline" style="margin: 0;">{{ headline }}</p>
            </div>
            {% if subtext != blank %}
              <div class="xpp-ps-subtext" style="margin-bottom: 8px;">{{ subtext }}</div>
            {% endif %}
            <div class="xpp-ps-track">
              <div class="xpp-ps-bar" style="width: {{ bar_percent }}%;"></div>
            </div>
          </div>

        {% else %}
          {% comment %} Design 1 (Default): Fire Pulse & Progress Meter {% endcomment %}
          <div class="xpp-ps-pulse-meter">
            <div class="xpp-ps-header">
              <span class="xpp-ps-icon-flame" aria-hidden="true">
                <svg viewBox="0 0 1200 1200" width="18" height="18" fill="currentColor">
                  <path d="M 381.63997,1200 C 135.77919,1061.434 71.049038,930.27865 108.05732,751.14866 135.37841,618.87726 224.83888,511.26304 233.417,379.24524 271.63184,448.78945 287.59935,498.9368 291.87036,571.60898 413.41348,422.69507 493.73121,216.54632 498.48692,0 c 0,0 316.57523,186.01008 337.34836,466.98023 27.25312,-57.91289 40.97132,-149.89172 13.7182,-209.5043 C 931.31098,317.09086 1409.8464,846.31428 784.73519,1200 902.263,971.16186 815.05535,662.38827 610.99652,519.78234 624.62426,581.10164 600.73114,809.80288 510.45434,910.29655 535.46754,742.38092 486.6538,671.37843 486.6538,671.37843 c 0,0 -16.75337,94.05444 -81.7575,189.06609 C 345.53708,947.20639 304.40709,1039.2914 381.64021,1200 z" />
                </svg>
              </span>
              <p class="xpp-ps-headline">
                {{ headline }}
              </p>
            </div>
            <div class="xpp-ps-track">
              <div class="xpp-ps-bar" style="width: {{ bar_percent }}%;"></div>
            </div>
            {% if subtext != blank %}
              <div class="xpp-ps-subtext">
                {{ subtext }}
              </div>
            {% endif %}
          </div>
      {% endcase %}
    </div>

    {{ 'xpoost-product-scarcity.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'xpoost-product-scarcity.js' | asset_url }}" defer></script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "XPoost: Product Scarcity",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "select",
      "id": "design_preset",
      "label": "Design Layout",
      "options": [
        { "value": "pulse_meter", "label": "Fire Pulse & Progress Meter" },
        { "value": "urgency_badge", "label": "Live Radar Badge & Pill" },
        { "value": "luxury_card", "label": "Luxury Minimalist Card" },
        { "value": "flash_demand", "label": "Flash Warehouse Banner" }
      ],
      "default": "pulse_meter"
    },
    {
      "type": "select",
      "id": "stock_source",
      "label": "Inventory Calculation Source",
      "options": [
        { "value": "shopify", "label": "Real Shopify Inventory" },
        { "value": "manual_range", "label": "Simulated Range (Custom Min / Max)" }
      ],
      "default": "shopify"
    },
    {
      "type": "range",
      "id": "min_stock",
      "label": "Minimum Stock Quantity",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "max_stock",
      "label": "Maximum Stock Quantity",
      "min": 5,
      "max": 50,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "threshold",
      "label": "Low Stock Cutoff (0 = Always Show)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "info": "If using Shopify inventory, only show this block when stock is below this number. Set to 0 to always show."
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline Template",
      "default": "Hurry! Only {stock} items left in stock",
      "info": "Use {stock} for quantity, and {viewers} for live viewer count."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtitle / Reassurance Note",
      "default": "High demand: selling fast"
    },
    {
      "type": "select",
      "id": "target_mode",
      "label": "Product Targeting",
      "options": [
        { "value": "all", "label": "All Products" },
        { "value": "specific", "label": "Specific Products Only" },
        { "value": "exclude", "label": "Exclude Specific Products" }
      ],
      "default": "all"
    },
    {
      "type": "product_list",
      "id": "target_products",
      "label": "Targeted / Excluded Products"
    },
    {
      "type": "header",
      "content": "Appearance & Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Highlight Color",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Card Background Color",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#2d2d2d"
    }
  ]
}
{% endschema %}
