{% comment %}
  XPoost - Product Recommendations
  Recommended products with an Add button, best placed above the product description.
  Source, design, offer, texts and colors are set in the XPoost app.
{% endcomment %}

{%- liquid
  assign xpr_collections = ''
  if product
    for c in product.collections limit: 30
      assign xpr_collections = xpr_collections | append: c.id | append: ','
    endfor
  endif
-%}

<div
  class="xpr-mount"
  data-xpr-root
  data-proxy="/apps/xpoost/recs"
  data-product-id="{% if product %}{{ product.id }}{% endif %}"
  data-collections="{{ xpr_collections }}"
  data-locale="{{ request.locale.iso_code }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-money-format="{{ shop.money_format | escape }}"
  hidden
  {{ block.shopify_attributes }}
></div>

{{ 'xpoost-recs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xpoost-track.js' | asset_url }}" defer></script>
<script src="{{ 'xpoost-quick-view.js' | asset_url }}" defer></script>
<script src="{{ 'xpoost-recs.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "XPoost: Recommendations",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows recommended products with an Add button. For best results, place it above the product description. Choose the products, design and offer in the XPoost app."
    }
  ]
}
{% endschema %}
